Subject: [PATCH] updateNeighbourForOutputSignal Plane.HORIZONTAL Muta


diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 92403aa03ce92803743a35e7e3c8fa2c618abd96..b08a9975a538cc756513e71f27a2aaf116fa30f9 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -1950,22 +1950,31 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
 
     public abstract Scoreboard getScoreboard();
 
+    // Papo - cached horizontal array in exact Plane.HORIZONTAL order (iterator alloc per for-each)
+    private static final Direction[] OUTPUT_SIGNAL_HORIZONTAL = {Direction.NORTH, Direction.EAST, Direction.SOUTH, Direction.WEST};
+
     public void updateNeighbourForOutputSignal(BlockPos pos, Block block) {
-        for (Direction direction : Direction.Plane.HORIZONTAL) {
-            BlockPos blockPos = pos.relative(direction);
-            if (this.hasChunkAt(blockPos)) {
-                BlockState blockState = this.getBlockState(blockPos);
+        // Papo start - cached horizontal array (iterator alloc per for-each) + reusable MutableBlockPos
+        // (4-8 BlockPos allocs per call). ServerLevel.neighborChanged routes to CollectingNeighborUpdater
+        // which does pos.immutable(); hasChunkAt/getBlockState/isRedstoneConductor only read the pos.
+        BlockPos.MutableBlockPos mutable = pos.mutable();
+        for (Direction direction : OUTPUT_SIGNAL_HORIZONTAL) { // Papo - cached array
+            mutable.setWithOffset(pos, direction);
+            if (this.hasChunkAt(mutable)) {
+                BlockState blockState = this.getBlockState(mutable);
                 if (blockState.is(Blocks.COMPARATOR)) {
-                    this.neighborChanged(blockState, blockPos, block, null, false);
-                } else if (blockState.isRedstoneConductor(this, blockPos)) {
-                    blockPos = blockPos.relative(direction);
-                    blockState = this.getBlockState(blockPos);
+                    this.neighborChanged(blockState, mutable, block, null, false);
+                } else if (blockState.isRedstoneConductor(this, mutable)) {
+                    mutable.move(direction);
+                    blockState = this.getBlockState(mutable);
                     if (blockState.is(Blocks.COMPARATOR)) {
-                        this.neighborChanged(blockState, blockPos, block, null, false);
+                        this.neighborChanged(blockState, mutable, block, null, false);
                     }
+                    mutable.move(direction.getOpposite());
                 }
             }
         }
+        // Papo end
     }
 
     @Override
