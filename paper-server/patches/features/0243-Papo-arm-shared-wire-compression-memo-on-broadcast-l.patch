From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sat, 22 Aug 2026 01:24:39 +0800
Subject: [PATCH] Papo: arm shared wire-compression memo on broadcast light
 update packets


diff --git a/net/minecraft/network/protocol/game/ClientboundLightUpdatePacket.java b/net/minecraft/network/protocol/game/ClientboundLightUpdatePacket.java
index 2896f90b9fefda6bd3c1ca9a463ba02ece6f8a05..d8a63f776618bbd1507dd93a4bdd869e21faa48d 100644
--- a/net/minecraft/network/protocol/game/ClientboundLightUpdatePacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundLightUpdatePacket.java
@@ -2,6 +2,7 @@ package net.minecraft.network.protocol.game;
 
 import java.util.BitSet;
 import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.PapoSharedWireMemo;
 import net.minecraft.network.codec.StreamCodec;
 import net.minecraft.network.protocol.Packet;
 import net.minecraft.network.protocol.PacketType;
@@ -9,7 +10,7 @@ import net.minecraft.world.level.ChunkPos;
 import net.minecraft.world.level.lighting.LevelLightEngine;
 import org.jspecify.annotations.Nullable;
 
-public class ClientboundLightUpdatePacket implements Packet<ClientGamePacketListener> {
+public class ClientboundLightUpdatePacket implements Packet<ClientGamePacketListener>, PapoSharedWireMemo.Carrier {
     public static final StreamCodec<FriendlyByteBuf, ClientboundLightUpdatePacket> STREAM_CODEC = Packet.codec(
         ClientboundLightUpdatePacket::write, ClientboundLightUpdatePacket::new
     );
@@ -56,4 +57,20 @@ public class ClientboundLightUpdatePacket implements Packet<ClientGamePacketList
     public ClientboundLightUpdatePacketData getLightData() {
         return this.lightData;
     }
+
+    // Papo start - shared wire-compression memo for multi-recipient broadcasts
+    // ChunkHolder.broadcastChanges sends this same instance to every player tracking the chunk
+    // (sunset/sunrise light propagation broadcasts many chunks per tick, each to N viewers);
+    // every connection would otherwise DEFLATE identical 10-40 KiB bytes (~100-500 us each at
+    // level 6). The memo replays the first connection's self-describing compressed segment -
+    // see PapoSharedWireMemo for the equivalence and visibility contract. The packet is
+    // immutable and its codec is locale-independent, so encoded bytes are identical across
+    // connections; the instance is per-broadcast-call (transient), so the memo dies with it.
+    private final PapoSharedWireMemo papoWireMemo = PapoSharedWireMemo.papoCreate();
+
+    @Override
+    public PapoSharedWireMemo papoWireMemo() {
+        return this.papoWireMemo;
+    }
+    // Papo end - shared wire-compression memo for multi-recipient broadcasts
 }
