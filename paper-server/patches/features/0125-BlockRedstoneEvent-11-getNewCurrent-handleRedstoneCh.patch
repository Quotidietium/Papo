@@ -168,14 +168,14 @@ public class ComparatorBlock extends DiodeBlock implements EntityBlock {
             boolean poweredValue = state.getValue(POWERED);
             if (poweredValue && !shouldTurnOn) {
                 // CraftBukkit start
-                if (org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, 15, 0).getNewCurrent() != 0) {
+                if (org.bukkit.craftbukkit.event.CraftEventFactory.handleRedstoneChange(level, pos, 15, 0) != 0) {
