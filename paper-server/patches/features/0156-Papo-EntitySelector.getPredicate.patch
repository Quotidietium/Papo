         int i = (flag ? 1 : 0) + (flag1 ? 1 : 0) + (flag2 ? 1 : 0);
         List<Predicate<Entity>> list;
         if (i == 0) {
-            list = this.contextFreePredicates;
+            // Papo start - cache the composite for the context-free path (0156):
+            // contextFreePredicates is an immutable List.copyOf snapshot (see EntitySelectorParser#getSelector)
+            // and Util.allOf is a pure function of it, so the composed predicate can be built once.
+            // Only the size>=2 case allocates in Util.allOf; sizes 0/1 are already allocation-free.
+            Predicate<Entity> cached = this.papoCachedContextFreePredicate;
+            if (cached == null) {
+                cached = Util.allOf(this.contextFreePredicates);
+                this.papoCachedContextFreePredicate = cached;
+            }
+            return cached;
+            // Papo end
