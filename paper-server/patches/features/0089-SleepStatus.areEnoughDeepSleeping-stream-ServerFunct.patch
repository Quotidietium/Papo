diff --git a/net/minecraft/server/ServerFunctionManager.java b/net/minecraft/server/ServerFunctionManager.java
index 747e51132cfddc0c1d619dca81a4dd34605475bd..3b03122851ab4df3bf5ddcde8ad9451344439c76 100644
--- a/net/minecraft/server/ServerFunctionManager.java
+++ b/net/minecraft/server/ServerFunctionManager.java
@@ -46,7 +46,11 @@ public class ServerFunctionManager {
                 this.executeTagFunctions(tag, LOAD_FUNCTION_TAG);
             }
 
-            this.executeTagFunctions(this.ticking, TICK_FUNCTION_TAG);
+            // Papo - skip profiler push/pop + method-ref lambda when the #tick tag is empty
+            // (executeTagFunctions on an empty collection has no effect).
+            if (!this.ticking.isEmpty()) {
+                this.executeTagFunctions(this.ticking, TICK_FUNCTION_TAG);
+            }
         }
     }
 
diff --git a/net/minecraft/server/players/SleepStatus.java b/net/minecraft/server/players/SleepStatus.java
index 2a7ae521654ad5c9f392baa5562e64bb71b13097..ec9a4f7e22a2c7911e872cc8c6d3b35ab9316dcb 100644
--- a/net/minecraft/server/players/SleepStatus.java
+++ b/net/minecraft/server/players/SleepStatus.java
@@ -3,7 +3,6 @@ package net.minecraft.server.players;
 import java.util.List;
 import net.minecraft.server.level.ServerPlayer;
 import net.minecraft.util.Mth;
-import net.minecraft.world.entity.player.Player;
 
 public class SleepStatus {
     private int activePlayers;
@@ -15,8 +14,18 @@ public class SleepStatus {
 
     public boolean areEnoughDeepSleeping(int requiredSleepPercentage, List<ServerPlayer> sleepingPlayers) {
         // CraftBukkit start
-        int i = (int) sleepingPlayers.stream().filter(player -> player.isSleepingLongEnough() || player.fauxSleeping).count();
-        boolean anyDeepSleep = sleepingPlayers.stream().anyMatch(Player::isSleepingLongEnough);
+        // Papo - single pass instead of two stream traversals (both predicates are side-effect free
+        // and read the same moment-in-time state, so fused evaluation is identical).
+        int i = 0;
+        boolean anyDeepSleep = false;
+        for (ServerPlayer player : sleepingPlayers) {
+            if (player.isSleepingLongEnough()) {
+                i++;
+                anyDeepSleep = true;
+            } else if (player.fauxSleeping) {
+                i++;
+            }
+        }
         return anyDeepSleep && i >= this.sleepersNeeded(requiredSleepPercentage);
         // CraftBukkit end
     }
