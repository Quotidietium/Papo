From: Zurker <zurker@local>
Date: Fri, 28 Aug 2026 21:34:36 +0800
Subject: [PATCH] Papo: batch 107 fanout packet-type counters probe
 (diagnostic-only, papo.tickProfile-gated)


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index b48000fa8db79559a6f37c3e6adfd96b7c8d9d1c..499dd9defcbd67d2c5d21488f217b3bef161bde9 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -58,7 +58,12 @@ import net.minecraft.nbt.NbtException;
 import net.minecraft.network.protocol.Packet;
 import net.minecraft.network.protocol.game.ClientGamePacketListener;
 import net.minecraft.network.protocol.game.ClientboundChunksBiomesPacket;
+import net.minecraft.network.protocol.game.ClientboundEntityPositionSyncPacket;
+import net.minecraft.network.protocol.game.ClientboundMoveEntityPacket;
+import net.minecraft.network.protocol.game.ClientboundRotateHeadPacket;
 import net.minecraft.network.protocol.game.ClientboundSetChunkCacheCenterPacket;
+import net.minecraft.network.protocol.game.ClientboundSetEntityDataPacket;
+import net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket;
 import net.minecraft.resources.ResourceKey;
 import net.minecraft.server.network.ServerPlayerConnection;
 import net.minecraft.util.CsvOutput;
@@ -121,6 +126,38 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
     // (main-thread only, profiling-gated; flushed+reset by newTrackerTick every tracked tick)
     static long PAP0_FANOUT_NS;
     // Papo end - batch 102
+    // Papo start - batch 107: fanout packet-type counters (diagnostic-only via papo.tickProfile).
+    // Decomposes the fanout ns into packets/tick by type + total viewer-sends; per-send cost is
+    // derived offline as fanoutNs/fanout.sends. Classifier order: subclasses before siblings.
+    static long PAP0_FANOUT_SENDS;
+    static final long[] PAP0_FANOUT_PKTS = new long[8];
+    static final String[] PAP0_FANOUT_PKTS_NAMES = {"movePos", "movePosRot", "moveRot", "posSync", "entityData", "headRot", "velocity", "other"};
+
+    static int papoClassifyFanoutPacket(final Packet<?> packet) {
+        if (packet instanceof ClientboundMoveEntityPacket.Pos) {
+            return 0;
+        }
+        if (packet instanceof ClientboundMoveEntityPacket.PosRot) {
+            return 1;
+        }
+        if (packet instanceof ClientboundMoveEntityPacket.Rot) {
+            return 2;
+        }
+        if (packet instanceof ClientboundEntityPositionSyncPacket) {
+            return 3;
+        }
+        if (packet instanceof ClientboundSetEntityDataPacket) {
+            return 4;
+        }
+        if (packet instanceof ClientboundRotateHeadPacket) {
+            return 5;
+        }
+        if (packet instanceof ClientboundSetEntityMotionPacket) {
+            return 6;
+        }
+        return 7;
+    }
+    // Papo end - batch 107
     private static final Logger LOGGER = LogUtils.getLogger();
     private static final int CHUNK_SAVED_PER_TICK = 200;
     private static final int CHUNK_SAVED_EAGERLY_PER_TICK = 20;
@@ -1079,6 +1116,16 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
             io.papermc.paper.util.PapoTickProfile.addNanos("chunkMap.tracker.sendChanges", papoSendNs);
             io.papermc.paper.util.PapoTickProfile.addNanos("chunkMap.tracker.fanout", PAP0_FANOUT_NS);
             PAP0_FANOUT_NS = 0L;
+            // Papo start - batch 107: fanout counter flush (same cadence as the ns accumulator)
+            io.papermc.paper.util.PapoTickProfile.addCount("fanout.sends", PAP0_FANOUT_SENDS);
+            PAP0_FANOUT_SENDS = 0L;
+            for (int papoI = 0; papoI < PAP0_FANOUT_PKTS.length; papoI++) {
+                if (PAP0_FANOUT_PKTS[papoI] != 0L) {
+                    io.papermc.paper.util.PapoTickProfile.addCount("fanout.pkt." + PAP0_FANOUT_PKTS_NAMES[papoI], PAP0_FANOUT_PKTS[papoI]);
+                    PAP0_FANOUT_PKTS[papoI] = 0L;
+                }
+            }
+            // Papo end - batch 107
         }
         // Papo end - batch 98
     }
@@ -1373,6 +1420,12 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
             }
             if (io.papermc.paper.util.PapoTickProfile.ENABLED) {
                 PAP0_FANOUT_NS += System.nanoTime() - papoTFan;
+                // Papo start - batch 107: packet-type + viewer-send counters (filtered variant
+                // (passengers) and AndSelf-delegation excluded; AndSelf delegates here so only
+                // the explicit Filtered loop is outside — negligible volume, disclosed)
+                PAP0_FANOUT_SENDS += this.seenBy.size();
+                PAP0_FANOUT_PKTS[papoClassifyFanoutPacket(packet)]++;
+                // Papo end - batch 107
             }
             // Papo end - batch 102
         }
