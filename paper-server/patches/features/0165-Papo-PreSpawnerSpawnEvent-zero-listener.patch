Subject: [PATCH] Papo PreSpawnerSpawnEvent zero listener


diff --git a/net/minecraft/world/level/BaseSpawner.java b/net/minecraft/world/level/BaseSpawner.java
index ff9dd4aedc91d151f1955e2e9bed1c597341964c..67c12418864920b7c6bfcbe4465ff4de8bc3179d 100644
--- a/net/minecraft/world/level/BaseSpawner.java
+++ b/net/minecraft/world/level/BaseSpawner.java
@@ -134,6 +134,9 @@ public abstract class BaseSpawner {
                             }
 
                             // Paper start - PreCreatureSpawnEvent
+                            // Papo - zero-listener fast path: PreSpawnerSpawnEvent shares PreCreatureSpawnEvent's static HandlerList;
+                            // with no listeners callEvent() is side-effect free and always returns true, so event construction is a no-op
+                            if (com.destroystokyo.paper.event.entity.PreCreatureSpawnEvent.getHandlerList().getRegisteredListeners().length != 0) {
                             com.destroystokyo.paper.event.entity.PreSpawnerSpawnEvent event = new com.destroystokyo.paper.event.entity.PreSpawnerSpawnEvent(
                                 org.bukkit.craftbukkit.util.CraftLocation.toBukkit(vec3, level),
                                 org.bukkit.craftbukkit.entity.CraftEntityType.minecraftToBukkit(optional.get()),
@@ -146,6 +149,7 @@ public abstract class BaseSpawner {
                                 }
                                 continue;
                             }
+                            }
                             // Paper end - PreCreatureSpawnEvent
 
                             Entity entity = EntityType.loadEntityRecursive(valueInput, level, EntitySpawnReason.SPAWNER, entity1 -> {
