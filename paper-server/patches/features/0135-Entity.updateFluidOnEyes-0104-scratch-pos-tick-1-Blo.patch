Subject: [PATCH] Entity.updateFluidOnEyes 0104 scratch pos tick 1 Blo


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 024b72cd4c3cf90b19d3bf0a689960fff86fd09a..1c98462e33cb7007b56b2905bbafd14f4a6a5ae6 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -336,7 +336,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     private double papoLastKnownPosX, papoLastKnownPosY, papoLastKnownPosZ;
     private boolean papoLastKnownPosValid;
     // Papo end
-    private BlockPos.MutableBlockPos papoFluidMutablePos; // Papo - reused scratch pos in updateFluidHeightAndDoFluidPushing (provably non-escaping; tick-thread only)
+    private BlockPos.MutableBlockPos papoFluidMutablePos; // Papo - reused scratch pos in updateFluidHeightAndDoFluidPushing + updateFluidOnEyes (provably non-escaping; tick-thread only)
     public net.kyori.adventure.util.TriState visualFire = net.kyori.adventure.util.TriState.NOT_SET; // Paper - improve visual fire API
     private @Nullable BlockState inBlockState = null;
     public static final int MAX_MOVEMENTS_HANDELED_PER_TICK = 100;
@@ -2087,7 +2087,14 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
                 && abstractBoat.getBoundingBox().maxY >= eyeY
                 && abstractBoat.getBoundingBox().minY <= eyeY
         )) {
-            BlockPos blockPos = BlockPos.containing(this.getX(), eyeY, this.getZ());
+            // Papo start - reuse the per-entity scratch pos (same field and non-escape proof as 0104):
+            // BlockPos.containing only floors the three coordinates (BlockPos.java:97-99), and
+            // getFluidState/getHeight only read them; the two users of papoFluidMutablePos
+            // (updateFluidOnEyes / updateFluidHeightAndDoFluidPushing) are sequential on the tick
+            // thread and never hold the pos across a call into the other user.
+            final BlockPos.MutableBlockPos blockPos = this.papoFluidMutablePos != null ? this.papoFluidMutablePos : (this.papoFluidMutablePos = new BlockPos.MutableBlockPos());
+            blockPos.set(Mth.floor(this.getX()), Mth.floor(eyeY), Mth.floor(this.getZ()));
+            // Papo end
             FluidState fluidState = this.level().getFluidState(blockPos);
             double d = blockPos.getY() + fluidState.getHeight(this.level(), blockPos);
             if (d > eyeY) {
