Subject: [PATCH] Raid.moveRaidCenterToNearbyVillageSection stream arg


diff --git a/net/minecraft/world/entity/raid/Raid.java b/net/minecraft/world/entity/raid/Raid.java
index 8b63faae76da27714ba97d2ebbb066360a044169..6b122944fa5705c4858dff10dc6ec80eeee204cf 100644
--- a/net/minecraft/world/entity/raid/Raid.java
+++ b/net/minecraft/world/entity/raid/Raid.java
@@ -454,8 +454,27 @@ public class Raid {
     }
 
     private void moveRaidCenterToNearbyVillageSection(ServerLevel level) {
-        Stream<SectionPos> stream = SectionPos.cube(SectionPos.of(this.center), 2);
-        stream.filter(level::isVillage).map(SectionPos::center).min(Comparator.comparingDouble(pos -> pos.distSqr(this.center))).ifPresent(this::setCenter);
+        // Papo start - manual argmin over the cube instead of stream.filter.map.min.ifPresent
+        // (avoids the 4 lambdas + Optional allocation). min() keeps the first minimum on ties,
+        // which a strict `d < bestDist` comparison reproduces.
+        BlockPos best = null;
+        double bestDist = Double.MAX_VALUE;
+        java.util.Iterator<SectionPos> it = SectionPos.cube(SectionPos.of(this.center), 2).iterator();
+        while (it.hasNext()) {
+            SectionPos sectionPos = it.next();
+            if (level.isVillage(sectionPos)) {
+                BlockPos center = sectionPos.center();
+                double d = center.distSqr(this.center);
+                if (d < bestDist) {
+                    bestDist = d;
+                    best = center;
+                }
+            }
+        }
+        if (best != null) {
+            this.setCenter(best);
+        }
+        // Papo end
     }
 
     private Optional<BlockPos> getValidSpawnPos(ServerLevel level) {
