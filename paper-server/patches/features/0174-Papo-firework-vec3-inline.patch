From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sat, 1 Aug 2026 04:55:30 +0800
Subject: [PATCH] Papo firework vec3 inline


diff --git a/net/minecraft/world/entity/projectile/FireworkRocketEntity.java b/net/minecraft/world/entity/projectile/FireworkRocketEntity.java
index d7d0e1174cb81ec0ff69ed5fe318bf13c11241d7..f86b2e05299fc9a9d88dda2e0755d71c96c172b2 100644
--- a/net/minecraft/world/entity/projectile/FireworkRocketEntity.java
+++ b/net/minecraft/world/entity/projectile/FireworkRocketEntity.java
@@ -143,13 +143,14 @@ public class FireworkRocketEntity extends Projectile implements ItemSupplier {
                     double d = 1.5;
                     double d1 = 0.1;
                     Vec3 deltaMovement = this.attachedToEntity.getDeltaMovement();
+                    // Papo - skip the intermediate Vec3: add(...) + setDeltaMovement(Vec3) reads the same
+                    // components the direct form computes (setDeltaMovement(Vec3) is a pure delegate);
+                    // FP op order per component is identical.
                     this.attachedToEntity
                         .setDeltaMovement(
-                            deltaMovement.add(
-                                lookAngle.x * 0.1 + (lookAngle.x * 1.5 - deltaMovement.x) * 0.5,
-                                lookAngle.y * 0.1 + (lookAngle.y * 1.5 - deltaMovement.y) * 0.5,
-                                lookAngle.z * 0.1 + (lookAngle.z * 1.5 - deltaMovement.z) * 0.5
-                            )
+                            deltaMovement.x + (lookAngle.x * 0.1 + (lookAngle.x * 1.5 - deltaMovement.x) * 0.5),
+                            deltaMovement.y + (lookAngle.y * 0.1 + (lookAngle.y * 1.5 - deltaMovement.y) * 0.5),
+                            deltaMovement.z + (lookAngle.z * 0.1 + (lookAngle.z * 1.5 - deltaMovement.z) * 0.5)
                         );
                     handHoldingItemAngle = this.attachedToEntity.getHandHoldingItemAngle(Items.FIREWORK_ROCKET);
                 } else {
@@ -168,7 +169,10 @@ public class FireworkRocketEntity extends Projectile implements ItemSupplier {
         } else {
             if (!this.isShotAtAngle()) {
                 double d2 = this.horizontalCollision ? 1.0 : 1.15;
-                this.setDeltaMovement(this.getDeltaMovement().multiply(d2, 1.0, d2).add(0.0, 0.04, 0.0));
+                // Papo - skip the two intermediate Vec3: multiply(d2,1.0,d2).add(0,0.04,0) computed inline
+                // with the identical FP op chain (incl. the +0.0 terms, which the original add performs too).
+                Vec3 papoDm = this.getDeltaMovement();
+                this.setDeltaMovement(papoDm.x * d2 + 0.0, papoDm.y * 1.0 + 0.04, papoDm.z * d2 + 0.0);
             }
 
             Vec3 handHoldingItemAngle = this.getDeltaMovement();
