@@ -203,8 +203,25 @@ public class FriendlyByteBuf extends ByteBuf {
         }
     }
 
+    // Papo start - cache enum constant arrays: Class.getEnumConstants() clones the shared
+    // array on every call, but the contents (singletons in declaration order) never change,
+    // and the three call sites below only index/iterate the array without exposing it.
+    // Null (non-enum class) passes through and NPEs at the use site exactly as before.
+    private static final ClassValue<Object[]> PAPO_ENUM_CONSTANTS = new ClassValue<>() {
+        @Override
+        protected Object[] computeValue(Class<?> type) {
+            return type.getEnumConstants();
+        }
+    };
+
+    @SuppressWarnings("unchecked")
+    private static <T extends Enum<T>> T[] papoEnumConstants(Class<T> enumClass) {
+        return (T[]) PAPO_ENUM_CONSTANTS.get(enumClass);
+    }
+    // Papo end
+
     public <E extends Enum<E>> void writeEnumSet(EnumSet<E> enumSet, Class<E> enumClass) {
-        E[] enums = (E[])enumClass.getEnumConstants();
+        E[] enums = papoEnumConstants(enumClass); // Papo - cached enum constants (see above)
         BitSet bitSet = new BitSet(enums.length);
 
         for (int i = 0; i < enums.length; i++) {
@@ -215,7 +232,7 @@ public class FriendlyByteBuf extends ByteBuf {
     }
 
     public <E extends Enum<E>> EnumSet<E> readEnumSet(Class<E> enumClass) {
-        E[] enums = (E[])enumClass.getEnumConstants();
+        E[] enums = papoEnumConstants(enumClass); // Papo - cached enum constants (see above)
         BitSet fixedBitSet = this.readFixedBitSet(enums.length);
         EnumSet<E> set = EnumSet.noneOf(enumClass);
 
@@ -510,7 +527,7 @@ public class FriendlyByteBuf extends ByteBuf {
     }
 
     public <T extends Enum<T>> T readEnum(Class<T> enumClass) {
-        return enumClass.getEnumConstants()[this.readVarInt()];
+        return papoEnumConstants(enumClass)[this.readVarInt()]; // Papo - cached enum constants (see above)
     }
 
     public FriendlyByteBuf writeEnum(Enum<?> value) {
