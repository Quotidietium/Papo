@@ -166,9 +166,14 @@ public abstract class PathNavigation {
         } else {
             // Paper start - EntityPathfindEvent
             boolean copiedSet = false;
+            // Papo - zero listeners => callEvent() always returns true (never cancelled), so the event
+            // condition is vacuous; skip Location+event construction per target. EntityPathfindEvent has
