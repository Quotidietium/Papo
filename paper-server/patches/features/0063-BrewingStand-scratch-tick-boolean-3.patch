From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Thu, 30 Jul 2026 15:02:03 +0800
Subject: [PATCH] BrewingStand scratch tick boolean 3
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

酿造台每 tick 调用 getPotionBits 分配新 boolean[3]。改为复用 scratch 数组
在原位填充；lastPotionCount 预分配为独立数组，比较后用 System.arraycopy 拷贝。

diff --git a/net/minecraft/world/level/block/entity/BrewingStandBlockEntity.java b/net/minecraft/world/level/block/entity/BrewingStandBlockEntity.java
index 74577d6523db1cce6413317c016887f2a7bb9977..600fb2b27ea90a9de7b5a9b0f42c508533897df2 100644
--- a/net/minecraft/world/level/block/entity/BrewingStandBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BrewingStandBlockEntity.java
@@ -42,7 +42,8 @@ public class BrewingStandBlockEntity extends BaseContainerBlockEntity implements
     private NonNullList<ItemStack> items = NonNullList.withSize(5, ItemStack.EMPTY);
     public int brewTime;
     public int recipeBrewTime = 400; // Paper - Add recipeBrewTime
-    private boolean[] lastPotionCount;
+    private boolean[] lastPotionCount = new boolean[3]; // Papo - pre-allocated (transient cache); compared against the scratch array below
+    private final boolean[] potionBitsScratch = new boolean[3]; // Papo - reused each tick instead of allocating a new boolean[3]
     private Item ingredient;
     public int fuel;
     protected final ContainerData dataAccess = new ContainerData() {
@@ -187,7 +188,7 @@ public class BrewingStandBlockEntity extends BaseContainerBlockEntity implements
 
         boolean[] potionBits = blockEntity.getPotionBits();
         if (!Arrays.equals(potionBits, blockEntity.lastPotionCount)) {
-            blockEntity.lastPotionCount = potionBits;
+            System.arraycopy(potionBits, 0, blockEntity.lastPotionCount, 0, 3); // Papo - copy into the persistent lastPotionCount (potionBits is the reused scratch array)
             BlockState blockState = state;
             if (!(state.getBlock() instanceof BrewingStandBlock)) {
                 return;
@@ -202,15 +203,17 @@ public class BrewingStandBlockEntity extends BaseContainerBlockEntity implements
     }
 
     private boolean[] getPotionBits() {
-        boolean[] flags = new boolean[3];
+        // Papo start - fill the reused scratch array in place instead of allocating a new boolean[3] each tick
+        java.util.Arrays.fill(this.potionBitsScratch, false);
 
         for (int i = 0; i < 3; i++) {
             if (!this.items.get(i).isEmpty()) {
-                flags[i] = true;
+                this.potionBitsScratch[i] = true;
             }
         }
 
-        return flags;
+        return this.potionBitsScratch;
+        // Papo end
     }
 
     private static boolean isBrewable(PotionBrewing potionBrewing, NonNullList<ItemStack> items) {
