                 if (papoMemo != null) {
                     byte[] papoSegment = new byte[out.writerIndex() - PapoOutboundFraming.HEADROOM];
                     out.getBytes(PapoOutboundFraming.HEADROOM, papoSegment);
-                    papoMemo.papoStore(this.threshold, papoSegment);
+                    papoMemo.papoStore(this.threshold, i, papoInputHash, papoSegment);
                 }
                 // Papo end - shared wire-compression memo fill
             } catch (Exception e) {
