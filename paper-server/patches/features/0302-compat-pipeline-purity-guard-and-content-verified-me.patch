-            final byte[] papoCachedSegment = papoMemo != null ? papoMemo.papoSegmentFor(this.threshold) : null;
+            // Content-verified: the memo only replays when the CURRENT connection's uncompressed
+            // bytes hash to the same value the segment was filled from - a packet-editing plugin
+            // rewriting the shared instance between viewers fails the check and this connection
+            // compresses its own (plugin-modified) bytes instead, exactly like vanilla. The hash is
+            // computed once here, before deflate can touch the buffer's indexes, and reused for the
+            // fill below.
+            final long papoInputHash = papoMemo != null ? PapoSharedWireMemo.papoHashBytes(in) : 0L;
+            final byte[] papoCachedSegment = papoMemo != null ? papoMemo.papoSegmentFor(this.threshold, i, papoInputHash) : null;
             if (papoCachedSegment != null) {
                 final ByteBuf out = com.velocitypowered.natives.util.MoreByteBufUtils.preferredBuffer(
                     ctx.alloc(), this.compressor, PapoOutboundFraming.HEADROOM + papoCachedSegment.length);
@@ -104,11 +111,13 @@ public class CompressionEncoder extends MessageToByteEncoder<ByteBuf> {
                 }
                 // Papo start - shared wire-compression memo fill: snapshot the freshly compressed
