diff --git a/net/minecraft/network/PapoPipelineGuard.java b/net/minecraft/network/PapoPipelineGuard.java
new file mode 100644
index 0000000000000000000000000000000000000000..3bee3a7aa70f615c958f99c568d91011935a9134
--- /dev/null
+++ b/net/minecraft/network/PapoPipelineGuard.java
@@ -0,0 +1,69 @@
+package net.minecraft.network;
+
+import io.netty.channel.ChannelHandler;
+import io.netty.channel.ChannelPipeline;
+import java.util.Map;
+import java.util.Set;
+
+// Papo start - plugin-compatibility guard for shared packet instances and wire memos.
+//
+// Papo's chunk-send sharing (0241/0242), join-packet caches (0226/0245), pairing-packet sharing
+// (0248) and the encode/compression memos assume the packet bytes that leave the server are
+// exactly what this server encoded. Packet-editing plugins (ProtocolLib / PacketEvents and
+// everything built on them) intercept the outbound netty pipeline and rewrite packets per
+// connection - for a SHARED packet instance or a replayed memo that means cross-viewer
+// corruption or silently reverted edits.
+//
+// This guard makes every share/memo site fail closed: the optimization is only used on
+// connections whose pipeline is EXACTLY the set of handlers the vanilla server installs.
+// Any extra handler - a plugin injector, or any future unknown addition - disables
+// sharing/memoing for that connection and it falls back to vanilla per-connection behavior.
+// Handlers are matched by exact runtime class (subclassing a vanilla handler yields a
+// different class name and correctly counts as foreign); the anonymous "hackfix" adapter is
+// matched by its Connection$N synthetic name prefix.
+public final class PapoPipelineGuard {
+
+    private static final Set<String> VANILLA_HANDLER_CLASSES = Set.of(
+        "io.netty.handler.timeout.ReadTimeoutHandler",          // "timeout"
+        "net.minecraft.network.Varint21FrameDecoder",           // "splitter"
+        "net.minecraft.network.LocalFrameDecoder",              // "splitter" (in-memory pipeline)
+        "net.minecraft.network.MonitoredLocalFrameDecoder",     // "splitter" (in-memory + monitor)
+        "io.netty.handler.flow.FlowControlHandler",             // unnamed
+        "net.minecraft.network.PacketDecoder",                  // "decoder"
+        "net.minecraft.network.UnconfiguredPipelineHandler$Inbound",  // "inbound_config"
+        "net.minecraft.network.Varint21LengthFieldPrepender",   // "prepender"
+        "net.minecraft.network.LocalFrameEncoder",              // "prepender" (in-memory pipeline)
+        "net.minecraft.network.PacketEncoder",                  // "encoder"
+        "net.minecraft.network.UnconfiguredPipelineHandler$Outbound", // "outbound_config"
+        "net.minecraft.network.Connection",                     // "packet_handler"
+        "net.minecraft.network.CipherEncoder",                  // "encrypt"
+        "net.minecraft.network.CipherDecoder",                  // "decrypt"
+        "net.minecraft.network.CompressionEncoder",             // "compress"
+        "net.minecraft.network.CompressionDecoder",             // "decompress"
+        "net.minecraft.network.PacketBundlePacker",             // "bundler"
+        "net.minecraft.network.PacketBundleUnpacker"            // "unbundler"
+    );
+
+    private static final String CONNECTION_ANONYMOUS_PREFIX = "net.minecraft.network.Connection$"; // "hackfix"
+
+    private PapoPipelineGuard() {
+    }
+
+    /**
+     * True when the pipeline contains only handlers the vanilla server itself installed.
+     * Fail-closed: any unknown handler class (plugin injector, monitor, future addition)
+     * yields false, which disables packet-instance sharing and wire memos for the connection.
+     */
+    public static boolean papoPurePipeline(final ChannelPipeline pipeline) {
+        for (final Map.Entry<String, ChannelHandler> entry : pipeline) {
+            final String className = entry.getValue().getClass().getName();
+            if (!VANILLA_HANDLER_CLASSES.contains(className)
+                && !(className.startsWith(CONNECTION_ANONYMOUS_PREFIX)
+                    && entry.getValue() instanceof io.netty.channel.ChannelOutboundHandlerAdapter)) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
+// Papo end
diff --git a/net/minecraft/network/PapoSharedWireMemo.java b/net/minecraft/network/PapoSharedWireMemo.java
index 64f5257a5fa3be9c1f2f7e9d82e29e314f669d1e..876c7fd47eae1c3ce3c49406c43dd45549f0cb33 100644
--- a/net/minecraft/network/PapoSharedWireMemo.java
+++ b/net/minecraft/network/PapoSharedWireMemo.java
@@ -43,6 +43,8 @@ public final class PapoSharedWireMemo {
 
     private volatile int papoThreshold = -1;
     private volatile long papoLevelEpoch;
+    private volatile int papoInputLength = -1;
+    private volatile long papoInputHash;
     private volatile byte @Nullable [] papoSegment;
 
     private PapoSharedWireMemo() {
@@ -69,24 +71,51 @@ public final class PapoSharedWireMemo {
         return PAPO_LEVEL_EPOCH.get();
     }
 
-    /** Returns the memo'd segment when it was produced for the given threshold and current level epoch. */
-    public byte @Nullable [] papoSegmentFor(int threshold) {
-        if (this.papoThreshold != threshold || this.papoLevelEpoch != papoLevelEpoch()) {
+    /**
+     * Returns the memo'd segment when it was produced for the given threshold, current level epoch,
+     * and - critically - the given UNCOMPRESSED input identity (length + content hash). The memo is
+     * keyed on the packet instance, not its content: if anything mutated the packet between the
+     * fill and this replay (a packet-editing plugin rewriting a shared instance per viewer), the
+     * encoded bytes differ and the hash check fails the replay - the connection then compresses its
+     * own (correct) bytes. This is what makes replay content-verified instead of identity-trusted.
+     */
+    public byte @Nullable [] papoSegmentFor(int threshold, int inputLength, long inputHash) {
+        if (this.papoThreshold != threshold || this.papoLevelEpoch != papoLevelEpoch()
+            || this.papoInputLength != inputLength || this.papoInputHash != inputHash) {
             return null;
         }
         return this.papoSegment;
     }
 
-    /** Stores the segment produced for the given threshold; first writer for a stamp wins. */
-    public void papoStore(int threshold, byte[] segment) {
+    /** Stores the segment produced for the given threshold and uncompressed input identity; first writer for a stamp wins. */
+    public void papoStore(int threshold, int inputLength, long inputHash, byte[] segment) {
         long epoch = papoLevelEpoch();
-        if (this.papoSegment == null || this.papoThreshold != threshold || this.papoLevelEpoch != epoch) {
+        if (this.papoSegment == null || this.papoThreshold != threshold || this.papoLevelEpoch != epoch
+            || this.papoInputLength != inputLength || this.papoInputHash != inputHash) {
             this.papoThreshold = threshold;
             this.papoLevelEpoch = epoch;
+            this.papoInputLength = inputLength;
+            this.papoInputHash = inputHash;
             this.papoSegment = segment; // volatile store publishes the stamp + fully-initialised array
         }
     }
 
+    /**
+     * FNV-1a 64 over the readable bytes of the buffer; index-neutral (does not move reader/writer).
+     * Purely arithmetic, so it is deterministic across JVMs. Collisions are not a practical concern:
+     * the check exists to catch packet mutation between viewers, not adversarial forgery.
+     */
+    static long papoHashBytes(io.netty.buffer.ByteBuf buf) {
+        long hash = 0xcbf29ce484222325L;
+        final int from = buf.readerIndex();
+        final int to = from + buf.readableBytes();
+        for (int i = from; i < to; i++) {
+            hash ^= buf.getByte(i) & 0xFFL;
+            hash *= 0x100000001b3L;
+        }
+        return hash;
+    }
+
     /** Implemented by packet instances that can carry a shared compression memo. */
     public interface Carrier {
         @Nullable
