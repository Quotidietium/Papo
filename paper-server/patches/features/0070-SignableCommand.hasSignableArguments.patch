diff --git a/net/minecraft/network/chat/SignableCommand.java b/net/minecraft/network/chat/SignableCommand.java
index 51b8da7cc4176ef950c61db2443e26e25623dae8..d9b0db54801d48d466f60183f2ad47035df1803a 100644
--- a/net/minecraft/network/chat/SignableCommand.java
+++ b/net/minecraft/network/chat/SignableCommand.java
@@ -12,7 +12,34 @@ import org.jspecify.annotations.Nullable;
 
 public record SignableCommand<S>(List<SignableCommand.Argument<S>> arguments) {
     public static <S> boolean hasSignableArguments(ParseResults<S> parseResults) {
-        return !of(parseResults).arguments().isEmpty();
+        // Papo start - early-exit on the first signed argument instead of building the whole list
+        // via of() just to check isEmpty().
+        String string = parseResults.getReader().getString();
+        CommandContextBuilder<S> context = parseResults.getContext();
+        CommandContextBuilder<S> commandContextBuilder = context;
+        if (hasSignableArgumentIn(string, commandContextBuilder)) {
+            return true;
+        }
+        CommandContextBuilder<S> child;
+        while ((child = commandContextBuilder.getChild()) != null && child.getRootNode() != context.getRootNode()) {
+            if (hasSignableArgumentIn(string, child)) {
+                return true;
+            }
+            commandContextBuilder = child;
+        }
+        return false;
+        // Papo end
+    }
+
+    private static <S> boolean hasSignableArgumentIn(String key, CommandContextBuilder<S> contextBuilder) {
+        for (ParsedCommandNode<S> parsedCommandNode : contextBuilder.getNodes()) {
+            if (parsedCommandNode.getNode() instanceof ArgumentCommandNode<S, ?> argumentCommandNode && argumentCommandNode.getType() instanceof SignedArgument) {
+                if (contextBuilder.getArguments().get(argumentCommandNode.getName()) != null) {
+                    return true;
+                }
+            }
+        }
+        return false;
     }
 
     public static <S> SignableCommand<S> of(ParseResults<S> results) {
