Subject: [PATCH] ChunkGenerator.addVanillaDecorations rangeClosed 3 3


diff --git a/net/minecraft/world/level/chunk/ChunkGenerator.java b/net/minecraft/world/level/chunk/ChunkGenerator.java
index 5a8e7e21cc3ca87158565d821b5383cd72697c8c..a3a5291c38714c0a3aa7b4d790666e3a726428df 100644
--- a/net/minecraft/world/level/chunk/ChunkGenerator.java
+++ b/net/minecraft/world/level/chunk/ChunkGenerator.java
@@ -366,13 +366,20 @@ public abstract class ChunkGenerator {
             WorldgenRandom worldgenRandom = new WorldgenRandom(new XoroshiroRandomSource(RandomSupport.generateUniqueSeed()));
             long l = worldgenRandom.setDecorationSeed(level.getSeed(), blockPos.getX(), blockPos.getZ());
             Set<Holder<Biome>> set = new ObjectArraySet<>();
-            ChunkPos.rangeClosed(sectionPos.chunk(), 1).forEach(chunkPos -> {
-                ChunkAccess chunk1 = level.getChunk(chunkPos.x, chunkPos.z);
-
-                for (LevelChunkSection levelChunkSection : chunk1.getSections()) {
-                    levelChunkSection.getBiomes().getAll(set::add);
+            // Papo start - avoid Stream + 9 ChunkPos allocations per chunk: rangeClosed(center, 1) is exactly
+            // the inclusive 3x3 x/z region around the center; iterate coordinates directly. The biome Holders
+            // land in `set` (order-independent content; downstream output is sorted), so iteration order is irrelevant.
+            ChunkPos papoCenterChunk = sectionPos.chunk();
+            for (int papoCx = papoCenterChunk.x - 1; papoCx <= papoCenterChunk.x + 1; papoCx++) {
+                for (int papoCz = papoCenterChunk.z - 1; papoCz <= papoCenterChunk.z + 1; papoCz++) {
+                    ChunkAccess chunk1 = level.getChunk(papoCx, papoCz);
+
+                    for (LevelChunkSection levelChunkSection : chunk1.getSections()) {
+                        levelChunkSection.getBiomes().getAll(set::add);
+                    }
                 }
-            });
+            }
+            // Papo end
             set.retainAll(this.biomeSource.possibleBiomes());
             int size = list.size();
 
