From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 20:47:01 +0800
Subject: [PATCH] push x y z null Vector getX Y Z add x y z tick


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 864aee5718915998990f44b1f618c629d241d315..024b72cd4c3cf90b19d3bf0a689960fff86fd09a 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -2359,15 +2359,21 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
         // Paper end - Add EntityKnockbackByEntityEvent and EntityPushedByEntityAttackEvent
         if (Double.isFinite(x) && Double.isFinite(y) && Double.isFinite(z)) {
             // Paper start - Add EntityKnockbackByEntityEvent and EntityPushedByEntityAttackEvent
-            org.bukkit.util.Vector delta = new org.bukkit.util.Vector(x, y, z);
+            // Papo start - avoid the unconditional Vector allocation on the pushingEntity==null path:
+            // Vector(double,double,double) only stores the fields and getX/Y/Z read them back, so
+            // add(delta.getX(), delta.getY(), delta.getZ()) == add(x, y, z) bit-exactly.
             if (pushingEntity != null) {
+                org.bukkit.util.Vector delta = new org.bukkit.util.Vector(x, y, z);
                 io.papermc.paper.event.entity.EntityPushedByEntityAttackEvent event = new io.papermc.paper.event.entity.EntityPushedByEntityAttackEvent(this.getBukkitEntity(), io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.PUSH, pushingEntity.getBukkitEntity(), delta);
                 if (!event.callEvent()) {
                     return;
                 }
                 delta = event.getKnockback();
+                this.setDeltaMovement(this.getDeltaMovement().add(delta.getX(), delta.getY(), delta.getZ()));
+            } else {
+                this.setDeltaMovement(this.getDeltaMovement().add(x, y, z));
             }
-            this.setDeltaMovement(this.getDeltaMovement().add(delta.getX(), delta.getY(), delta.getZ()));
+            // Papo end
             // Paper end - Add EntityKnockbackByEntityEvent and EntityPushedByEntityAttackEvent
             this.needsSync = true;
         }
