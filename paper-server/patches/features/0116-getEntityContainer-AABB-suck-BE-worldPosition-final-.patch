     public List<org.bukkit.entity.HumanEntity> transaction = new java.util.ArrayList<>();
@@ -735,7 +743,20 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
     private static @Nullable Container getAttachedContainer(Level level, BlockPos pos, HopperBlockEntity blockEntity) {
         // Paper start
         BlockPos searchPosition = pos.relative(blockEntity.facing);
-        Container inventory = getContainerAt(level, searchPosition);
+        // Papo start - reuse cached entity-search AABB keyed on the search position (see field comment);
+        // the 3-arg getContainerAt computes x/y/z = pos + 0.5 then AABB(x-0.5, y-0.5, z-0.5, x+0.5, y+0.5, z+0.5),
+        // rebuilt here with the identical expression so cached and per-call values are bit-exact equal.
+        net.minecraft.world.phys.AABB entitySearchAabb;
+        if (searchPosition.equals(blockEntity.papoEntityEjectSearchPos)) {
+            entitySearchAabb = blockEntity.papoEntityEjectAabb;
+        } else {
+            double x = searchPosition.getX() + 0.5, y = searchPosition.getY() + 0.5, z = searchPosition.getZ() + 0.5;
+            entitySearchAabb = new net.minecraft.world.phys.AABB(x - 0.5, y - 0.5, z - 0.5, x + 0.5, y + 0.5, z + 0.5);
+            blockEntity.papoEntityEjectSearchPos = searchPosition;
+            blockEntity.papoEntityEjectAabb = entitySearchAabb;
+        }
+        Container inventory = getContainerAt(level, searchPosition, level.getBlockState(searchPosition), searchPosition.getX() + 0.5, searchPosition.getY() + 0.5, searchPosition.getZ() + 0.5, true, entitySearchAabb);
+        // Papo end
         if (org.bukkit.event.inventory.HopperInventorySearchEvent.getHandlerList().getRegisteredListeners().length == 0) return inventory;
 
         org.bukkit.craftbukkit.block.CraftBlock hopper = org.bukkit.craftbukkit.block.CraftBlock.at(level, pos);
@@ -751,7 +772,10 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
 
