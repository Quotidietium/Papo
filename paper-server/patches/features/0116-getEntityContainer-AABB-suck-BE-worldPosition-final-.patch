+    // Papo start - cached entity-search AABBs for getEntityContainer (both are constant per block entity:
+    // suck side derives from worldPosition (final) via getLevelX/Y/Z; eject side is keyed on the search
+    // position so a facing change via same-block setBlock (which keeps the BE) recomputes. AABB is
+    // immutable and getEntitiesOfClass only reads it. Minecart hoppers never touch these (instanceof gate).
+    private net.minecraft.world.phys.AABB papoEntitySuckAabb;
+    private BlockPos papoEntityEjectSearchPos;
+    private net.minecraft.world.phys.AABB papoEntityEjectAabb;
