+        // Papo - pass the BE-cached entity-search AABB for block-entity hoppers (worldPosition final);
+        // minecart hoppers (moving) fall back to the per-call allocation path via null.
+        final Container inventory = HopperBlockEntity.getContainerAt(level, pos, state, hopper.getLevelX(), hopper.getLevelY() + 1.0D, hopper.getLevelZ(), false,
+            hopper instanceof HopperBlockEntity hopperBlockEntity ? hopperBlockEntity.papoEntitySuckAabb() : null);
         if (org.bukkit.event.inventory.HopperInventorySearchEvent.getHandlerList().getRegisteredListeners().length == 0) return inventory;
 
         final BlockPos hopperPos = BlockPos.containing(hopper.getLevelX(), hopper.getLevelY(), hopper.getLevelZ());
@@ -788,20 +812,35 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
