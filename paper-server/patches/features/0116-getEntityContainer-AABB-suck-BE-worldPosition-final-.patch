-        // Paper start - Perf: Optimize Hoppers
-        return HopperBlockEntity.getContainerAt(level, pos, state, x, y, z, false);
-    }
+    // Paper start - Perf: Optimize Hoppers
     private static @Nullable Container getContainerAt(Level level, BlockPos pos, BlockState state, double x, double y, double z, final boolean optimizeEntities) {
-        // Paper end - Perf: Optimize Hoppers
+        return HopperBlockEntity.getContainerAt(level, pos, state, x, y, z, optimizeEntities, null); // Papo
+    }
+    // Paper end - Perf: Optimize Hoppers
+
+    // Papo start - extra overload carrying an optional cached entity-search AABB (null = construct per call,
+    // bit-exact same expression as before); keeps the 7-arg overload above behavior-identical.
+    private static @Nullable Container getContainerAt(Level level, BlockPos pos, BlockState state, double x, double y, double z, final boolean optimizeEntities, final net.minecraft.world.phys.@Nullable AABB entitySearchAabb) {
         Container blockContainer = getBlockContainer(level, pos, state);
         if (blockContainer == null && (!optimizeEntities || !level.paperConfig().hopper.ignoreOccludingBlocks || !state.getBukkitMaterial().isOccluding())) { // Paper - Perf: Optimize Hoppers
-            blockContainer = getEntityContainer(level, x, y, z);
+            blockContainer = getEntityContainer(level, entitySearchAabb != null ? entitySearchAabb : new net.minecraft.world.phys.AABB(x - 0.5, y - 0.5, z - 0.5, x + 0.5, y + 0.5, z + 0.5));
         }
 
         return blockContainer;
     }
 
+    // Lazy suck-side entity-search AABB; same expression as the original per-call construction
+    // (x = getLevelX(), y = getLevelY() + 1.0, z = getLevelZ()), constant per block entity.
+    private net.minecraft.world.phys.AABB papoEntitySuckAabb() {
+        net.minecraft.world.phys.AABB aabb = this.papoEntitySuckAabb;
+        if (aabb == null) {
+            double x = this.getLevelX(), y = this.getLevelY() + 1.0D, z = this.getLevelZ();
+            aabb = this.papoEntitySuckAabb = new net.minecraft.world.phys.AABB(x - 0.5, y - 0.5, z - 0.5, x + 0.5, y + 0.5, z + 0.5);
+        }
+        return aabb;
+    }
+    // Papo end
+
     private static @Nullable Container getBlockContainer(Level level, BlockPos pos, BlockState state) {
         if (!level.spigotConfig.hopperCanLoadChunks && !level.hasChunkAt(pos)) return null; // Spigot
         Block block = state.getBlock();
@@ -818,9 +857,9 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
         }
     }
 
-    private static @Nullable Container getEntityContainer(Level level, double x, double y, double z) {
