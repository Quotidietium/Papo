diff --git a/net/minecraft/world/level/block/entity/ConduitBlockEntity.java b/net/minecraft/world/level/block/entity/ConduitBlockEntity.java
index a6fdd9be704b9590bf3f14ea7c6a3cf6ab807158..516f10b6ddd354d302247a0646fb036498cb58a1 100644
--- a/net/minecraft/world/level/block/entity/ConduitBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/ConduitBlockEntity.java
@@ -180,7 +180,8 @@ public class ConduitBlockEntity extends BlockEntity {
         int x = pos.getX();
         int y = pos.getY();
         int z = pos.getZ();
-        AABB aabb = new AABB(x, y, z, x + 1, y + 1, z + 1).inflate(i).expandTowards(0.0, level.getHeight(), 0.0);
+        // Papo - collapse inflate/expandTowards into one AABB (bit-identical: all terms are exact ints widened once; i >= 0, height > 0)
+        AABB aabb = new AABB(x - i, y - i, z - i, x + 1 + i, y + 1 + i + level.getHeight(), z + 1 + i);
         List<Player> entitiesOfClass = level.getEntitiesOfClass(Player.class, aabb);
         if (!entitiesOfClass.isEmpty()) {
             for (Player player : entitiesOfClass) {
@@ -233,7 +234,8 @@ public class ConduitBlockEntity extends BlockEntity {
     }
 
     public static AABB getDestroyRangeAABB(BlockPos pos) {
-        return new AABB(pos).inflate(8.0);
+        // Papo - collapse AABB(pos).inflate(8) into one AABB (bit-identical: exact int terms widened once)
+        return new AABB(pos.getX() - 8, pos.getY() - 8, pos.getZ() - 8, pos.getX() + 1 + 8, pos.getY() + 1 + 8, pos.getZ() + 1 + 8);
     }
 
     private static void animationTick(Level level, BlockPos pos, List<BlockPos> positions, @Nullable Entity entity, int tickCount) {
