From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sun, 2 Aug 2026 19:17:38 +0800
Subject: [PATCH] Papo: eliminate per-outbound-packet lambda in
 Connection.sendPacket


diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 90bcd40d182ccf5465a3c6913f13dd5fb2b51907..35607a506e340212acad778e8e436c0febc3a3ba 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -445,11 +445,25 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
 
     private void sendPacket(Packet<?> packet, @Nullable ChannelFutureListener sendListener, boolean flush) {
         this.sentPackets++;
-        if (this.channel.eventLoop().inEventLoop()) {
-            this.doSendPacket(packet, sendListener, flush);
-        } else {
-            this.channel.eventLoop().execute(() -> this.doSendPacket(packet, sendListener, flush));
-        }
+        // Papo start - eliminate the per-outbound-packet execute(() -> doSendPacket(...)) lambda.
+        // The lambda was allocated on every send from a non-event-loop thread (the common case: server
+        // sends happen on the main tick thread, which is not the netty event loop) — the highest-
+        // frequency allocation on the network send path. doSendPacket is safe to call directly from any
+        // thread:
+        //   - this.channel.write/writeAndFlush and ChannelFuture.addListener are netty-thread-safe
+        //     (netty serializes writes per-channel via the event loop, preserving write order regardless
+        //     of the calling thread — Javadoc: "if the current thread is not in the event loop, the
+        //     write request is scheduled for later");
+        //   - getPlayer() reads the volatile packetListener field; isConnected() reads this.channel
+        //     (already read off-event-loop in send():403, same access pattern);
+        //   - sentPackets is incremented above on the caller thread (unchanged by this edit);
+        //   - the rare catch-path disconnect() is already invoked cross-thread elsewhere (e.g. channel
+        //     close on the event loop) and relies on thread-safe channel.close(); pendingActions access
+        //     there is a pre-existing concurrency pattern, not introduced or worsened here.
+        // Net effect: doSendPacket's body runs on the caller thread instead of being scheduled, but the
+        // actual write is still queued to the event loop by netty — packet send order is preserved.
+        this.doSendPacket(packet, sendListener, flush);
+        // Papo end - eliminate per-outbound-packet lambda
     }
 
     private void doSendPacket(Packet<?> packet, @Nullable ChannelFutureListener sendListener, boolean flush) {
