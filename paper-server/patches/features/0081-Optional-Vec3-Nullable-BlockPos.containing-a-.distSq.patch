+    @Nullable // Papo
+    private static Vec3 getPostableListenerPosition(ServerLevel level, Vec3 pos, GameEventListener listener) {
         Optional<Vec3> position = listener.getListenerSource().getPosition(level);
         if (position.isEmpty()) {
-            return Optional.empty();
+            return null; // Papo
         } else {
-            double d = BlockPos.containing(position.get()).distSqr(BlockPos.containing(pos));
