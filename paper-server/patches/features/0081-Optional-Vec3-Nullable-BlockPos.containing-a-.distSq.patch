@@ -110,14 +111,23 @@ public class EuclideanGameEventListenerRegistry implements GameEventListenerRegi
         return flag;
     }
 
-    private static Optional<Vec3> getPostableListenerPosition(ServerLevel level, Vec3 pos, GameEventListener listener) {
+    @Nullable // Papo
+    private static Vec3 getPostableListenerPosition(ServerLevel level, Vec3 pos, GameEventListener listener) {
         Optional<Vec3> position = listener.getListenerSource().getPosition(level);
         if (position.isEmpty()) {
-            return Optional.empty();
+            return null; // Papo
         } else {
-            double d = BlockPos.containing(position.get()).distSqr(BlockPos.containing(pos));
+            // Papo start - inline BlockPos.containing(a).distSqr(BlockPos.containing(b)) as floored
+            // integer deltas (BlockPos.containing floors each coordinate; distSqr of two int positions
+            // is the squared-delta sum — value identical), no Optional/BlockPos allocations.
+            Vec3 listenerPos = position.get();
+            long dx = (long) net.minecraft.util.Mth.floor(listenerPos.x) - net.minecraft.util.Mth.floor(pos.x);
+            long dy = (long) net.minecraft.util.Mth.floor(listenerPos.y) - net.minecraft.util.Mth.floor(pos.y);
+            long dz = (long) net.minecraft.util.Mth.floor(listenerPos.z) - net.minecraft.util.Mth.floor(pos.z);
+            double d = (double) (dx * dx + dy * dy + dz * dz);
+            // Papo end
             int i = listener.getListenerRadius() * listener.getListenerRadius();
-            return d > i ? Optional.empty() : position;
+            return d > i ? null : listenerPos; // Papo
         }
     }
 
