diff --git a/net/minecraft/world/level/block/FireBlock.java b/net/minecraft/world/level/block/FireBlock.java
index d1e3dd74e38e186ef9fd61c4ab1f61d084746a9a..ad3758dc2e6514eb0fdb1a856cf99e00e477f024 100644
--- a/net/minecraft/world/level/block/FireBlock.java
+++ b/net/minecraft/world/level/block/FireBlock.java
@@ -225,7 +225,11 @@ public class FireBlock extends BaseFireBlock {
                                         int min1 = Math.min(15, ageValue + random.nextInt(5) / 4);
                                         // CraftBukkit start - Call to stop spread of fire
                                         if (!level.getBlockState(mutableBlockPos).is(Blocks.FIRE)) {
-                                            if (org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(level, mutableBlockPos, pos).isCancelled()) {
+                                            // Papo - zero listeners => never cancelled, control flow always
+                                            // proceeds to handleBlockSpreadEvent (event has no subclasses,
+                                            // constructor only stores fields)
+                                            if (org.bukkit.event.block.BlockIgniteEvent.getHandlerList().getRegisteredListeners().length > 0
+                                                && org.bukkit.craftbukkit.event.CraftEventFactory.callBlockIgniteEvent(level, mutableBlockPos, pos).isCancelled()) {
                                                 continue;
                                             }
 
diff --git a/net/minecraft/world/level/block/LeavesBlock.java b/net/minecraft/world/level/block/LeavesBlock.java
index d5b114dca7b28d910f03ae3468e891d5d9863897..daa5389d9c9e079f7b0956a8fe9dbd2d02db8290 100644
--- a/net/minecraft/world/level/block/LeavesBlock.java
+++ b/net/minecraft/world/level/block/LeavesBlock.java
@@ -67,12 +67,19 @@ public abstract class LeavesBlock extends Block implements SimpleWaterloggedBloc
     protected void randomTick(BlockState state, ServerLevel level, BlockPos pos, RandomSource random) {
         if (this.decaying(state)) {
             // CraftBukkit start
-            org.bukkit.event.block.LeavesDecayEvent event = new org.bukkit.event.block.LeavesDecayEvent(org.bukkit.craftbukkit.block.CraftBlock.at(level, pos));
-            level.getCraftServer().getPluginManager().callEvent(event);
-
-            if (event.isCancelled() || !level.getBlockState(pos).is(this)) {
+            // Papo start - zero listeners => never cancelled; keep the getBlockState(pos).is(this)
+            // re-check (no allocation) so the observable control flow is identical
+            if (org.bukkit.event.block.LeavesDecayEvent.getHandlerList().getRegisteredListeners().length > 0) {
+                org.bukkit.event.block.LeavesDecayEvent event = new org.bukkit.event.block.LeavesDecayEvent(org.bukkit.craftbukkit.block.CraftBlock.at(level, pos));
+                level.getCraftServer().getPluginManager().callEvent(event);
+
+                if (event.isCancelled() || !level.getBlockState(pos).is(this)) {
+                    return;
+                }
+            } else if (!level.getBlockState(pos).is(this)) {
                 return;
             }
+            // Papo end
             // CraftBukkit end
             dropResources(state, level, pos);
             level.removeBlock(pos, false);
