Subject: [PATCH] batch 173 (R32): palette repack packs straight from a
 per-cell mapping - new SimpleBitStorage(bits,size,IntUnaryOperator) ctor
 (loop line-identical to the int[] ctor) +
 PalettedContainer.papoReencodedStorage (run-length memo preserved: idFor once
 per consecutive run, consumed once in ascending order on the owning thread).
 Eliminates the int[entryCount] intermediate of reencodeContents (16KB per
 repack for block sections) that exists only to be consumed once by the
 packing loop; census face 316 trips/429MB = 5.2% of the fresh-gen streaming
 window. Legacy array pipeline kept as package-private test oracle.


diff --git a/net/minecraft/util/SimpleBitStorage.java b/net/minecraft/util/SimpleBitStorage.java
index 8f03fed6fa2ddd1e60a9b562245ce64d440551da..c03c5d364755ebdd30e8ee10686412d9ead25ea7 100644
--- a/net/minecraft/util/SimpleBitStorage.java
+++ b/net/minecraft/util/SimpleBitStorage.java
@@ -251,6 +251,41 @@ public class SimpleBitStorage implements BitStorage {
         }
     }
 
+    // Papo start - batch 173 (R32): function-sourced packing variant - loop shape is
+    // line-identical to the int[] ctor above, only the per-cell id source changes.
+    // Lets palette re-encoding (reencodeContents callers) pack straight from a per-cell
+    // mapping instead of materializing an int[entryCount] (16KB per repack for block
+    // sections) that exists only to be consumed once by this loop.
+    public SimpleBitStorage(int bits, int size, final java.util.function.IntUnaryOperator ids) {
+        this(bits, size);
+        int i = 0;
+
+        int i1;
+        for (i1 = 0; i1 <= size - this.valuesPerLong; i1 += this.valuesPerLong) {
+            long l = 0L;
+
+            for (int i2 = this.valuesPerLong - 1; i2 >= 0; i2--) {
+                l <<= bits;
+                l |= ids.applyAsInt(i1 + i2) & this.mask;
+            }
+
+            this.data[i++] = l;
+        }
+
+        int i3 = size - i1;
+        if (i3 > 0) {
+            long l1 = 0L;
+
+            for (int i4 = i3 - 1; i4 >= 0; i4--) {
+                l1 <<= bits;
+                l1 |= ids.applyAsInt(i1 + i4) & this.mask;
+            }
+
+            this.data[i] = l1;
+        }
+    }
+    // Papo end - batch 173 (R32)
+
     public SimpleBitStorage(int bits, int size) {
         this(bits, size, (long[])null);
     }
