+    // Papo start - batch 173 (R32): pack the re-encoded ids straight into the new storage
+    // via the function-sourced SimpleBitStorage ctor, eliminating the int[entryCount]
+    // intermediate of reencodeContents (kept above as the identity oracle for tests).
+    // The mapping closure memoizes the last (oldId -> newId) pair - the same
+    // consecutive-run memo the array version uses - and is consumed exactly once, in
+    // ascending index order, on the thread that built it (both call sites synchronize /
+    // exclusively own the container being repacked).
+    static <T> SimpleBitStorage papoReencodedStorage(
+        final BitStorage bitStorage, final Palette<T> oldPalette, final Palette<T> newPalette, final int newBits, final int entryCount
+    ) {
+        final PaletteResize<T> paletteResize = PaletteResize.noResizeExpected();
+        return new SimpleBitStorage(newBits, entryCount, new java.util.function.IntUnaryOperator() {
+            private int lastOld = -1;
+            private int lastNew = -1;
+
+            @Override
+            public int applyAsInt(final int index) {
+                final int oldId = bitStorage.get(index);
+                if (oldId != this.lastOld) {
+                    this.lastOld = oldId;
+                    this.lastNew = newPalette.idFor(oldPalette.valueFor(oldId), paletteResize);
+                }
+                return this.lastNew;
+            }
+        });
+    }
+    // Papo end - batch 173 (R32)
+
     @Override
     public int getSerializedSize() {
