Subject: [PATCH] Papo fishing open water


diff --git a/net/minecraft/world/entity/projectile/FishingHook.java b/net/minecraft/world/entity/projectile/FishingHook.java
index 61b19dc84b68dbf567ae9ffa9e882ce979f61e74..5543ee44864b485b73a41a70a32c3cb971d92ecb 100644
--- a/net/minecraft/world/entity/projectile/FishingHook.java
+++ b/net/minecraft/world/entity/projectile/FishingHook.java
@@ -443,9 +443,10 @@ public class FishingHook extends Projectile {
 
     public boolean calculateOpenWater(BlockPos pos) {
         FishingHook.OpenWaterType openWaterType = FishingHook.OpenWaterType.INVALID;
+        BlockPos.MutableBlockPos papoScratch = new BlockPos.MutableBlockPos(); // Papo - shared scratch for the area scans
 
         for (int i = -1; i <= 2; i++) {
-            FishingHook.OpenWaterType openWaterTypeForArea = this.getOpenWaterTypeForArea(pos.offset(-2, i, -2), pos.offset(2, i, 2));
+            FishingHook.OpenWaterType openWaterTypeForArea = this.getOpenWaterTypeForArea(pos, i, papoScratch); // Papo
             switch (openWaterTypeForArea) {
                 case ABOVE_WATER:
                     if (openWaterType == FishingHook.OpenWaterType.INVALID) {
@@ -467,12 +468,35 @@ public class FishingHook extends Projectile {
         return true;
     }
 
-    private FishingHook.OpenWaterType getOpenWaterTypeForArea(BlockPos pos1, BlockPos pos2) {
-        return BlockPos.betweenClosedStream(pos1, pos2)
-            .map(this::getOpenWaterTypeForBlock)
-            .reduce((type1, type2) -> type1 == type2 ? type1 : FishingHook.OpenWaterType.INVALID)
-            .orElse(FishingHook.OpenWaterType.INVALID);
+    // Papo start - imperative equivalent of the original stream fold: betweenClosedStream(
+    // pos.offset(-2, i, -2), pos.offset(2, i, 2)) yields exactly the 25 coordinates of ONE horizontal
+    // 5x5 layer at y = pos.y + i (both corners share the same y), which the x/z loops below visit
+    // (batch 135 fix: the earlier rewrite wrongly scanned minY..minY+4 - five layers per i - which
+    // flipped open-water verdicts near the surface). The reduce combiner (type1 == type2 ? type1 : INVALID) computes
+    // "all equal ? that value : INVALID" which is order-independent with INVALID absorbing, so the early exit
+    // on INVALID preserves the final value; getOpenWaterTypeForBlock is side-effect free (getBlockState /
+    // getCollisionShape are pure coordinate reads - vanilla passes a mutable BlockPos into getCollisionShape
+    // the same way in BlockCollisions). One scratch replaces the per-block immutable BlockPos +
+    // stream/spliterator/method-ref allocations per area, and the 8 outer pos.offset calls fold into
+    // the loop bounds.
+    private FishingHook.OpenWaterType getOpenWaterTypeForArea(BlockPos pos, int i, BlockPos.MutableBlockPos scratch) {
+        FishingHook.OpenWaterType openWaterType = null;
+        int minY = pos.getY() + i;
+
+        for (int x = pos.getX() - 2; x <= pos.getX() + 2; x++) {
+            for (int z = pos.getZ() - 2; z <= pos.getZ() + 2; z++) {
+                    FishingHook.OpenWaterType type = this.getOpenWaterTypeForBlock(scratch.set(x, minY, z));
+                    if (openWaterType == null) {
+                        openWaterType = type;
+                    } else if (openWaterType != type) {
+                        return FishingHook.OpenWaterType.INVALID;
+                    }
+            }
+        }
+
+        return openWaterType == null ? FishingHook.OpenWaterType.INVALID : openWaterType;
     }
+    // Papo end
 
     private FishingHook.OpenWaterType getOpenWaterTypeForBlock(BlockPos pos) {
         BlockState blockState = this.level().getBlockState(pos);
