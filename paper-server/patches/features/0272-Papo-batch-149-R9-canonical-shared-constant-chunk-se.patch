+    // Papo start - batch 149 (R9): uniform-value read for canonical shared-section
+    // collapsing (LevelChunkSection.papoTryCanonicalise) - returns the container's lone
+    // distinct value, or null when the cells are not uniform. Worldgen-built uniform
+    // sections hold GROWN palettes, not SingleValuePalette (a biome container whose
+    // resolved biome differs from the default resizes to a one-entry linear palette on
+    // its first quart write; a written all-stone section likewise), so the palette type
+    // says nothing about uniformity - the cells do.
+    public T papoUniformValue() {
+        final PalettedContainer.Data<T> data = this.data;
+        final net.minecraft.util.BitStorage papoStorage = data.storage();
+        if (papoStorage.getBits() == 0) {
+            return data.palette().valueFor(0); // zero-bit storage: every cell is id 0
+        }
+        // fast reject: unequal raw words imply unequal cells (words are the packed
+        // cells); equal words are necessary but not sufficient, the per-cell pass below
+        // settles it
+        final long[] papoRaw = papoStorage.getRaw();
+        final long papoFirst = papoRaw[0];
+        for (int papoI = 1; papoI < papoRaw.length; papoI++) {
+            if (papoRaw[papoI] != papoFirst) {
+                return null;
+            }
+        }
+        final int papoId = papoStorage.get(0);
+        final boolean[] papoUniform = {true};
+        papoStorage.getAll(papoCell -> {
+            if (papoCell != papoId) {
+                papoUniform[0] = false;
+            }
+        });
+        return papoUniform[0] ? data.palette().valueFor(papoId) : null;
+    }
+    // Papo end - batch 149 (R9)
+
