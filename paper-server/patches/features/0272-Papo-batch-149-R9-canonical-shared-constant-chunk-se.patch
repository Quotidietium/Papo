+    // exactly what was acquired); the read-path getSection above stays untouched.
+    public @Nullable LevelChunkSection getWritableSection(BlockPos pos) {
+        int sectionIndex = this.level.getSectionIndex(pos.getY());
+        if (sectionIndex < 0 || sectionIndex >= this.level.getSectionsCount()) {
+            return null;
+        }
+        long packedSectionPos = SectionPos.asLong(pos);
+        LevelChunkSection cached = this.acquiredSections.get(packedSectionPos);
+        final LevelChunkSection result;
+        if (cached == null) {
+            ChunkAccess chunk = this.level.getChunk(SectionPos.blockToSectionCoord(pos.getX()), SectionPos.blockToSectionCoord(pos.getZ()));
+            result = chunk.papoWritableSection(sectionIndex);
+            result.acquire();
+            this.acquiredSections.put(packedSectionPos, result);
+        } else if (cached.papoIsSharedConstant()) {
+            ChunkAccess chunk = this.level.getChunk(SectionPos.blockToSectionCoord(pos.getX()), SectionPos.blockToSectionCoord(pos.getZ()));
+            result = chunk.papoWritableSection(sectionIndex);
+            cached.release();
+            result.acquire();
+            this.acquiredSections.put(packedSectionPos, result);
+        } else {
+            result = cached;
+        }
+        this.lastSection = result;
+        this.lastSectionKey = packedSectionPos;
+        return result;
+    }
+    // Papo end - batch 149 (R9)
