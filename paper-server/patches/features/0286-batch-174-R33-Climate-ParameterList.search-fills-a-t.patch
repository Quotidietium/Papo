From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sun, 11 Oct 2026 12:10:00 +0800
Subject: [PATCH] batch 174 (R33): Climate ParameterList.search fills a
 thread-local long[7] scratch (165-trip toParameterArray face; read-only
 input, no reentrancy) + Beardifier.compute indexed loops (228-trip ListItr
 face; same order same arithmetic)


diff --git a/net/minecraft/world/level/biome/Climate.java b/net/minecraft/world/level/biome/Climate.java
index ab567a57daebe2deac0a1f8dd76e35ae9a5cb3e5..aa8d1e781c0226b4b651fab8afddcd12597175cc 100644
--- a/net/minecraft/world/level/biome/Climate.java
+++ b/net/minecraft/world/level/biome/Climate.java
@@ -384,7 +384,22 @@ public class Climate {
         }
 
         public T search(Climate.TargetPoint targetPoint, Climate.DistanceMetric<T> distanceMetric) {
-            long[] longs = targetPoint.toParameterArray();
+            // Papo start - batch 174 (R33): fill a thread-local scratch instead of
+            // allocating a fresh long[7] per query. The array is a read-only input to
+            // the tree search - never stored, never escaping root.search - and each
+            // thread runs at most one search at a time (the distance metric is pure
+            // arithmetic and never re-enters biome sampling), so overwriting the
+            // scratch per query is unobservable. This is the hottest biome-lookup
+            // allocation (every noise sample of every section fill).
+            final long[] longs = PAP0_SEARCH_SCRATCH.get();
+            longs[0] = targetPoint.temperature();
+            longs[1] = targetPoint.humidity();
+            longs[2] = targetPoint.continentalness();
+            longs[3] = targetPoint.erosion();
+            longs[4] = targetPoint.depth();
+            longs[5] = targetPoint.weirdness();
+            longs[6] = 0L;
+            // Papo end - batch 174 (R33)
             Climate.RTree.Leaf<T> leaf = this.root.search(longs, this.lastResult.get(), distanceMetric);
             this.lastResult.set(leaf);
             return leaf.value;
@@ -543,6 +558,8 @@ public class Climate {
         }
     }
 
+    private static final ThreadLocal<long[]> PAP0_SEARCH_SCRATCH = ThreadLocal.withInitial(() -> new long[7]); // Papo - batch 174 (R33)
+
     public record TargetPoint(long temperature, long humidity, long continentalness, long erosion, long depth, long weirdness) {
         @VisibleForTesting
         protected long[] toParameterArray() {
