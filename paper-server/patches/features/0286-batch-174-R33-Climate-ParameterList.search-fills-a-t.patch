+                    final JigsawJunction jigsawJunction = this.junctions.get(junctionIdx);
                     int i6 = i - jigsawJunction.getSourceX();
                     int groundLevelDelta = i1 - jigsawJunction.getSourceGroundY();
                     int max = i2 - jigsawJunction.getSourceZ();
