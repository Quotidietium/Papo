From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Thu, 27 Aug 2026 22:26:51 +0800
Subject: [PATCH] Papo: batch 103 doTick chain split probes (superTick,
 aiStepTouchScan)


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 79c804245c7f41a5a7f062e1c5e01760adde7d84..226deedf9d36f616429dab3c8233cdb03d9cae87 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -796,8 +796,15 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
 
     public void doTick() {
         try {
+            // Papo start - batch 103: doTick chain split probe (super.tick() = entity tick chain;
+            // remainder = player tail: container validity, food, stats, item sync, health/score pushes)
+            final long papoTSuper = io.papermc.paper.util.PapoTickProfile.ENABLED ? System.nanoTime() : 0L;
             if (valid && !this.isSpectator() || !this.touchingUnloadedChunk()) { // Paper - don't tick dead players that are not in the world currently (pending respawn)
                 super.tick();
+                if (io.papermc.paper.util.PapoTickProfile.ENABLED) {
+                    io.papermc.paper.util.PapoTickProfile.add("player.superTick", papoTSuper);
+                }
+                // Papo end - batch 103
                 if (!this.containerMenu.stillValid(this)) {
                     this.closeContainer(org.bukkit.event.inventory.InventoryCloseEvent.Reason.CANT_USE); // Paper - Inventory close reason
                     this.containerMenu = this.inventoryMenu;
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 486546c3db5c9177d974064a8681344a4b741b1f..3bec8f8864cd807a181108c79765dee5393c1fc2 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -500,6 +500,9 @@ public abstract class Player extends Avatar implements ContainerUser {
         this.yHeadRot = this.getYRot();
         this.setSpeed((float)this.getAttributeValue(Attributes.MOVEMENT_SPEED));
         if (this.getHealth() > 0.0F && !this.isSpectator()) {
+            // Papo start - batch 103: touch-scan split probe (fill + XP/touch loop = density-linked
+            // segment of aiStep; per-entity playerTouch dispatch is a polymorphic point and exact)
+            final long papoTScan = io.papermc.paper.util.PapoTickProfile.ENABLED ? System.nanoTime() : 0L;
             AABB aabb;
             if (this.isPassenger() && !this.getVehicle().isRemoved()) {
                 aabb = this.getBoundingBox().minmax(this.getVehicle().getBoundingBox()).inflate(1.0, 0.0, 1.0);
@@ -532,6 +535,10 @@ public abstract class Player extends Avatar implements ContainerUser {
             if (list != null) { // Papo
                 this.touch(Util.getRandom(list, this.random));
             }
+            if (io.papermc.paper.util.PapoTickProfile.ENABLED) {
+                io.papermc.paper.util.PapoTickProfile.add("player.aiStepTouchScan", papoTScan);
+            }
+            // Papo end - batch 103
         }
 
         this.handleShoulderEntities();
