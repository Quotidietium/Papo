+    // Papo start - Optional-free internal path for hot container-click callers (safeTake, doClick).
+    // Identical branching to the public Optional wrapper above; null == Optional.empty().
+    @Nullable
+    ItemStack tryRemoveInternal(int count, int decrement, Player player) {
         if (!this.mayPickup(player)) {
-            return Optional.empty();
+            return null;
         } else if (!this.allowModification(player) && decrement < this.getItem().getCount()) {
-            return Optional.empty();
+            return null;
         } else {
             count = Math.min(count, decrement);
             ItemStack itemStack = this.remove(count);
             if (itemStack.isEmpty()) {
-                return Optional.empty();
+                return null;
             } else {
                 if (this.getItem().isEmpty()) {
                     this.setByPlayer(ItemStack.EMPTY, itemStack);
                 }
 
-                return Optional.of(itemStack);
+                return itemStack;
             }
         }
     }
+    // Papo end
 
     public ItemStack safeTake(int count, int decrement, Player player) {
