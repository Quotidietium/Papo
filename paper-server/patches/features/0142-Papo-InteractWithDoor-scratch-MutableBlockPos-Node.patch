From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 23:33:43 +0800
Subject: [PATCH] Papo InteractWithDoor scratch MutableBlockPos Node


diff --git a/net/minecraft/world/entity/ai/behavior/InteractWithDoor.java b/net/minecraft/world/entity/ai/behavior/InteractWithDoor.java
index df185d375658d765b07648dfb42ea56c84be671e..75a1f604a83c167f0aa8c7bfee07d98e5c26a611 100644
--- a/net/minecraft/world/entity/ai/behavior/InteractWithDoor.java
+++ b/net/minecraft/world/entity/ai/behavior/InteractWithDoor.java
@@ -32,6 +32,10 @@ public class InteractWithDoor {
     public static BehaviorControl<LivingEntity> create() {
         MutableObject<Node> mutableObject = new MutableObject<>();
         MutableInt mutableInt = new MutableInt(0);
+        // Papo - scratch pos for the per-tick getBlockState probes (main thread serial, set-and-read):
+        // only the door interaction branches allocate immutable positions, because GlobalPos.of stores
+        // the pos reference and CraftBlock.at escapes into the EntityInteractEvent.
+        BlockPos.MutableBlockPos papoScratchPos = new BlockPos.MutableBlockPos();
         return BehaviorBuilder.create(
             instance -> instance.group(
                     instance.present(MemoryModuleType.PATH),
@@ -53,9 +57,10 @@ public class InteractWithDoor {
                             mutableObject.setValue(path.getNextNode());
                             Node previousNode = path.getPreviousNode();
                             Node nextNode = path.getNextNode();
-                            BlockPos blockPos = previousNode.asBlockPos();
-                            BlockState blockState = level.getBlockState(blockPos);
+                            papoScratchPos.set(previousNode.x, previousNode.y, previousNode.z); // Papo - scratch (see above)
+                            BlockState blockState = level.getBlockState(papoScratchPos); // Papo - scratch (see above)
                             if (blockState.is(BlockTags.MOB_INTERACTABLE_DOORS, state -> state.getBlock() instanceof DoorBlock)) {
+                                BlockPos blockPos = previousNode.asBlockPos(); // Papo - immutable: escapes into event/GlobalPos
                                 DoorBlock doorBlock = (DoorBlock)blockState.getBlock();
                                 if (!doorBlock.isOpen(blockState)) {
                                     // CraftBukkit start - entities opening doors
@@ -70,9 +75,10 @@ public class InteractWithDoor {
                                 optional = rememberDoorToClose(doorsToClose, optional, level, blockPos);
                             }
 
-                            BlockPos blockPos1 = nextNode.asBlockPos();
-                            BlockState blockState1 = level.getBlockState(blockPos1);
+                            papoScratchPos.set(nextNode.x, nextNode.y, nextNode.z); // Papo - scratch (see above)
+                            BlockState blockState1 = level.getBlockState(papoScratchPos); // Papo - scratch (see above)
                             if (blockState1.is(BlockTags.MOB_INTERACTABLE_DOORS, state -> state.getBlock() instanceof DoorBlock)) {
+                                BlockPos blockPos1 = nextNode.asBlockPos(); // Papo - immutable: escapes into event/GlobalPos
                                 DoorBlock doorBlock1 = (DoorBlock)blockState1.getBlock();
                                 if (!doorBlock1.isOpen(blockState1)) {
                                     // CraftBukkit start - entities opening doors
@@ -113,7 +119,12 @@ public class InteractWithDoor {
         while (iterator.hasNext()) {
             GlobalPos globalPos = iterator.next();
             BlockPos blockPos = globalPos.pos();
-            if ((previous == null || !previous.asBlockPos().equals(blockPos)) && (next == null || !next.asBlockPos().equals(blockPos))) {
+            if (
+                // Papo - Node.asBlockPos().equals(blockPos) is a pure coordinate compare (BlockPos/Vec3i
+                // equals reads x/y/z only): compare the node's fields directly, skip the allocation.
+                (previous == null || previous.x != blockPos.getX() || previous.y != blockPos.getY() || previous.z != blockPos.getZ())
+                    && (next == null || next.x != blockPos.getX() || next.y != blockPos.getY() || next.z != blockPos.getZ())
+            ) {
                 if (isDoorTooFarAway(level, entity, globalPos)) {
                     iterator.remove();
                 } else {
@@ -158,7 +169,9 @@ public class InteractWithDoor {
                     return false;
                 } else {
                     Node nextNode = path.getNextNode();
-                    return pos.equals(previousNode.asBlockPos()) || pos.equals(nextNode.asBlockPos());
+                    // Papo - asBlockPos().equals(pos) is a coordinate-only compare: read fields directly.
+                    return pos.getX() == previousNode.x && pos.getY() == previousNode.y && pos.getZ() == previousNode.z
+                        || pos.getX() == nextNode.x && pos.getY() == nextNode.y && pos.getZ() == nextNode.z;
                 }
             }
         }
