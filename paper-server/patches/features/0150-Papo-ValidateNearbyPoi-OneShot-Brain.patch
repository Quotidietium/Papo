@@ -206,6 +206,16 @@ public class Brain<E extends LivingEntity> {
         return optional == null ? null : (Optional<U>) optional.map(ExpirableValue::getValue);
     }
 
+    // Papo start - raw nullable read for hot behavior paths: identical to getMemoryInternal except
+    // the value is returned unwrapped, so a present memory does not allocate the result Optional.
+    // Same unchecked cast as getMemory/getMemoryInternal above (memories map is type-keyed by construction).
+    @SuppressWarnings("unchecked")
+    public <U> @Nullable U papoGetMemoryInternalRaw(MemoryModuleType<U> type) {
+        Optional<? extends ExpirableValue<?>> optional = this.memories.get(type);
+        return optional != null && optional.isPresent() ? (U) optional.get().getValue() : null;
+    }
+    // Papo end
+
     public <U> long getTimeUntilExpiry(MemoryModuleType<U> memoryType) {
         Optional<? extends ExpirableValue<?>> optional = this.memories.get(memoryType);
         return optional.map(ExpirableValue::getTimeToLive).orElse(0L);
