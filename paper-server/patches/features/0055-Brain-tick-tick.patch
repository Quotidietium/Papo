Brain.tick 对每个有 brain 的生物每激活 tick 运行。将三层循环内联进
tickEachRunningBehavior，而非每次把 RUNNING 行为收集进新 ObjectArrayList。
废弃的 getRunningBehaviors() 调试 API 保留不变。

diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index a8b076d95ca7bbdbdb6f32bd464cf77d9894dcba..9db393ee30d72e561846cfbf93a426d80dd21913 100644
--- a/net/minecraft/world/entity/ai/Brain.java
+++ b/net/minecraft/world/entity/ai/Brain.java
@@ -457,10 +457,18 @@ public class Brain<E extends LivingEntity> {
 
     private void tickEachRunningBehavior(ServerLevel level, E entity) {
         long gameTime = level.getGameTime();
-
-        for (BehaviorControl<? super E> behaviorControl : this.getRunningBehaviors()) {
-            behaviorControl.tickOrStop(level, entity, gameTime);
+        // Papo start - tick RUNNING behaviors in place instead of collecting them into a
+        // fresh ObjectArrayList every tick (Brain.tick runs for every brain mob every tick).
+        for (Map<Activity, Set<BehaviorControl<? super E>>> map : this.availableBehaviorsByPriority.values()) {
+            for (Set<BehaviorControl<? super E>> set : map.values()) {
+                for (BehaviorControl<? super E> behaviorControl : set) {
+                    if (behaviorControl.getStatus() == Behavior.Status.RUNNING) {
+                        behaviorControl.tickOrStop(level, entity, gameTime);
+                    }
+                }
+            }
         }
+        // Papo end
     }
 
     private boolean activityRequirementsAreMet(Activity activity) {
