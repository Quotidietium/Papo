                     org.bukkit.inventory.InventoryView inventory = this.player.containerMenu.getBukkitView();
+
+                    // Papo start - zero-listener fast path: CraftItemEvent/SmithItemEvent/
+                    // CartographyItemEvent declare no own getHandlerList, so all click events
+                    // share InventoryClickEvent's single HandlerList. With zero listeners the
+                    // event cannot be observed. The mapping switch (:3109-3318) is pure
+                    // click/action computation EXCEPT its QUICK_CRAFT case (Paper drag fix +
+                    // unconditional clicked() at :3302), which is replicated verbatim below for
+                    // that click type. For other click types the observable outcomes of the
+                    // skipped block are exactly: (1) containerMenu.clicked unless cancelled
+                    // (cancelled == isSpectator, set at :3057 and never reassigned);
+                    // (2) sendAllDataToRemote when the event would have been a CraftItemEvent
+                    // (slotNum==0, crafting top, recipe present) or SmithItemEvent (slotNum==3,
+                    // smithing top, result present); (3) no menu change is possible without a
+                    // listener.
+                    if (InventoryClickEvent.getHandlerList().getRegisteredListeners().length == 0) {
+                        if (packet.clickType() == net.minecraft.world.inventory.ClickType.QUICK_CRAFT) {
+                            // verbatim copy of the switch's QUICK_CRAFT case (Paper - Fix CraftBukkit drag system)
+                            net.minecraft.world.inventory.AbstractContainerMenu containerMenu = this.player.containerMenu;
+                            int currentStatus = this.player.containerMenu.quickcraftStatus;
+                            int newStatus = net.minecraft.world.inventory.AbstractContainerMenu.getQuickcraftHeader(packet.buttonNum());
+                            if ((currentStatus != 1 || newStatus != 2 && currentStatus != newStatus)) {
+                            } else if (containerMenu.getCarried().isEmpty()) {
+                            } else if (newStatus == 0) {
+                            } else if (newStatus == 1) {
+                            } else if (newStatus == 2) {
+                                if (!this.player.containerMenu.quickcraftSlots.isEmpty()) {
+                                    if (this.player.containerMenu.quickcraftSlots.size() == 1) {
+                                        int index = containerMenu.quickcraftSlots.iterator().next().index;
+                                        containerMenu.resetQuickCraft();
+                                        this.handleContainerClick(new ServerboundContainerClickPacket(packet.containerId(), packet.stateId(), (short) index, (byte) containerMenu.quickcraftType, net.minecraft.world.inventory.ClickType.PICKUP, packet.changedSlots(), packet.carriedItem()));
+                                        return;
+                                    }
+                                }
+                            }
+                            this.player.containerMenu.clicked(slotNum, packet.buttonNum(), packet.clickType(), this.player);
+                        } else {
+                            if (!cancelled) { // setCancelled(false) -> getResult() != DENY
+                                this.player.containerMenu.clicked(slotNum, packet.buttonNum(), packet.clickType(), this.player);
+                            }
+
+                            org.bukkit.inventory.Inventory papoTop = inventory.getTopInventory();
+                            if (slotNum == 0 && papoTop instanceof org.bukkit.inventory.CraftingInventory papoCrafting && papoCrafting.getRecipe() != null
+                                || slotNum == 3 && papoTop instanceof org.bukkit.inventory.SmithingInventory papoSmithing && papoSmithing.getResult() != null) {
+                                this.player.containerMenu.sendAllDataToRemote();
+                            }
+                        }
+                    } else {
                     SlotType type = inventory.getSlotType(slotNum);
 
                     InventoryClickEvent event;
