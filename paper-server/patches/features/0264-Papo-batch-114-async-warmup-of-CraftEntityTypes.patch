From 880af8cbb53ff4d8e06d0edb80b63343559ef540 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sun, 30 Aug 2026 01:43:30 +0800
Subject: [PATCH] Papo: batch 114 async warm-up of CraftEntityTypes class-init
 at boot end (first-join main-thread freeze fix, jstack-proven root cause)

---
 .../server/dedicated/DedicatedServer.java     | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index eb06d8f0..de27d048 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -390,6 +390,28 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
                 LOGGER.info("JMX monitoring enabled");
             }
 
+            // Papo start - batch 114: async warm-up of cold-class-init hotspots hit by the first join
+            // First-join stall root causes (jstack-proven, batch 114, reproducible 3/3):
+            //  1. the first entity NBT load of a boot hits Entity.getBukkitEntity ->
+            //     CraftEntityTypes.<clinit>, defining hundreds of entity-adapter classes on the
+            //     main thread inside a between-tick pollTask chunk callback (0.6-0.8s freeze);
+            //  2. the first ServerPlayer construction hits HashOps.<clinit> -> guava
+            //     Hashing$Crc32CSupplier.<clinit> (a Class.forName intrinsic probe) plus its
+            //     follow-on cold classes, inside runAllTasksAtTickStart (~0.2s).
+            // Warming both here on a background thread moves the cost into the boot window where
+            // no ticks are running. Equivalence: these <clinit>s only build static lookup state /
+            // probe intrinsics (no events, no world state, no packets); JVM init-lock semantics
+            // guarantee single execution, so observable behavior is unchanged - the first join
+            // simply stops paying the class-load cost on the main thread.
+            java.util.concurrent.CompletableFuture.runAsync(() -> {
+                try {
+                    Class.forName("org.bukkit.craftbukkit.entity.CraftEntityTypes");
+                    Class.forName("net.minecraft.util.HashOps");
+                } catch (final ClassNotFoundException ignored) {
+                }
+            });
+            // Papo end - batch 114
+
             this.notificationManager().serverStarted();
             return true;
         }
