+    // Papo start - batch 99: two-target bounded push-scan fill. Mirrors getEntitiesLimited but stops only
+    // when BOTH consumers of LivingEntity.pushEntities have their needs satisfied: the list prefix holds
+    // at least listTarget entities (push loop consumes at most maxEntityCollisions in order) AND at least
+    // npTarget non-passengers have been seen (cramming check only needs nonPassengerCount > cramming-1).
+    // Returns the updated running non-passenger count; callers re-check the stop condition across chunks.
+    public int papoGetEntitiesBounded(final Entity except, final AABB box, final List<Entity> into, final Predicate<? super Entity> predicate,
+                                      final int listTarget, final int npTarget, final int npRunning) {
+        return this.allEntities.papoGetEntitiesBounded(except, box, into, predicate, listTarget, npTarget, npRunning);
+    }
+    // Papo end - batch 99
