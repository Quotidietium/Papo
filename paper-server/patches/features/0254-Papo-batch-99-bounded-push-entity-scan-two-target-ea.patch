@@ -603,6 +603,57 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
         }
     }
 
+    // Papo start - batch 99: two-target bounded fill for LivingEntity.pushEntities (dense-cluster O(density)
+    // scans collapse to O(max(push cap, cramming threshold))). Mirrors getEntities above; stops iterating
+    // chunks once into.size() >= listTarget && nonPassengers >= npTarget. Result is an order-preserving
+    // prefix of the unbounded fill, which is everything the push/cramming consumers observe.
+    public void papoGetEntitiesBounded(final Entity except, final AABB box, final List<Entity> into, final Predicate<? super Entity> predicate,
+                                       final int listTarget, final int npTarget) {
+        final int minChunkX = (Mth.floor(box.minX) - 2) >> 4;
+        final int minChunkZ = (Mth.floor(box.minZ) - 2) >> 4;
+        final int maxChunkX = (Mth.floor(box.maxX) + 2) >> 4;
+        final int maxChunkZ = (Mth.floor(box.maxZ) + 2) >> 4;
+
+        final int minRegionX = minChunkX >> REGION_SHIFT;
+        final int minRegionZ = minChunkZ >> REGION_SHIFT;
+        final int maxRegionX = maxChunkX >> REGION_SHIFT;
+        final int maxRegionZ = maxChunkZ >> REGION_SHIFT;
+
+        int npRunning = 0;
+
+        outer:
+        for (int currRegionZ = minRegionZ; currRegionZ <= maxRegionZ; ++currRegionZ) {
+            final int minZ = currRegionZ == minRegionZ ? minChunkZ & REGION_MASK : 0;
+            final int maxZ = currRegionZ == maxRegionZ ? maxChunkZ & REGION_MASK : REGION_MASK;
+
+            for (int currRegionX = minRegionX; currRegionX <= maxRegionX; ++currRegionX) {
+                final ChunkSlicesRegion region = this.getRegion(currRegionX, currRegionZ);
+
+                if (region == null) {
+                    continue;
+                }
+
+                final int minX = currRegionX == minRegionX ? minChunkX & REGION_MASK : 0;
+                final int maxX = currRegionX == maxRegionX ? maxChunkX & REGION_MASK : REGION_MASK;
+
+                for (int currZ = minZ; currZ <= maxZ; ++currZ) {
+                    for (int currX = minX; currX <= maxX; ++currX) {
+                        final ChunkEntitySlices chunk = region.get(currX | (currZ << REGION_SHIFT));
+                        if (chunk == null || !chunk.status.isOrAfter(FullChunkStatus.FULL)) {
+                            continue;
+                        }
+
+                        npRunning = chunk.papoGetEntitiesBounded(except, box, into, predicate, listTarget, npTarget, npRunning);
+                        if (into.size() >= listTarget && npRunning >= npTarget) {
+                            break outer;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // Papo end - batch 99
+
