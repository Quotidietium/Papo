From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 22:13:46 +0800
Subject: [PATCH] PlayerMoveEvent from to Location handleMovePlayer ha


diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 65ca8537d9f7f30bebf8457a69cf37b1315b04b7..32ac21f0b4a5b550100c187eeb56dcaf6600fc54 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -676,14 +676,20 @@ public class ServerGamePacketListenerImpl
                     this.lastPitch = prevPitch;
                     this.hasMoved = true;
                 }
-                Location from = new Location(player.getWorld(), this.lastPosX, this.lastPosY, this.lastPosZ, this.lastYaw, this.lastPitch); // Get the Players previous Event location.
-                Location to = CraftLocation.toBukkit(packet.position(), player.getWorld(), packet.yRot(), packet.xRot());
+                // Papo start - compute the scalar to-values first and only allocate the two Locations
+                // when the movement threshold below is actually passed (most vehicle move packets are
+                // filtered by it); the event Location contents are exactly the raw packet values
+                // (CraftLocation.toBukkit performs no normalization).
+                Vec3 papoPacketPos = packet.position();
 
                 // Prevent 40 event-calls for less than a single pixel of movement >.>
-                double delta = Mth.square(this.lastPosX - to.getX()) + Mth.square(this.lastPosY - to.getY()) + Mth.square(this.lastPosZ - to.getZ());
-                float deltaAngle = Math.abs(this.lastYaw - to.getYaw()) + Math.abs(this.lastPitch - to.getPitch());
+                double delta = Mth.square(this.lastPosX - papoPacketPos.x()) + Mth.square(this.lastPosY - papoPacketPos.y()) + Mth.square(this.lastPosZ - papoPacketPos.z());
+                float deltaAngle = Math.abs(this.lastYaw - packet.yRot()) + Math.abs(this.lastPitch - packet.xRot());
 
                 if ((delta > 1f / 256 || deltaAngle > 10f) && !this.player.isImmobile()) {
+                    Location from = new Location(player.getWorld(), this.lastPosX, this.lastPosY, this.lastPosZ, this.lastYaw, this.lastPitch); // Get the Players previous Event location.
+                    Location to = CraftLocation.toBukkit(papoPacketPos, player.getWorld(), packet.yRot(), packet.xRot());
+                    // Papo end
                     this.lastPosX = to.getX();
                     this.lastPosY = to.getY();
                     this.lastPosZ = to.getZ();
@@ -1657,27 +1663,32 @@ public class ServerGamePacketListenerImpl
                                         this.lastPitch = prevPitch;
                                         this.hasMoved = true;
                                     }
-                                    Location from = new Location(player.getWorld(), this.lastPosX, this.lastPosY, this.lastPosZ, this.lastYaw, this.lastPitch); // Get the Players previous Event location.
-                                    Location to = player.getLocation().clone(); // Start off the To location as the Players current location.
-
-                                    // If the packet contains movement information then we update the To location with the correct XYZ.
-                                    if (packet.hasPos) {
-                                        to.setX(packet.x);
-                                        to.setY(packet.y);
-                                        to.setZ(packet.z);
-                                    }
-
-                                    // If the packet contains look information then we update the To location with the correct Yaw & Pitch.
-                                    if (packet.hasRot) {
-                                        to.setYaw(packet.yRot);
-                                        to.setPitch(packet.xRot);
-                                    }
+                                    // Papo start - compute the scalar to-values first and only allocate the two
+                                    // Locations when the movement threshold below is actually passed (most move
+                                    // packets are filtered by it). The non-packet components replicate exactly what
+                                    // the absSnapTo(...) above stores and getLocation() would read back: x/z clamped
+                                    // to +-3.0E7 (y unclamped), yaw % 360, pitch clamped to +-90 then % 360
+                                    // (Entity.absSnapTo/absSnapRotationTo; yRot is always finite via guarded
+                                    // setters). getWorld() is the same reference getLocation() uses
+                                    // (CraftEntity.getWorld), and nothing between the snap and this point mutates
+                                    // the player position, so the lazily built Locations below are identical to
+                                    // the old getLocation().clone() + setX/setY/... sequence.
+                                    double papoToX = packet.hasPos ? packet.x : Mth.clamp(prevX, -3.0E7, 3.0E7);
+                                    double papoToY = packet.hasPos ? packet.y : prevY;
+                                    double papoToZ = packet.hasPos ? packet.z : Mth.clamp(prevZ, -3.0E7, 3.0E7);
+                                    float papoToYaw = packet.hasRot ? packet.yRot : prevYaw % 360.0F;
+                                    float papoToPitch = packet.hasRot ? packet.xRot : Mth.clamp(prevPitch, -90.0F, 90.0F) % 360.0F;
+                                    // Papo end
 
                                     // Prevent 40 event-calls for less than a single pixel of movement >.>
-                                    double delta = Mth.square(this.lastPosX - to.getX()) + Mth.square(this.lastPosY - to.getY()) + Mth.square(this.lastPosZ - to.getZ());
-                                    float deltaAngle = Math.abs(this.lastYaw - to.getYaw()) + Math.abs(this.lastPitch - to.getPitch());
+                                    double delta = Mth.square(this.lastPosX - papoToX) + Mth.square(this.lastPosY - papoToY) + Mth.square(this.lastPosZ - papoToZ); // Papo - scalars (see above)
+                                    float deltaAngle = Math.abs(this.lastYaw - papoToYaw) + Math.abs(this.lastPitch - papoToPitch); // Papo - scalars (see above)
 
                                     if ((delta > 1f / 256 || deltaAngle > 10f) && !this.player.isImmobile()) {
+                                        // Papo start - allocate the Locations only now (see above)
+                                        Location from = new Location(player.getWorld(), this.lastPosX, this.lastPosY, this.lastPosZ, this.lastYaw, this.lastPitch); // Get the Players previous Event location.
+                                        Location to = new Location(player.getWorld(), papoToX, papoToY, papoToZ, papoToYaw, papoToPitch); // Start off the To location as the Players current location.
+                                        // Papo end
                                         this.lastPosX = to.getX();
                                         this.lastPosY = to.getY();
                                         this.lastPosZ = to.getZ();
