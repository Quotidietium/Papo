     public PathType getPathType(PathfindingContext context, int x, int y, int z) {
         PathType pathTypeFromState = context.getPathTypeFromState(x, y, z);
         if (pathTypeFromState == PathType.OPEN && y >= context.level().getMinY() + 1) {
-            BlockPos blockPos = new BlockPos(x, y - 1, z);
-            PathType pathTypeFromState1 = context.getPathTypeFromState(blockPos.getX(), blockPos.getY(), blockPos.getZ());
+            // Papo start - avoid BlockPos allocation: the pos below would be (x, y-1, z) by construction
+            // and is only decomposed back to coordinates plus one BlockPos.equals against mobPosition()
+            // (Vec3i.equals compares x/y/z; a fresh pos is never reference-equal to the stored mob pos),
+            // so compare coordinates directly instead of materializing the BlockPos.
+            PathType pathTypeFromState1 = context.getPathTypeFromState(x, y - 1, z);
+            // Papo end
             if (pathTypeFromState1 == PathType.DAMAGE_FIRE || pathTypeFromState1 == PathType.LAVA) {
