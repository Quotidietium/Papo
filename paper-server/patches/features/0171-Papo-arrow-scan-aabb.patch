diff --git a/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java b/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
index 224471668b3a064fb7d45cc913364b0efd94b41c..54db956a3b37f51626b95d17d10e91d61320df7f 100644
--- a/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
+++ b/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
@@ -607,13 +607,30 @@ public abstract class AbstractArrow extends Projectile {
 
     protected @Nullable EntityHitResult findHitEntity(Vec3 startVec, Vec3 endVec) {
         return ProjectileUtil.getEntityHitResult(
-            this.level(), this, startVec, endVec, this.getBoundingBox().expandTowards(this.getDeltaMovement()).inflate(1.0), this.papoCanHitPredicate
+            this.level(), this, startVec, endVec, this.papoExpandedScanBox(), this.papoCanHitPredicate
         );
     }
 
     protected Collection<EntityHitResult> findHitEntities(Vec3 startVec, Vec3 endVec) {
         return ProjectileUtil.getManyEntityHitResult(
-            this.level(), this, startVec, endVec, this.getBoundingBox().expandTowards(this.getDeltaMovement()).inflate(1.0), this.papoCanHitPredicate, false
+            this.level(), this, startVec, endVec, this.papoExpandedScanBox(), this.papoCanHitPredicate, false
+        );
+    }
+
+    // Papo - one-AABB equivalent of getBoundingBox().expandTowards(getDeltaMovement()).inflate(1.0);
+    // same transform as ProjectileUtil.getHitResult (0167): per-axis min' = (min + (dm<0?dm:0)) - 1,
+    // max' = (max + (dm>0?dm:0)) + 1; ternaries keep NaN delta movement identical to the branchy chain,
+    // left-associative FP order preserved, ctor normalization sees identical inputs.
+    private net.minecraft.world.phys.AABB papoExpandedScanBox() {
+        net.minecraft.world.phys.AABB bb = this.getBoundingBox();
+        net.minecraft.world.phys.Vec3 dm = this.getDeltaMovement();
+        return new net.minecraft.world.phys.AABB(
+            bb.minX + (dm.x < 0.0 ? dm.x : 0.0) - 1.0,
+            bb.minY + (dm.y < 0.0 ? dm.y : 0.0) - 1.0,
+            bb.minZ + (dm.z < 0.0 ? dm.z : 0.0) - 1.0,
+            bb.maxX + (dm.x > 0.0 ? dm.x : 0.0) + 1.0,
+            bb.maxY + (dm.y > 0.0 ? dm.y : 0.0) + 1.0,
+            bb.maxZ + (dm.z > 0.0 ? dm.z : 0.0) + 1.0
         );
     }
 
