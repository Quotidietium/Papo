     private void handleMinecartPosRot(NewMinecartBehavior behavior, byte yRot, byte xRot, boolean dirty) {
         this.sendDirtyEntityData();
+        // Papo start - inline the delta Vec3 (same transform as the main path above: a - b is
+        // bit-identical to Vec3.subtract's a + (-b), and lengthSqr() is the same left-to-right
+        // expression tree) and skip packet construction when no viewer tracks this entity (the
+        // base/lastSent* updates below are unchanged)
+        final boolean papoHasViewers = !this.trackedPlayers.isEmpty();
         if (behavior.lerpSteps.isEmpty()) {
             Vec3 deltaMovement = this.entity.getDeltaMovement();
             double d = deltaMovement.distanceToSqr(this.lastSentMovement);
             Vec3 vec3 = this.entity.trackingPosition();
-            boolean flag = this.positionCodec.delta(vec3).lengthSqr() >= 7.6293945E-6F;
+            Vec3 papoBase = this.positionCodec.base;
+            double papoDx = vec3.x - papoBase.x;
+            double papoDy = vec3.y - papoBase.y;
+            double papoDz = vec3.z - papoBase.z;
+            boolean flag = (papoDx * papoDx + papoDy * papoDy + papoDz * papoDz) >= 7.6293945E-6F;
             boolean flag1 = flag || this.tickCount % 60 == 0;
             if (flag1 || dirty || d > 1.0E-7) {
