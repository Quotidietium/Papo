From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Thu, 30 Jul 2026 20:55:39 +0800
Subject: [PATCH] getIncomingWireSignal MutableBlockPos above 12 Block


diff --git a/net/minecraft/world/level/redstone/RedstoneWireEvaluator.java b/net/minecraft/world/level/redstone/RedstoneWireEvaluator.java
index 19edecc980f1d4cf8e210bd6d5e3d7d4e77fdb82..5ea539093e23a436c605bd036537bfe1e251e44b 100644
--- a/net/minecraft/world/level/redstone/RedstoneWireEvaluator.java
+++ b/net/minecraft/world/level/redstone/RedstoneWireEvaluator.java
@@ -28,20 +28,28 @@ public abstract class RedstoneWireEvaluator {
 
     protected int getIncomingWireSignal(Level level, BlockPos pos) {
         int i = 0;
+        // Papo start - reuse one MutableBlockPos and hoist the loop-invariant above pos/state
+        // (12 BlockPos allocations per call -> 0). All consumers (getBlockState, isRedstoneConductor,
+        // getWireSignal) only read the position; the coordinate sequence and evaluation order are unchanged.
+        BlockPos abovePos = pos.above();
+        boolean aboveIsConductor = level.getBlockState(abovePos).isRedstoneConductor(level, abovePos);
+        BlockPos.MutableBlockPos mutable = new BlockPos.MutableBlockPos();
 
         for (Direction direction : HORIZONTAL) { // Papo - cached array
-            BlockPos blockPos = pos.relative(direction);
-            BlockState blockState = level.getBlockState(blockPos);
-            i = Math.max(i, this.getWireSignal(blockPos, blockState));
-            BlockPos blockPos1 = pos.above();
-            if (blockState.isRedstoneConductor(level, blockPos) && !level.getBlockState(blockPos1).isRedstoneConductor(level, blockPos1)) {
-                BlockPos blockPos2 = blockPos.above();
-                i = Math.max(i, this.getWireSignal(blockPos2, level.getBlockState(blockPos2)));
-            } else if (!blockState.isRedstoneConductor(level, blockPos)) {
-                BlockPos blockPos2 = blockPos.below();
-                i = Math.max(i, this.getWireSignal(blockPos2, level.getBlockState(blockPos2)));
+            mutable.setWithOffset(pos, direction);
+            BlockState blockState = level.getBlockState(mutable);
+            i = Math.max(i, this.getWireSignal(mutable, blockState));
+            if (blockState.isRedstoneConductor(level, mutable) && !aboveIsConductor) {
+                mutable.move(Direction.UP);
+                i = Math.max(i, this.getWireSignal(mutable, level.getBlockState(mutable)));
+                mutable.move(Direction.DOWN);
+            } else if (!blockState.isRedstoneConductor(level, mutable)) {
+                mutable.move(Direction.DOWN);
+                i = Math.max(i, this.getWireSignal(mutable, level.getBlockState(mutable)));
+                mutable.move(Direction.UP);
             }
         }
+        // Papo end
 
         return Math.max(0, i - 1);
     }
