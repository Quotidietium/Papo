diff --git a/net/minecraft/world/entity/projectile/Projectile.java b/net/minecraft/world/entity/projectile/Projectile.java
index 6298e6de25f1dd9ff880a9ad2882dc7ccb2f100c..2f147fe5e13e96fe12a3dc3bd3be153ddd2a8979 100644
--- a/net/minecraft/world/entity/projectile/Projectile.java
+++ b/net/minecraft/world/entity/projectile/Projectile.java
@@ -39,6 +39,10 @@ import org.jspecify.annotations.Nullable;
 public abstract class Projectile extends Entity implements TraceableEntity {
     private static final boolean DEFAULT_LEFT_OWNER = false;
     private static final boolean DEFAULT_HAS_BEEN_SHOT = false;
+    // Papo - cache the canHitEntity predicate (same pattern as the Pufferfish lambda caches): a method
+    // reference to a virtual method still dispatches virtually per call, so one shared instance is
+    // behavior-identical to allocating `this::canHitEntity` per tick; consumers never compare identity.
+    protected final java.util.function.Predicate<Entity> papoCanHitPredicate = this::canHitEntity;
     public @Nullable EntityReference<Entity> owner;
     public boolean leftOwner = false;
     private boolean leftOwnerChecked;
