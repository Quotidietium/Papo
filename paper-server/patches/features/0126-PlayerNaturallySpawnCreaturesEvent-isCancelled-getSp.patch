diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index af67b07722bb0125acd081dab767d7e7b360623b..b60e45756eb29c0f6e6bb413c5b6f72cb01fcfc7 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -561,6 +561,18 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
             for (ServerPlayer entityPlayer : this.level.players()) {
                 int chunkRange = Math.min(level.spigotConfig.mobSpawnRange, entityPlayer.getBukkitEntity().getViewDistance());
                 chunkRange = Math.min(chunkRange, 8);
+                // Papo start - zero listeners: the event can never be cancelled and its radius always
+                // equals chunkRange, so reuse the existing instance when it is in exactly that state.
+                // A previously cancelled or radius-modified event (listener registered then unregistered)
+                // fails the check and is rebuilt; readers (ChunkMap) only read isCancelled/getSpawnRadius.
+                if (com.destroystokyo.paper.event.entity.PlayerNaturallySpawnCreaturesEvent.getHandlerList().getRegisteredListeners().length == 0) {
+                    com.destroystokyo.paper.event.entity.PlayerNaturallySpawnCreaturesEvent event = entityPlayer.playerNaturallySpawnedEvent;
+                    if (event == null || event.isCancelled() || event.getSpawnRadius() != (byte) chunkRange) {
+                        entityPlayer.playerNaturallySpawnedEvent = new com.destroystokyo.paper.event.entity.PlayerNaturallySpawnCreaturesEvent(entityPlayer.getBukkitEntity(), (byte) chunkRange);
+                    }
+                    continue;
+                }
+                // Papo end
                 entityPlayer.playerNaturallySpawnedEvent = new com.destroystokyo.paper.event.entity.PlayerNaturallySpawnCreaturesEvent(entityPlayer.getBukkitEntity(), (byte) chunkRange);
                 entityPlayer.playerNaturallySpawnedEvent.callEvent();
             }
