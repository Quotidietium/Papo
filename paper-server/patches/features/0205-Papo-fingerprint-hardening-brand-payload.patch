From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sun, 2 Aug 2026 16:54:40 +0800
Subject: [PATCH] Papo: fingerprint hardening brand payload


diff --git a/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java b/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
index a3645322be006d5501fa7fb8944509a9c6b58e32..202bfa5c6e2196007c3c943c274582f205a59075 100644
--- a/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
@@ -101,7 +101,7 @@ public class ServerConfigurationPacketListenerImpl extends ServerCommonPacketLis
 
     public void startConfiguration() {
         new io.papermc.paper.event.connection.configuration.PlayerConnectionInitialConfigureEvent(this.paperConnection).callEvent(); // Paper
-        this.send(new ClientboundCustomPayloadPacket(new BrandPayload(this.server.getServerModName())));
+        this.send(new ClientboundCustomPayloadPacket(new BrandPayload(papoBrand(this.server)))); // Papo - fingerprint hardening (brand-payload)
         ServerLinks serverLinks = this.server.serverLinks();
         if (!serverLinks.isEmpty()) {
             // Paper start
@@ -125,6 +125,15 @@ public class ServerConfigurationPacketListenerImpl extends ServerCommonPacketLis
         this.returnToWorld();
     }
 
+    // Papo start - fingerprint hardening: resolve brand payload per GlobalConfiguration.fingerprintHardening.brandPayload.
+    // GlobalConfiguration.get() is a static field read (throw-free); null when config not yet loaded.
+    private static String papoBrand(final MinecraftServer server) {
+        final String realBrand = server.getServerModName();
+        final io.papermc.paper.configuration.GlobalConfiguration cfg = io.papermc.paper.configuration.GlobalConfiguration.get();
+        return (cfg != null) ? cfg.fingerprintHardening.brandPayload.resolve(realBrand) : realBrand;
+    }
+    // Papo end - fingerprint hardening
+
     public void returnToWorld() {
         this.prepareSpawnTask = new PrepareSpawnTask(this.server, this.gameProfile, this); // Paper - pass full GameProfile & listener for events
         this.configurationTasks.add(this.prepareSpawnTask);
