+    // Papo start - batch 187 (R46): cheap emptiness probe backing the hopper empty-query
+    // fast path (see EntityLookup#papoHasNoEntitiesIn). Mirrors the exact section range the
+    // real query would read (EntityCollectionBySection.getEntities: minY-2 / maxY+2, clamped
+    // to this chunk's sections) and answers "no entity is registered in any of those sections".
+    // allEntities is maintained for every entity regardless of the lazily created class/type
+    // collections (see addEntity/initClass), so a null section list there implies the same for
+    // every class/type-specific collection, which in turn implies any getEntities(...) visit
+    // restricted to that section range is a no-op. Section granularity (not chunk-total count)
+    // matters: players/mobs routinely share the chunk column of a hopper farm at other heights.
+    public boolean papoHasNoEntitiesInSections(final AABB box) {
+        final EntityCollectionBySection all = this.allEntities;
+        if (all.count == 0) {
+            return true;
+        }
+        final int min = Mth.clamp(Mth.floor(box.minY - 2.0) >> 4, this.minSection, this.maxSection);
+        final int max = Mth.clamp(Mth.floor(box.maxY + 2.0) >> 4, this.minSection, this.maxSection);
+        final BasicEntityList<Entity>[] bySection = all.entitiesBySection;
+        for (int section = min; section <= max; ++section) {
+            if (bySection[section - this.minSection] != null) {
+                return false;
+            }
+        }
+        return true;
+    }
+    // Papo end
+
