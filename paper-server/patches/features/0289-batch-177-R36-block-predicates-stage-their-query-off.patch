diff --git a/net/minecraft/world/level/levelgen/blockpredicates/PapoPredicateScratch.java b/net/minecraft/world/level/levelgen/blockpredicates/PapoPredicateScratch.java
new file mode 100644
index 0000000000000000000000000000000000000000..8abcc73fbc406ad83d1bad41149667b98176e7ae
--- /dev/null
+++ b/net/minecraft/world/level/levelgen/blockpredicates/PapoPredicateScratch.java
@@ -0,0 +1,34 @@
+package net.minecraft.world.level.levelgen.blockpredicates;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Vec3i;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.block.state.BlockState;
+
+// Papo start - batch 177 (R36): block predicates allocate a fresh BlockPos via
+// pos.offset(this.offset) on every test (StateTestingPredicate 116 census trips +
+// HasSturdyFacePredicate 18 - predicates run per candidate position of every
+// predicate-gated feature placement). The offset coordinate is instead staged in a
+// thread-local mutable and handed straight to the block query - Level/BlockGetter
+// implementations read x/y/z only and never retain the position (vanilla feature
+// loops pass their own mutables into these same queries), so reusing the scratch is
+// unobservable. Reentrancy is impossible: every use is a set-then-query pair that
+// completes before any other predicate can run on this thread.
+final class PapoPredicateScratch {
+    private static final ThreadLocal<BlockPos.MutableBlockPos> SCRATCH = ThreadLocal.withInitial(BlockPos.MutableBlockPos::new);
+
+    private PapoPredicateScratch() {
+    }
+
+    static BlockState offsetBlockState(BlockGetter level, BlockPos pos, Vec3i offset) {
+        BlockPos blockPos = offset(pos, offset);
+        return level.getBlockState(blockPos);
+    }
+
+    static BlockPos offset(BlockPos pos, Vec3i offset) {
+        BlockPos.MutableBlockPos scratch = SCRATCH.get();
+        scratch.set(pos.getX() + offset.getX(), pos.getY() + offset.getY(), pos.getZ() + offset.getZ());
+        return scratch;
+    }
+}
+// Papo end - batch 177 (R36)
