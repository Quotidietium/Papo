+++ b/net/minecraft/world/level/levelgen/blockpredicates/StateTestingPredicate.java
@@ -21,7 +21,11 @@ public abstract class StateTestingPredicate implements BlockPredicate {
 
     @Override
     public final boolean test(WorldGenLevel level, BlockPos pos) {
-        return this.test(level.getBlockState(pos.offset(this.offset)));
+        // Papo start - batch 177 (R36): stage the offset in a thread-local mutable
+        // instead of allocating pos.offset(this.offset) on every predicate test
+        // (116 census trips - predicates run per candidate position)
+        return this.test(PapoPredicateScratch.offsetBlockState(level, pos, this.offset));
+        // Papo end - batch 177 (R36)
     }
 
     protected abstract boolean test(BlockState state);
