diff --git a/net/minecraft/network/PapoOutboundFraming.java b/net/minecraft/network/PapoOutboundFraming.java
new file mode 100644
index 0000000000000000000000000000000000000000..cff46094892594d3138bd948ba61d80dc491b974
--- /dev/null
+++ b/net/minecraft/network/PapoOutboundFraming.java
@@ -0,0 +1,53 @@
+package net.minecraft.network;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.util.AttributeKey;
+
+/**
+ * Papo - zero-copy outbound framing.
+ *
+ * Outbound bytes are produced in three stages (packet encode, optional compression, length framing),
+ * and the framing stage historically copied the entire payload into a fresh buffer just to prepend the
+ * frame-length varint; the below-threshold compression path added another full copy. With a reserved
+ * prefix ("headroom", {@link #HEADROOM} bytes) allocated once at packet-encode time, every stage can
+ * work in place: the compression stage writes its data-length varint into the headroom (below threshold)
+ * or produces its own headroom buffer (compressed), and the prepender writes the frame-length varint
+ * right-aligned into the remaining headroom and passes the buffer through unmodified.
+ *
+ * Handoff between stages uses a per-channel attribute holding the identity of the buffer that currently
+ * carries headroom. All three stages run on the channel's single event loop thread, in pipeline order,
+ * so the attribute is set and consumed within one write traversal - no synchronization needed. Any
+ * buffer that does not identity-match (foreign ByteBuf injected by a plugin, stale marker) falls back to
+ * the original copy path, so the fast path is purely an internal allocation/copying optimization and the
+ * emitted byte stream is identical.
+ */
+final class PapoOutboundFraming {
+    /** Max varint21 size of the frame length + max varint size of the (un)compressed data length prefix. */
+    static final int HEADROOM = Varint21LengthFieldPrepender.MAX_VARINT21_BYTES + 3;
+
+    /** Identity of the buffer currently carrying {@link #HEADROOM} bytes of reserved prefix space. */
+    static final AttributeKey<ByteBuf> HEADROOM_BUF = AttributeKey.valueOf("papo.outboundHeadroomBuf");
+
+    private PapoOutboundFraming() {
+    }
+
+    /**
+     * Writes {@code value}'s varint encoding right-aligned immediately before {@code buf}'s readerIndex
+     * (into reserved headroom) and rewinds the readerIndex. Byte emission is identical to
+     * {@link VarInt#write} - least significant group first, continuation bit on all but the last byte -
+     * verified by round-trip in the batch 59 benchmark self-check.
+     */
+    static void writeVarIntBackwards(ByteBuf buf, int value) {
+        int size = VarInt.getByteSize(value);
+        int end = buf.readerIndex();
+        int index = end - size;
+        int shift = 0;
+        int last = size * 7;
+        while (shift < last) {
+            int b = value >>> shift & 0x7F;
+            shift += 7;
+            buf.setByte(index++, shift < last ? b | 0x80 : b);
+        }
+        buf.readerIndex(end - size);
+    }
+}
