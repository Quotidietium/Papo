 import io.netty.handler.codec.MessageToByteEncoder;
 import java.util.zip.Deflater;
 
@@ -29,6 +30,72 @@ public class CompressionEncoder extends MessageToByteEncoder<ByteBuf> {
         // Paper end - Use Velocity cipher
     }
 
+    // Papo start - zero-copy outbound framing
+    // When the incoming buffer identity-matches the headroom marker published by PacketEncoder, run the
+    // zero-copy path: below threshold the data-length varint (a single 0 byte) is written into the
+    // reserved prefix and the buffer passes through untouched (no allocation, no payload copy); at or
+    // above threshold a headroom-reserved output buffer is produced and the (unchanged) compressed
+    // framing is written in place. Any other buffer (or a stale marker) falls back to the copy-based
+    // encode below, so emitted bytes and reference-counting totals are identical either way.
+    //
+    // Reference-counting: papoEncodeHeadroom owns its input on every path - transferred downstream via
+    // ctx.write (netty's invokeWrite0 releases the message itself on a synchronous downstream failure,
+    // so ctx.write never throws the buffer back), or released exactly once in the finally. The outer
+    // write() therefore must NOT release on catch (the finally already did).
+    @Override
+    public void write(ChannelHandlerContext ctx, Object msg, ChannelPromise promise) throws Exception {
+        if (msg instanceof ByteBuf papoBuf && papoBuf == ctx.channel().attr(PapoOutboundFraming.HEADROOM_BUF).get()) {
+            ctx.channel().attr(PapoOutboundFraming.HEADROOM_BUF).set(null);
+            this.papoEncodeHeadroom(ctx, papoBuf, promise);
+            return;
+        }
+        ctx.channel().attr(PapoOutboundFraming.HEADROOM_BUF).set(null); // foreign buffer: drop any stale marker
+        super.write(ctx, msg, promise);
+    }
+
+    private void papoEncodeHeadroom(ChannelHandlerContext ctx, ByteBuf in, ChannelPromise promise) throws Exception {
+        boolean papoConsumed = false; // input ownership left this method (or is dead) - skip the finally release
+        try {
+            int i = in.readableBytes();
+            if (i > 8388608) {
+                throw new IllegalArgumentException("Packet too big (is " + i + ", should be less than 8388608)");
+            }
+            if (i < this.threshold) {
+                in.setByte(PapoOutboundFraming.HEADROOM - 1, 0); // data-length varint of an uncompressed packet: one 0 byte
+                in.readerIndex(PapoOutboundFraming.HEADROOM - 1);
+                ctx.channel().attr(PapoOutboundFraming.HEADROOM_BUF).set(in); // re-publish for the prepender
+                papoConsumed = true; // set before ctx.write: if the call ever failed after taking the buffer, prefer a leak over a double release
+                ctx.write(in, promise);
+                return;
+            }
+
+            final ByteBuf out = com.velocitypowered.natives.util.MoreByteBufUtils.preferredBuffer(
+                ctx.alloc(), this.compressor, PapoOutboundFraming.HEADROOM + i + (i >>> 11) + 32);
+            try {
+                out.setIndex(PapoOutboundFraming.HEADROOM, PapoOutboundFraming.HEADROOM);
+                VarInt.write(out, i);
+                final ByteBuf compatibleIn = com.velocitypowered.natives.util.MoreByteBufUtils.ensureCompatible(ctx.alloc(), this.compressor, in);
+                try {
+                    this.compressor.deflate(compatibleIn, out);
+                } finally {
+                    compatibleIn.release();
+                }
+            } catch (Exception e) {
+                out.release(); // not yet published - release on failure (outer finally still releases `in`)
+                throw e;
+            }
+            in.release(); // consumed by compression; neither release below can throw from here on
+            papoConsumed = true;
+            ctx.channel().attr(PapoOutboundFraming.HEADROOM_BUF).set(out); // publish for the prepender
+            ctx.write(out, promise);
+        } finally {
+            if (!papoConsumed) {
+                in.release();
+            }
+        }
+    }
+    // Papo end
+
     @Override
     protected void encode(ChannelHandlerContext ctx, ByteBuf encodingByteBuf, ByteBuf byteBuf) throws Exception { // Paper - Use Velocity cipher
         int i = encodingByteBuf.readableBytes();
