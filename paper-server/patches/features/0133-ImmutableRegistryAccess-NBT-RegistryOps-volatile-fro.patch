Subject: [PATCH] ImmutableRegistryAccess NBT RegistryOps volatile fro


diff --git a/net/minecraft/core/RegistryAccess.java b/net/minecraft/core/RegistryAccess.java
index 8341ac329c71352015cce2e53d0138be30287cff..9a3bf5de4eeed933d3c5ddbd19f1306a51a28d83 100644
--- a/net/minecraft/core/RegistryAccess.java
+++ b/net/minecraft/core/RegistryAccess.java
@@ -65,6 +65,22 @@ public interface RegistryAccess extends HolderLookup.Provider {
 
     public static class ImmutableRegistryAccess implements RegistryAccess {
         private final Map<? extends ResourceKey<? extends Registry<?>>, ? extends Registry<?>> registries;
+        // Papo start - cached RegistryOps for the NBT serialization context (ByteBufCodecs hot path):
+        // the registries of an ImmutableRegistryAccess never change and a RegistryOps only captures
+        // this access, so it can be created once and shared. Thread-safe: RegistryOps.HolderLookupAdapter's
+        // lookup cache is a ConcurrentHashMap, NbtOps is stateless, and a benign race at first use just
+        // builds the same (equals-equal) ops twice.
+        private volatile net.minecraft.resources.RegistryOps<net.minecraft.nbt.Tag> papoNbtOps;
+
+        public net.minecraft.resources.RegistryOps<net.minecraft.nbt.Tag> papoNbtSerializationContext() {
+            net.minecraft.resources.RegistryOps<net.minecraft.nbt.Tag> ops = this.papoNbtOps;
+            if (ops == null) {
+                ops = this.createSerializationContext(net.minecraft.nbt.NbtOps.INSTANCE);
+                this.papoNbtOps = ops;
+            }
+            return ops;
+        }
+        // Papo end
 
         public ImmutableRegistryAccess(List<? extends Registry<?>> registries) {
             this.registries = registries.stream().collect(Collectors.toUnmodifiableMap(Registry::key, registry -> registry));
diff --git a/net/minecraft/network/codec/ByteBufCodecs.java b/net/minecraft/network/codec/ByteBufCodecs.java
index 2f38f7b369ef3d72be03eca602373f34eb6c6a4a..def2d4cb6e3059a17ca0d9dd02759c35f0463607 100644
--- a/net/minecraft/network/codec/ByteBufCodecs.java
+++ b/net/minecraft/network/codec/ByteBufCodecs.java
@@ -30,6 +30,7 @@ import net.minecraft.core.Holder;
 import net.minecraft.core.HolderSet;
 import net.minecraft.core.IdMap;
 import net.minecraft.core.Registry;
+import net.minecraft.core.RegistryAccess;
 import net.minecraft.core.UUIDUtil;
 import net.minecraft.nbt.CompoundTag;
 import net.minecraft.nbt.EndTag;
@@ -411,19 +412,30 @@ public interface ByteBufCodecs {
             @Override
             public T decode(RegistryFriendlyByteBuf buffer) {
                 Tag tag = streamCodec.decode(buffer);
-                RegistryOps<Tag> registryOps = buffer.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+                RegistryOps<Tag> registryOps = ByteBufCodecs.papoNbtSerializationContext(buffer.registryAccess()); // Papo - cached ops (see below)
                 return codec.parse(registryOps, tag).getOrThrow(string -> new DecoderException("Failed to decode: " + string + " " + tag));
             }
 
             @Override
             public void encode(RegistryFriendlyByteBuf buffer, T value) {
-                RegistryOps<Tag> registryOps = buffer.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+                RegistryOps<Tag> registryOps = ByteBufCodecs.papoNbtSerializationContext(buffer.registryAccess()); // Papo - cached ops (see below)
                 Tag tag = codec.encodeStart(registryOps, value).getOrThrow(string -> new EncoderException("Failed to encode: " + string + " " + value));
                 streamCodec.encode(buffer, tag);
             }
         };
     }
 
+    // Papo start - use the cached per-access NBT RegistryOps when the access is immutable (the common
+    // case: the server's frozen composite access). A RegistryOps only captures the access, and its
+    // HolderLookupAdapter lookup cache is a ConcurrentHashMap, so sharing one instance across calls
+    // and threads is safe and behavior-identical to creating one per call.
+    private static RegistryOps<Tag> papoNbtSerializationContext(RegistryAccess registryAccess) {
+        return registryAccess instanceof RegistryAccess.ImmutableRegistryAccess immutable
+            ? immutable.papoNbtSerializationContext()
+            : registryAccess.createSerializationContext(NbtOps.INSTANCE);
+    }
+    // Papo end
+
     // Paper start - Track codec depth
     static <B extends FriendlyByteBuf, V> StreamCodec<B, V> trackDepth(final StreamCodec<B, V> codec) {
         return new StreamCodec<>() {
