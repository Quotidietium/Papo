 import net.minecraft.core.UUIDUtil;
 import net.minecraft.nbt.CompoundTag;
 import net.minecraft.nbt.EndTag;
@@ -411,19 +412,30 @@ public interface ByteBufCodecs {
             @Override
             public T decode(RegistryFriendlyByteBuf buffer) {
                 Tag tag = streamCodec.decode(buffer);
-                RegistryOps<Tag> registryOps = buffer.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+                RegistryOps<Tag> registryOps = ByteBufCodecs.papoNbtSerializationContext(buffer.registryAccess()); // Papo - cached ops (see below)
                 return codec.parse(registryOps, tag).getOrThrow(string -> new DecoderException("Failed to decode: " + string + " " + tag));
             }
 
             @Override
             public void encode(RegistryFriendlyByteBuf buffer, T value) {
-                RegistryOps<Tag> registryOps = buffer.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+                RegistryOps<Tag> registryOps = ByteBufCodecs.papoNbtSerializationContext(buffer.registryAccess()); // Papo - cached ops (see below)
                 Tag tag = codec.encodeStart(registryOps, value).getOrThrow(string -> new EncoderException("Failed to encode: " + string + " " + value));
                 streamCodec.encode(buffer, tag);
             }
         };
     }
 
+    // Papo start - use the cached per-access NBT RegistryOps when the access is immutable (the common
+    // case: the server's frozen composite access). A RegistryOps only captures the access, and its
+    // HolderLookupAdapter lookup cache is a ConcurrentHashMap, so sharing one instance across calls
+    // and threads is safe and behavior-identical to creating one per call.
+    private static RegistryOps<Tag> papoNbtSerializationContext(RegistryAccess registryAccess) {
+        return registryAccess instanceof RegistryAccess.ImmutableRegistryAccess immutable
+            ? immutable.papoNbtSerializationContext()
+            : registryAccess.createSerializationContext(NbtOps.INSTANCE);
+    }
+    // Papo end
+
     // Paper start - Track codec depth
     static <B extends FriendlyByteBuf, V> StreamCodec<B, V> trackDepth(final StreamCodec<B, V> codec) {
         return new StreamCodec<>() {
