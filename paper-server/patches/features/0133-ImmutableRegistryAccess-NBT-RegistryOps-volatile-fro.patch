diff --git a/net/minecraft/core/RegistryAccess.java b/net/minecraft/core/RegistryAccess.java
index 8341ac329c71352015cce2e53d0138be30287cff..9a3bf5de4eeed933d3c5ddbd19f1306a51a28d83 100644
--- a/net/minecraft/core/RegistryAccess.java
+++ b/net/minecraft/core/RegistryAccess.java
@@ -65,6 +65,22 @@ public interface RegistryAccess extends HolderLookup.Provider {
 
     public static class ImmutableRegistryAccess implements RegistryAccess {
         private final Map<? extends ResourceKey<? extends Registry<?>>, ? extends Registry<?>> registries;
+        // Papo start - cached RegistryOps for the NBT serialization context (ByteBufCodecs hot path):
+        // the registries of an ImmutableRegistryAccess never change and a RegistryOps only captures
+        // this access, so it can be created once and shared. Thread-safe: RegistryOps.HolderLookupAdapter's
+        // lookup cache is a ConcurrentHashMap, NbtOps is stateless, and a benign race at first use just
+        // builds the same (equals-equal) ops twice.
+        private volatile net.minecraft.resources.RegistryOps<net.minecraft.nbt.Tag> papoNbtOps;
+
+        public net.minecraft.resources.RegistryOps<net.minecraft.nbt.Tag> papoNbtSerializationContext() {
+            net.minecraft.resources.RegistryOps<net.minecraft.nbt.Tag> ops = this.papoNbtOps;
+            if (ops == null) {
+                ops = this.createSerializationContext(net.minecraft.nbt.NbtOps.INSTANCE);
+                this.papoNbtOps = ops;
+            }
+            return ops;
+        }
+        // Papo end
 
         public ImmutableRegistryAccess(List<? extends Registry<?>> registries) {
             this.registries = registries.stream().collect(Collectors.toUnmodifiableMap(Registry::key, registry -> registry));
