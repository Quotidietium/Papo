From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sun, 11 Oct 2026 13:49:04 +0800
Subject: [PATCH] batch 175 (R34): CubicSpline.Multipoint mapAll fills a plain
 ArrayList instead of values().stream().map().toList() (335-trip stream
 machinery) + create() indexed loop (124-trip ListItr) - both on the
 per-density-tree-rebuild path of every generated chunk; same elements same
 order, record treats list as read-only


diff --git a/net/minecraft/util/CubicSpline.java b/net/minecraft/util/CubicSpline.java
index c8d7dafce978eb321ea8d253d9c66fefc544fc82..5719d7a414480b93f8bab0e4d5bfb9623a6fa324 100644
--- a/net/minecraft/util/CubicSpline.java
+++ b/net/minecraft/util/CubicSpline.java
@@ -8,6 +8,7 @@ import com.mojang.serialization.Codec;
 import com.mojang.serialization.codecs.RecordCodecBuilder;
 import it.unimi.dsi.fastutil.floats.FloatArrayList;
 import it.unimi.dsi.fastutil.floats.FloatList;
+import java.util.ArrayList;
 import java.util.List;
 import java.util.Locale;
 import java.util.stream.Collectors;
@@ -203,7 +204,14 @@ public interface CubicSpline<C, I extends BoundedFloatFunction<C>> extends Bound
                 f1 = Math.max(f1, Math.max(f4, f5));
             }
 
-            for (CubicSpline<C, I> cubicSpline : values) {
+            // Papo start - batch 175 (R34): indexed loop - create() runs per spline
+            // node on every density-tree rebuild (each generated chunk rewraps the
+            // tree), and the enhanced-for iterator was 124 census trips. Same order,
+            // same arithmetic.
+            final int valueCount = values.size();
+            for (int valueIdx = 0; valueIdx < valueCount; valueIdx++) {
+                final CubicSpline<C, I> cubicSpline = values.get(valueIdx);
+                // Papo end - batch 175 (R34)
                 f = Math.min(f, cubicSpline.minValue());
                 f1 = Math.max(f1, cubicSpline.maxValue());
             }
@@ -306,10 +314,25 @@ public interface CubicSpline<C, I extends BoundedFloatFunction<C>> extends Bound
 
         @Override
         public CubicSpline<C, I> mapAll(CubicSpline.CoordinateVisitor<I> visitor) {
+            // Papo start - batch 175 (R34): plain loop instead of
+            // values().stream().map(...).toList() - the stream machinery (Head,
+            // spliterator, pipeline stages) was 335 census trips on the same
+            // per-density-tree-rebuild path. Same elements in the same order; the
+            // record stores the list as read-only state (all consumers - create(),
+            // apply(), parityString(), the codec getter - only read it), and the codec
+            // path already stores Guava ImmutableList, so the concrete List
+            // implementation is not part of the observable contract.
+            final List<CubicSpline<C, I>> current = this.values();
+            final int size = current.size();
+            final List<CubicSpline<C, I>> mapped = new ArrayList<>(size);
+            for (int i = 0; i < size; i++) {
+                mapped.add(current.get(i).mapAll(visitor));
+            }
+            // Papo end - batch 175 (R34)
             return create(
                 visitor.visit(this.coordinate),
                 this.locations,
-                this.values().stream().map(cubicSpline -> cubicSpline.mapAll(visitor)).toList(),
+                mapped,
                 this.derivatives
             );
         }
