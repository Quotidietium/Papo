From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 22:13:45 +0800
Subject: [PATCH] DEFLATE Deflater ThreadLocal Deflater close end rese


diff --git a/net/minecraft/world/level/chunk/storage/RegionFileVersion.java b/net/minecraft/world/level/chunk/storage/RegionFileVersion.java
index 306ca3b49c005c0f0e9279f62f3dcd7acb4aa8cb..b8a192dc0fc243b8f76e806d1e9253103fd11aec 100644
--- a/net/minecraft/world/level/chunk/storage/RegionFileVersion.java
+++ b/net/minecraft/world/level/chunk/storage/RegionFileVersion.java
@@ -36,7 +36,7 @@ public class RegionFileVersion {
             2,
             "deflate",
             inputWrapper -> new FastBufferedInputStream(new PapoInflaterInputStream(inputWrapper)), // Papo - pooled Inflater + larger fill buffer (see below)
-            outputWrapper -> new BufferedOutputStream(papoCreateDeflaterOutputStream(outputWrapper))
+            outputWrapper -> new BufferedOutputStream(papoCreateDeflaterOutputStream(outputWrapper), RegionFileVersion.PAPO_REGION_WRITE_BUFFER_SIZE)
         )
     );
     public static final RegionFileVersion VERSION_NONE = register(new RegionFileVersion(3, "none", FastBufferedInputStream::new, BufferedOutputStream::new));
@@ -70,31 +70,65 @@ public class RegionFileVersion {
         };
     }
     // Paper end - Configurable region compression format
-    // Papo start - configurable deflate compression level for region files.
-    // DeflaterOutputStream(out, deflater) does NOT end() the provided Deflater on close, so wrap it
-    // in a small subclass that owns and ends the Deflater (avoids leaking native zlib state per save).
+    // Papo start - configurable deflate compression level for region files + pooled Deflaters.
+    // JDK bytecode: DeflaterOutputStream(out, def, size) with an explicitly provided Deflater sets
+    // usesDefaultDeflater=false, so close() finish()es the stream but does NOT end() the Deflater —
+    // it can be reset()+reused, avoiding a fresh native zlib allocation + Cleaner registration per
+    // chunk save (mirror of the read-side Inflater pool below). reset() restores the exact state of
+    // a new Deflater(level), and the compressed byte stream is a pure function of input bytes +
+    // flush modes, so raising the internal deflate buffer 512->8192 and the outer BufferedOutputStream
+    // to 32768 changes only call chunking, never the written bytes.
+    private static final int PAPO_DEFLATER_BUFFER_SIZE = 8192;
+    private static final int PAPO_REGION_WRITE_BUFFER_SIZE = 32768;
+    private static final ThreadLocal<RegionFileVersion.PapoPooledDeflater> PAPO_DEFLATER_POOL = new ThreadLocal<>();
+
     private static OutputStream papoCreateDeflaterOutputStream(OutputStream out) {
         int level = io.papermc.paper.configuration.GlobalConfiguration.get().unsupportedSettings.compressionLevel;
         if (level < 1 || level > 9) {
             level = 6;
         }
-        return new PapoDeflaterOutputStream(out, new java.util.zip.Deflater(level));
+        return new PapoDeflaterOutputStream(out, papoBorrowDeflater(level));
+    }
+
+    private static RegionFileVersion.PapoPooledDeflater papoBorrowDeflater(int level) {
+        final RegionFileVersion.PapoPooledDeflater pooled = PAPO_DEFLATER_POOL.get();
+        if (pooled != null) {
+            PAPO_DEFLATER_POOL.set(null);
+            if (pooled.level == level) {
+                return pooled;
+            }
+            pooled.deflater.end(); // compression level changed (config reload): retire it, mirroring the old end()-on-close
+        }
+        return new RegionFileVersion.PapoPooledDeflater(new java.util.zip.Deflater(level), level);
+    }
+
+    private static final class PapoPooledDeflater {
+        final java.util.zip.Deflater deflater;
+        final int level;
+
+        PapoPooledDeflater(java.util.zip.Deflater deflater, int level) {
+            this.deflater = deflater;
+            this.level = level;
+        }
     }
 
     private static final class PapoDeflaterOutputStream extends java.util.zip.DeflaterOutputStream {
-        private final java.util.zip.Deflater ownedDeflater;
+        private final RegionFileVersion.PapoPooledDeflater pooled;
 
-        PapoDeflaterOutputStream(OutputStream out, java.util.zip.Deflater deflater) {
-            super(out, deflater);
-            this.ownedDeflater = deflater;
+        PapoDeflaterOutputStream(OutputStream out, RegionFileVersion.PapoPooledDeflater pooled) {
+            super(out, pooled.deflater, PAPO_DEFLATER_BUFFER_SIZE);
+            this.pooled = pooled;
         }
 
         @Override
         public void close() throws IOException {
             try {
-                super.close();
+                super.close(); // closes the underlying stream; does not end() the borrowed Deflater
             } finally {
-                this.ownedDeflater.end();
+                this.pooled.deflater.reset();
+                // single slot per thread: if a second stream was open concurrently the displaced
+                // Deflater is simply dropped for the GC/Cleaner, same as the old per-stream one.
+                PAPO_DEFLATER_POOL.set(this.pooled);
             }
         }
     }
