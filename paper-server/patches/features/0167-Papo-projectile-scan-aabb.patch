From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sat, 1 Aug 2026 04:06:40 +0800
Subject: [PATCH] Papo projectile scan aabb


diff --git a/net/minecraft/world/entity/projectile/ProjectileUtil.java b/net/minecraft/world/entity/projectile/ProjectileUtil.java
index 00e7dd53ed4f82001b681f32e1b88495d66669d0..230366938b70e2210c2b6ebb3678164b485ebc61 100644
--- a/net/minecraft/world/entity/projectile/ProjectileUtil.java
+++ b/net/minecraft/world/entity/projectile/ProjectileUtil.java
@@ -69,9 +69,28 @@ public final class ProjectileUtil {
             vec3 = hitResult.getLocation();
         }
 
+        // Papo start - collapse expandTowards(deltaMovement).inflate(1.0) into one AABB (2 allocs -> 1):
+        // per axis min' = (min + (dm<0?dm:0)) - 1, max' = (max + (dm>0?dm:0)) + 1. Ternaries (not
+        // Math.min/max) keep NaN deltaMovement identical to expandTowards' >0/<0 branches; FP op order
+        // (left-associative) and the -0.0 edge (erased by the subsequent ±1.0) match the chain bit for bit.
+        AABB papoSourceBb = source.getBoundingBox();
         HitResult entityHitResult = getEntityHitResult(
-            level, source, pos, vec3, source.getBoundingBox().expandTowards(deltaMovement).inflate(1.0), filter, margin
+            level,
+            source,
+            pos,
+            vec3,
+            new AABB(
+                papoSourceBb.minX + (deltaMovement.x < 0.0 ? deltaMovement.x : 0.0) - 1.0,
+                papoSourceBb.minY + (deltaMovement.y < 0.0 ? deltaMovement.y : 0.0) - 1.0,
+                papoSourceBb.minZ + (deltaMovement.z < 0.0 ? deltaMovement.z : 0.0) - 1.0,
+                papoSourceBb.maxX + (deltaMovement.x > 0.0 ? deltaMovement.x : 0.0) + 1.0,
+                papoSourceBb.maxY + (deltaMovement.y > 0.0 ? deltaMovement.y : 0.0) + 1.0,
+                papoSourceBb.maxZ + (deltaMovement.z > 0.0 ? deltaMovement.z : 0.0) + 1.0
+            ),
+            filter,
+            margin
         );
+        // Papo end
         if (entityHitResult != null) {
             hitResult = entityHitResult;
         }
