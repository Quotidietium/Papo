From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 01:57:23 +0800
Subject: [PATCH] TrackedEntity seenBy 2


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index ab8893163ac85971a470e4a4d6fa76bd174e2bae..d3d5d08b234aea0e23b40e246aeff1761b5c2eae 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1247,9 +1247,20 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
 
             if (lastChunkUpdate != currChunkUpdate || lastTrackedChunk != chunk) {
                 // need to purge any players possible not in the chunk list
-                for (final ServerPlayerConnection conn : new java.util.ArrayList<>(this.seenBy)) {
+                // Papo - lazily collect removals instead of defensively copying seenBy
+                // (usually nobody needs purging; removePlayer call sequence unchanged).
+                java.util.List<ServerPlayer> toRemove = null;
+                for (final ServerPlayerConnection conn : this.seenBy) {
                     final ServerPlayer player = conn.getPlayer();
                     if (!players.contains(player)) {
+                        if (toRemove == null) {
+                            toRemove = new java.util.ArrayList<>();
+                        }
+                        toRemove.add(player);
+                    }
+                }
+                if (toRemove != null) {
+                    for (final ServerPlayer player : toRemove) {
                         this.removePlayer(player);
                     }
                 }
@@ -1270,9 +1281,20 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 return;
             }
 
-            for (final ServerPlayerConnection conn : new java.util.ArrayList<>(this.seenBy)) {
+            // Papo - lazily collect removals instead of defensively copying seenBy
+            // (removePlayer call sequence unchanged).
+            java.util.List<ServerPlayer> toRemove = null;
+            for (final ServerPlayerConnection conn : this.seenBy) {
                 ServerPlayer player = conn.getPlayer();
                 if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(player)) {
+                    if (toRemove == null) {
+                        toRemove = new java.util.ArrayList<>();
+                    }
+                    toRemove.add(player);
+                }
+            }
+            if (toRemove != null) {
+                for (final ServerPlayer player : toRemove) {
                     this.removePlayer(player);
                 }
             }
