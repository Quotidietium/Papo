@@ -376,6 +376,22 @@ public class BeaconBlockEntity extends BlockEntity implements MenuProvider, Name
 
     // Paper start - BeaconEffectEvent
     private static void applyEffectsAndCallEvent(final Level level, final BlockPos position, final List<Player> players, final MobEffectInstance mobEffectInstance, final boolean isPrimary) {
+        // Papo start - zero-listener fast path (0162): with no BeaconEffectEvent listeners the
+        // event is never cancelled and getEffect() returns the constructor effect unchanged, so
+        // each player would receive fromBukkit(toBukkit(mobEffectInstance)) — field-equal to a
+        // plain copy: the effect holder round-trips through the registry bidirectional mapping,
+        // hiddenEffect is null on beacon instances (and dropped by fromBukkit anyway), and the
+        // beacon amplifier (0/1) passes the fromBukkit clamp unchanged. Skip the shared
+        // toBukkit/CraftBlock and per-player event allocations; apply a per-player copy instead
+        // (duration mutates in place during effect ticking, so the shared instance itself must
+        // not be handed out).
+        if (com.destroystokyo.paper.event.block.BeaconEffectEvent.getHandlerList().getRegisteredListeners().length == 0) {
+            for (final Player player : players) {
+                player.addEffect(new MobEffectInstance(mobEffectInstance), org.bukkit.event.entity.EntityPotionEffectEvent.Cause.BEACON);
+            }
+            return;
+        }
+        // Papo end
         final org.bukkit.potion.PotionEffect apiEffect = org.bukkit.craftbukkit.potion.CraftPotionUtil.toBukkit(mobEffectInstance);
         final org.bukkit.craftbukkit.block.CraftBlock apiBlock = org.bukkit.craftbukkit.block.CraftBlock.at(level, position);
         for (final Player player : players) {
