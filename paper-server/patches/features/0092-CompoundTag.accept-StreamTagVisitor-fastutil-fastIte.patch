Subject: [PATCH] CompoundTag.accept StreamTagVisitor fastutil fastIte


diff --git a/net/minecraft/nbt/CompoundTag.java b/net/minecraft/nbt/CompoundTag.java
index c57bf4a698a37e2d34e259eed03079f26251be1d..6648d65787ced83ada7e46682ed705eecc3866e4 100644
--- a/net/minecraft/nbt/CompoundTag.java
+++ b/net/minecraft/nbt/CompoundTag.java
@@ -502,41 +502,64 @@ public final class CompoundTag implements Tag {
 
     @Override
     public StreamTagVisitor.ValueResult accept(StreamTagVisitor visitor) {
+        // Papo - fastutil fastIterator (same pattern as write()/merge()): the entry does not escape the
+        // loop body and iteration order is identical on the same backing array.
+        if (this.tags instanceof it.unimi.dsi.fastutil.objects.Object2ObjectOpenHashMap) {
+            java.util.Iterator<it.unimi.dsi.fastutil.objects.Object2ObjectMap.Entry<String, Tag>> iterator = it.unimi.dsi.fastutil.objects.Object2ObjectMaps
+                .fastIterator((it.unimi.dsi.fastutil.objects.Object2ObjectOpenHashMap<String, Tag>) this.tags);
+            while (iterator.hasNext()) {
+                it.unimi.dsi.fastutil.objects.Object2ObjectMap.Entry<String, Tag> entry = iterator.next();
+                StreamTagVisitor.ValueResult result = acceptEntry(visitor, entry.getKey(), entry.getValue());
+                if (result != null) {
+                    return result;
+                }
+            }
+            return visitor.visitContainerEnd();
+        }
         for (Entry<String, Tag> entry : this.tags.entrySet()) {
-            Tag tag = entry.getValue();
-            TagType<?> type = tag.getType();
-            StreamTagVisitor.EntryResult entryResult = visitor.visitEntry(type);
-            switch (entryResult) {
-                case HALT:
-                    return StreamTagVisitor.ValueResult.HALT;
-                case BREAK:
-                    return visitor.visitContainerEnd();
-                case SKIP:
-                    break;
-                default:
-                    entryResult = visitor.visitEntry(type, entry.getKey());
-                    switch (entryResult) {
-                        case HALT:
-                            return StreamTagVisitor.ValueResult.HALT;
-                        case BREAK:
-                            return visitor.visitContainerEnd();
-                        case SKIP:
-                            break;
-                        default:
-                            StreamTagVisitor.ValueResult valueResult = tag.accept(visitor);
-                            switch (valueResult) {
-                                case HALT:
-                                    return StreamTagVisitor.ValueResult.HALT;
-                                case BREAK:
-                                    return visitor.visitContainerEnd();
-                            }
-                    }
+            StreamTagVisitor.ValueResult result = acceptEntry(visitor, entry.getKey(), entry.getValue());
+            if (result != null) {
+                return result;
             }
         }
-
         return visitor.visitContainerEnd();
     }
 
+    // Papo - extracted loop body shared by the fastIterator and entrySet paths above.
+    // Returns null for "continue to next entry" (SKIP), non-null when accept() must return early.
+    private StreamTagVisitor.@Nullable ValueResult acceptEntry(StreamTagVisitor visitor, String key, Tag tag) {
+        TagType<?> type = tag.getType();
+        StreamTagVisitor.EntryResult entryResult = visitor.visitEntry(type);
+        switch (entryResult) {
+            case HALT:
+                return StreamTagVisitor.ValueResult.HALT;
+            case BREAK:
+                return visitor.visitContainerEnd();
+            case SKIP:
+                return null;
+            default:
+                entryResult = visitor.visitEntry(type, key);
+                switch (entryResult) {
+                    case HALT:
+                        return StreamTagVisitor.ValueResult.HALT;
+                    case BREAK:
+                        return visitor.visitContainerEnd();
+                    case SKIP:
+                        return null;
+                    default:
+                        StreamTagVisitor.ValueResult valueResult = tag.accept(visitor);
+                        switch (valueResult) {
+                            case HALT:
+                                return StreamTagVisitor.ValueResult.HALT;
+                            case BREAK:
+                                return visitor.visitContainerEnd();
+                            default:
+                                return null;
+                        }
+                }
+        }
+    }
+
     public <T> void store(String key, Codec<T> codec, T data) {
         this.store(key, codec, NbtOps.INSTANCE, data);
     }
