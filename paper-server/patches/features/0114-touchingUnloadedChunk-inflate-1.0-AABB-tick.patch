diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 069e119e9403a6644367117f9f4ccd7f94e9d896..9ae2621615cf09c74af50b3538f7bf1ea5ed1f17 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -4909,11 +4909,16 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     // Paper end - optimise collisions
 
     public boolean touchingUnloadedChunk() {
-        AABB aabb = this.getBoundingBox().inflate(1.0);
-        int floor = Mth.floor(aabb.minX);
-        int ceil = Mth.ceil(aabb.maxX);
-        int floor1 = Mth.floor(aabb.minZ);
-        int ceil1 = Mth.ceil(aabb.maxZ);
+        // Papo start - avoid per-call AABB allocation: inline inflate(1.0) bounds arithmetic
+        // AABB.inflate(v) == new AABB(minX - v, minY - v, minZ - v, maxX + v, maxY + v, maxZ + v); only
+        // minX/maxX/minZ/maxZ are read below. getBoundingBox() returns the stored field (final method).
+        // Bit-exact same operations as inflate(1.0), no AABB object.
+        final AABB papoBoundingBox = this.getBoundingBox();
+        int floor = Mth.floor(papoBoundingBox.minX - 1.0);
+        int ceil = Mth.ceil(papoBoundingBox.maxX + 1.0);
+        int floor1 = Mth.floor(papoBoundingBox.minZ - 1.0);
+        int ceil1 = Mth.ceil(papoBoundingBox.maxZ + 1.0);
+        // Papo end
         return !this.level().hasChunksAt(floor, floor1, ceil, ceil1);
     }
 
