From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 22:13:46 +0800
Subject: [PATCH] PlayerSensor.getFollowDistance doTick


diff --git a/net/minecraft/world/entity/ai/sensing/PlayerSensor.java b/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
index eb3ec4be63e1710d0ed9021eb8158d56eae89f8d..828ec037b7800c4122578df5c5c3eaec1eb76717 100644
--- a/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
+++ b/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
@@ -26,10 +26,13 @@ public class PlayerSensor extends Sensor<LivingEntity> {
 
     @Override
     protected void doTick(ServerLevel level, LivingEntity entity) {
+        // Papo - hoist the follow-distance attribute read out of the per-player filter: the value is
+        // constant within a single doTick evaluation (single-threaded, no mutation mid-stream).
+        double papoFollowDistance = this.getFollowDistance(entity);
         List<Player> list = level.players()
             .stream()
             .filter(EntitySelector.NO_SPECTATORS)
-            .filter(serverPlayer -> entity.closerThan(serverPlayer, this.getFollowDistance(entity)))
+            .filter(serverPlayer -> entity.closerThan(serverPlayer, papoFollowDistance))
             .sorted(Comparator.comparingDouble(entity::distanceToSqr))
             .collect(Collectors.toList());
         Brain<?> brain = entity.getBrain();
