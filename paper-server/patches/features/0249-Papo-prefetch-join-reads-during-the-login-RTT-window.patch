+    /**
+     * Kicks off the async READ for a joining player; idempotent per UUID. Read side only
+     * (file read + gzip + NBT parse, IO pool, chained after pending writes, BLOCKING
+     * priority). The datafix deliberately stays on the main thread at the consume point,
+     * byte-identical to the synchronous path: the burst verification round showed that
+     * moving the CPU-heavy fix onto the IO pool starves region-file reads (spawn chunk
+     * loads) and onto the worker pool it contends with chunk deserialization - either way
+     * a 20-bot old-file join burst gets measurably slower end-to-end. Keeping it on main
+     * makes the prefetch a strictly additive read-side win.
+     */
+    public void papoPrefetch(final NameAndId nameAndId) {
+        final UUID uuid = nameAndId.id();
+        if (this.papoPrefetches.containsKey(uuid)) {
+            return;
+        }
+        final Path datPath = this.playerDir.toPath().resolve(uuid.toString() + ".dat");
+        final io.papermc.paper.util.PapoOrderedFileWrites.ReadHandle<PapoRawPlayerRead> read =
+            io.papermc.paper.util.PapoOrderedFileWrites.enqueueRead(datPath, () -> this.papoReadRaw(nameAndId));
+        if (read != null) {
