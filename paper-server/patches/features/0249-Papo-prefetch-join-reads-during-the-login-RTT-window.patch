+    /** Called from the login listener once the final profile is known; safe from any thread. */
+    public void papoPrefetchJoinData(final NameAndId nameAndId) {
+        if (this.server.isSingleplayerOwner(nameAndId)) {
+            return; // the singleplayer owner loads from the in-memory tag, never from these files
+        }
+        this.playerIo.papoPrefetch(nameAndId);
+        final UUID uuid = nameAndId.id();
+        final Path statsPath = this.server.getWorldPath(LevelResource.PLAYER_STATS_DIR).resolve(uuid + ".json");
+        final java.util.concurrent.CompletableFuture<com.google.gson.JsonElement> statsFuture =
+            io.papermc.paper.util.PapoOrderedFileWrites.enqueueRead(statsPath, () -> papoReadJsonIfExists(statsPath));
+        if (statsFuture != null) {
+            this.papoStatsPrefetches.put(statsPath, statsFuture);
+        }
+        final Path advPath = this.server.getWorldPath(LevelResource.PLAYER_ADVANCEMENTS_DIR).resolve(uuid + ".json");
+        final java.util.concurrent.CompletableFuture<com.google.gson.JsonElement> advFuture =
+            io.papermc.paper.util.PapoOrderedFileWrites.enqueueRead(advPath, () -> papoReadJsonIfExists(advPath));
+        if (advFuture != null) {
+            this.papoAdvancementsPrefetches.put(advPath, advFuture);
+        }
+    }
+
+    /**
+     * Pure file read + strict JSON parse; returns null when the file is absent or unreadable
+     * so the caller falls back to the synchronous path (which logs exactly like vanilla).
+     */
+    private static com.google.gson.@org.jspecify.annotations.Nullable JsonElement papoReadJsonIfExists(final Path path) {
+        if (!Files.isRegularFile(path)) {
+            return null;
+        }
+        try (java.io.Reader reader = Files.newBufferedReader(path, java.nio.charset.StandardCharsets.UTF_8)) {
+            return net.minecraft.util.StrictJsonParser.parse(reader);
+        } catch (final IOException | com.google.gson.JsonParseException ignored) {
+            return null;
+        }
+    }
+
+    /** Takes the prefetched stats JSON for this exact file, or null when none was prefetched. */
+    public java.util.concurrent.@org.jspecify.annotations.Nullable CompletableFuture<com.google.gson.JsonElement> papoTakePrefetchedStats(final Path file) {
+        return this.papoStatsPrefetches.remove(file);
+    }
+
+    /** Takes the prefetched advancements JSON for this exact file, or null when none was prefetched. */
+    public java.util.concurrent.@org.jspecify.annotations.Nullable CompletableFuture<com.google.gson.JsonElement> papoTakePrefetchedAdvancements(final Path file) {
+        return this.papoAdvancementsPrefetches.remove(file);
+    }
+
+    /** Drops unconsumed prefetches (login aborted before the data was needed). */
+    public void papoDiscardJoinPrefetches(final UUID uuid) {
+        this.playerIo.papoDiscardPrefetch(uuid);
+        this.papoStatsPrefetches.remove(this.server.getWorldPath(LevelResource.PLAYER_STATS_DIR).resolve(uuid + ".json"));
+        this.papoAdvancementsPrefetches.remove(this.server.getWorldPath(LevelResource.PLAYER_ADVANCEMENTS_DIR).resolve(uuid + ".json"));
+    }
+    // Papo end - batch 82: join read-side prefetch during the login RTT window
