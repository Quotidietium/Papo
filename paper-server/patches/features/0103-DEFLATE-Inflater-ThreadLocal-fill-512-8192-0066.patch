     // Papo end
+    // Papo start - pooled Inflaters + larger fill buffer for the deflate read side
+    // (mirror of the write-side PapoDeflaterOutputStream above). JDK bytecode:
+    // InflaterInputStream(InputStream) creates a new Inflater (native zlib state + Cleaner
+    // registration) per stream and end()s it on close; the (InputStream, Inflater, int)
+    // constructor with an explicitly provided Inflater sets usesDefaultInflater=false, so
+    // close() does NOT end() it and the Inflater can be reset()+reused. Decompressed bytes
+    // depend only on the compressed input, not on fill chunking, so raising the fill buffer
+    // from the default 512 to 8192 changes only the number of fill() calls, not the output.
+    private static final int PAPO_INFLATER_BUFFER_SIZE = 8192;
+    private static final ThreadLocal<java.util.zip.Inflater> PAPO_INFLATER_POOL = new ThreadLocal<>();
+
+    private static java.util.zip.Inflater papoBorrowInflater() {
+        final java.util.zip.Inflater pooled = PAPO_INFLATER_POOL.get();
+        if (pooled != null) {
+            PAPO_INFLATER_POOL.set(null);
+            return pooled;
+        }
+        return new java.util.zip.Inflater();
+    }
+
+    private static final class PapoInflaterInputStream extends InflaterInputStream {
+        PapoInflaterInputStream(InputStream in) {
+            super(in, papoBorrowInflater(), PAPO_INFLATER_BUFFER_SIZE);
+        }
+
+        @Override
+        public void close() throws IOException {
+            try {
+                super.close(); // closes the underlying stream; does not end() the borrowed Inflater
+            } finally {
+                this.inf.reset();
+                // single slot per thread: if a second stream was open concurrently the displaced
+                // Inflater is simply dropped for the GC/Cleaner, same as the old per-stream one.
+                PAPO_INFLATER_POOL.set(this.inf);
+            }
+        }
+    }
+    // Papo end
     private RegionFileVersion(
         int id,
         @Nullable String optionName,
