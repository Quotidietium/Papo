diff --git a/net/minecraft/advancements/criterion/KilledTrigger.java b/net/minecraft/advancements/criterion/KilledTrigger.java
index f1ea7f70ca5fa92f2c17b7f2fffde1f31fda1831..a64ebd5c9721215e581cb6a980846bbe46fdbb9f 100644
--- a/net/minecraft/advancements/criterion/KilledTrigger.java
+++ b/net/minecraft/advancements/criterion/KilledTrigger.java
@@ -17,6 +17,7 @@ public class KilledTrigger extends SimpleCriterionTrigger<KilledTrigger.TriggerI
     }
 
     public void trigger(ServerPlayer player, Entity entity, DamageSource damageSource) {
+        if (!this.hasListeners(player)) return; // Papo - skip eager LootContext build when nobody listens
         LootContext lootContext = EntityPredicate.createContext(player, entity);
         this.trigger(player, instance -> instance.matches(player, lootContext, damageSource));
     }
