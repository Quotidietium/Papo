Date: Fri, 31 Jul 2026 23:27:33 +0800
Subject: [PATCH] PlayerChunkSender.collectChunksToSend else tick pend


diff --git a/net/minecraft/server/network/PlayerChunkSender.java b/net/minecraft/server/network/PlayerChunkSender.java
index 6a04b9b9d90f3d65a81a84f3610865ead5ec6748..cb41618405895bd920539a333cd8f8cd30233e0b 100644
--- a/net/minecraft/server/network/PlayerChunkSender.java
+++ b/net/minecraft/server/network/PlayerChunkSender.java
@@ -6,7 +6,6 @@ import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
 import it.unimi.dsi.fastutil.longs.LongSet;
 import java.util.Comparator;
 import java.util.List;
-import java.util.Objects;
 import net.minecraft.SharedConstants;
 import net.minecraft.network.protocol.game.ClientboundChunkBatchFinishedPacket;
 import net.minecraft.network.protocol.game.ClientboundChunkBatchStartPacket;
@@ -114,12 +113,20 @@ public class PlayerChunkSender {
             }
             // Papo end
         } else {
-            list = this.pendingChunks
-                .longStream()
-                .mapToObj(chunkMap::getChunkToSend)
-                .filter(Objects::nonNull)
-                .sorted(Comparator.comparingInt(levelChunk1 -> chunkPos.distanceSquared(levelChunk1.getPos())))
-                .toList();
+            // Papo start - imperative equivalent of longStream().mapToObj().filter().sorted().toList():
+            // longStream iterates via the same LongIterator used here, Stream.sorted and List.sort are
+            // both stable with the same comparator, and the returned list is only read (isEmpty/for/size),
+            // so mutability and order are indistinguishable from the stream pipeline.
+            list = new java.util.ArrayList<>(this.pendingChunks.size());
+            it.unimi.dsi.fastutil.longs.LongIterator papoIt = this.pendingChunks.longIterator();
+            while (papoIt.hasNext()) {
+                LevelChunk levelChunk = chunkMap.getChunkToSend(papoIt.nextLong());
+                if (levelChunk != null) {
+                    list.add(levelChunk);
+                }
+            }
+            list.sort(Comparator.comparingInt(levelChunk1 -> chunkPos.distanceSquared(levelChunk1.getPos())));
+            // Papo end
         }
 
         for (LevelChunk levelChunk : list) {
