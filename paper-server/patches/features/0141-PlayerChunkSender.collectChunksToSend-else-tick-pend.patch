         } else {
-            list = this.pendingChunks
-                .longStream()
-                .mapToObj(chunkMap::getChunkToSend)
-                .filter(Objects::nonNull)
-                .sorted(Comparator.comparingInt(levelChunk1 -> chunkPos.distanceSquared(levelChunk1.getPos())))
-                .toList();
+            // Papo start - imperative equivalent of longStream().mapToObj().filter().sorted().toList():
+            // longStream iterates via the same LongIterator used here, Stream.sorted and List.sort are
+            // both stable with the same comparator, and the returned list is only read (isEmpty/for/size),
+            // so mutability and order are indistinguishable from the stream pipeline.
+            list = new java.util.ArrayList<>(this.pendingChunks.size());
+            it.unimi.dsi.fastutil.longs.LongIterator papoIt = this.pendingChunks.longIterator();
+            while (papoIt.hasNext()) {
+                LevelChunk levelChunk = chunkMap.getChunkToSend(papoIt.nextLong());
+                if (levelChunk != null) {
+                    list.add(levelChunk);
+                }
+            }
+            list.sort(Comparator.comparingInt(levelChunk1 -> chunkPos.distanceSquared(levelChunk1.getPos())));
+            // Papo end
         }
 
         for (LevelChunk levelChunk : list) {
