From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Thu, 30 Jul 2026 20:56:21 +0800
Subject: [PATCH] writeFixedSizeLongArray buffer internalNioBuffer Lon


diff --git a/net/minecraft/network/FriendlyByteBuf.java b/net/minecraft/network/FriendlyByteBuf.java
index f4bc9d05cd2349804eec832490fbb47862e5f073..7c88d9c7a7531cffffe791a46ce30a68024eb56e 100644
--- a/net/minecraft/network/FriendlyByteBuf.java
+++ b/net/minecraft/network/FriendlyByteBuf.java
@@ -358,9 +358,23 @@ public class FriendlyByteBuf extends ByteBuf {
     }
 
     public static void writeFixedSizeLongArray(ByteBuf buffer, long[] array) {
-        for (long l : array) {
-            buffer.writeLong(l);
+        // Papo start - bulk-encode through a LongBuffer view instead of per-element writeLong
+        // (chunk packet bit-storage write: ~6-12k writeLong calls per chunk, each with ensureWritable
+        // checks). Only for single-component big-endian buffers (the MC networking default, and the
+        // Unpooled.wrappedBuffer target in ClientboundLevelChunkPacketData); otherwise fall back to the
+        // original loop. LongBuffer.put produces the exact same BE byte sequence as writeLong.
+        if (buffer.nioBufferCount() == 1 && buffer.order() == java.nio.ByteOrder.BIG_ENDIAN) {
+            int n = array.length << 3;
+            buffer.ensureWritable(n);
+            int w = buffer.writerIndex();
+            buffer.internalNioBuffer(w, n).asLongBuffer().put(array);
+            buffer.writerIndex(w + n);
+        } else {
+            for (long l : array) {
+                buffer.writeLong(l);
+            }
         }
+        // Papo end
     }
 
     public long[] readLongArray() {
