From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 06:16:51 +0800
Subject: [PATCH] PlayerPickupItemEvent EntityPickupItemEvent getCanPi


diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index d327ffc2e4ccf03961be6df3546e3a3491637875..a125be5969e937467adf2b0c474512f810bfd2ae 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -429,6 +429,20 @@ public class ItemEntity extends Entity implements TraceableEntity {
 
             if (this.pickupDelay <= 0 && canHold > 0) {
                 item.setCount(canHold);
+                // Papo start - no listeners on either pickup event: both events apply the same default
+                // cancel rule (!getCanPickupItems()), flyAtPlayer keeps its true init default (see playerTouch init), and with zero
+                // listeners the stack can never be swapped, so replicate the outcome directly and skip
+                // both event allocations + getBukkitEntity() calls.
+                if (org.bukkit.event.player.PlayerPickupItemEvent.getHandlerList().getRegisteredListeners().length == 0
+                    && org.bukkit.event.entity.EntityPickupItemEvent.getHandlerList().getRegisteredListeners().length == 0) {
+                    if (!entity.getBukkitEntity().getCanPickupItems()) {
+                        item.setCount(count); // SPIGOT-5294 - restore count
+                        return;
+                    }
+                    item.setCount(canHold + remaining); // = i (events cannot swap the stack with no listeners)
+                    this.pickupDelay = 0;
+                } else {
+                // Papo end
                 // Call legacy event
                 org.bukkit.event.player.PlayerPickupItemEvent playerEvent = new org.bukkit.event.player.PlayerPickupItemEvent((org.bukkit.entity.Player) entity.getBukkitEntity(), (org.bukkit.entity.Item) this.getBukkitEntity(), remaining);
                 playerEvent.setCancelled(!playerEvent.getPlayer().getCanPickupItems());
@@ -463,6 +477,7 @@ public class ItemEntity extends Entity implements TraceableEntity {
 
                 // Possibly < 0; fix here so we do not have to modify code below
                 this.pickupDelay = 0;
+                } // Papo - end no-listener gate
             } else if (this.pickupDelay == 0) {
                 // ensure that the code below isn't triggered if canHold says we can't pick the items up
                 this.pickupDelay = -1;
