Date: Sun, 11 Oct 2026 14:58:04 +0800
Subject: [PATCH] batch 176 (R35): PlacementModifier gains forEachPosition
 (allocation-free traversal twin of getPositions; default delegates to the
 stream form so plugin subclasses keep working) with loop overrides on every
 vanilla modifier - PlacementFilter final emit-if covers 5 filters,
 RepeatingPlacement covers 4 count family, plus
 InSquare/HeightRange/Heightmap/RandomOffset/Fixed/EnvironmentScan/CountOnEveryLayer
 - and PlacedFeature.placeWithContext drives a depth-first walk instead of the
 flatMap chain (236 visible census trips + hidden per-position-per-layer
 stream machinery). Same emissions, same order, same random consumption;
 multi-emission modifiers sample all randomness before the first emission
 mirroring the eager stream builders


diff --git a/net/minecraft/world/level/levelgen/placement/CountOnEveryLayerPlacement.java b/net/minecraft/world/level/levelgen/placement/CountOnEveryLayerPlacement.java
index 06721d146ad96fa95645b8fe5eef58171b2bef33..120f629f70cf34ad997a687a53acdc000524a361 100644
--- a/net/minecraft/world/level/levelgen/placement/CountOnEveryLayerPlacement.java
+++ b/net/minecraft/world/level/levelgen/placement/CountOnEveryLayerPlacement.java
@@ -56,6 +56,40 @@ public class CountOnEveryLayerPlacement extends PlacementModifier {
         return builder.build();
     }
 
+    // Papo start - batch 176 (R35): the whole emission set is built first - every
+    // random of this modifier is sampled before the first emission, exactly like the
+    // stream form materialises its builder inside getPositions - and only then are
+    // the positions emitted in build order. count.sample(random) stays in the loop
+    // condition so it is sampled on the same iterations as vanilla.
+    @Override
+    public void forEachPosition(PlacementContext context, RandomSource random, BlockPos pos, java.util.function.Consumer<BlockPos> emitter) {
+        java.util.List<BlockPos> emitted = new java.util.ArrayList<>();
+        int i = 0;
+
+        boolean flag;
+        do {
+            flag = false;
+
+            for (int i1 = 0; i1 < this.count.sample(random); i1++) {
+                int i2 = random.nextInt(16) + pos.getX();
+                int i3 = random.nextInt(16) + pos.getZ();
+                int height = context.getHeight(Heightmap.Types.MOTION_BLOCKING, i2, i3);
+                int i4 = findOnGroundYPosition(context, i2, height, i3, i);
+                if (i4 != Integer.MAX_VALUE) {
+                    emitted.add(new BlockPos(i2, i4, i3));
+                    flag = true;
+                }
+            }
+
+            i++;
+        } while (flag);
+
+        for (int i5 = 0; i5 < emitted.size(); i5++) {
+            emitter.accept(emitted.get(i5));
+        }
+    }
+    // Papo end - batch 176 (R35)
+
     @Override
     public PlacementModifierType<?> type() {
         return PlacementModifierType.COUNT_ON_EVERY_LAYER;
diff --git a/net/minecraft/world/level/levelgen/placement/EnvironmentScanPlacement.java b/net/minecraft/world/level/levelgen/placement/EnvironmentScanPlacement.java
index 5d6053cbd6d07d2a1eaf2acc1d8d42607459b9f0..4b92e970ad9b0f4890870a181a71cbbf1360f778 100644
--- a/net/minecraft/world/level/levelgen/placement/EnvironmentScanPlacement.java
+++ b/net/minecraft/world/level/levelgen/placement/EnvironmentScanPlacement.java
@@ -70,6 +70,39 @@ public class EnvironmentScanPlacement extends PlacementModifier {
         }
     }
 
+    // Papo start - batch 176 (R35): same control flow and predicate call sequence;
+    // emits the mutable position (the driver consumes each emission synchronously,
+    // matching the stream form's aliasing)
+    @Override
+    public void forEachPosition(PlacementContext context, RandomSource random, BlockPos pos, java.util.function.Consumer<BlockPos> emitter) {
+        BlockPos.MutableBlockPos mutableBlockPos = pos.mutable();
+        WorldGenLevel level = context.getLevel();
+        if (!this.allowedSearchCondition.test(level, mutableBlockPos)) {
+            return;
+        } else {
+            for (int i = 0; i < this.maxSteps; i++) {
+                if (this.targetCondition.test(level, mutableBlockPos)) {
+                    emitter.accept(mutableBlockPos);
+                    return;
+                }
+
+                mutableBlockPos.move(this.directionOfSearch);
+                if (level.isOutsideBuildHeight(mutableBlockPos.getY())) {
+                    return;
+                }
+
+                if (!this.allowedSearchCondition.test(level, mutableBlockPos)) {
+                    break;
+                }
+            }
+
+            if (this.targetCondition.test(level, mutableBlockPos)) {
+                emitter.accept(mutableBlockPos);
+            }
+        }
+    }
+    // Papo end - batch 176 (R35)
+
     @Override
     public PlacementModifierType<?> type() {
         return PlacementModifierType.ENVIRONMENT_SCAN;
diff --git a/net/minecraft/world/level/levelgen/placement/FixedPlacement.java b/net/minecraft/world/level/levelgen/placement/FixedPlacement.java
