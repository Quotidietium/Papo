         return this.placeWithContext(new PlacementContext(level, generator, Optional.of(this)), random, pos);
     }
 
+    // Papo start - batch 176 (R35): drive placement through forEachPosition instead
+    // of a flatMap chain - the chain allocates stream machinery per position per
+    // modifier (Head/spliterator/pipeline stages; 236 visible census trips plus the
+    // hidden per-layer stages). The depth-first walk and the per-modifier random
+    // consumption sequence are identical to the sequential flatMap chain's lazy
+    // pull semantics; see PapoPlacementDriverEquivalenceTest.
     private boolean placeWithContext(PlacementContext context, RandomSource source, BlockPos pos) {
-        Stream<BlockPos> stream = Stream.of(pos);
-
-        for (PlacementModifier placementModifier : this.placement) {
-            stream = stream.flatMap(blockPos -> placementModifier.getPositions(context, source, blockPos));
-        }
-
         ConfiguredFeature<?, ?> configuredFeature = this.feature.value();
         MutableBoolean mutableBoolean = new MutableBoolean();
-        stream.forEach(blockPos -> {
+        this.papoWalkPositions(context, source, pos, blockPos -> {
             if (configuredFeature.place(context.getLevel(), context.generator(), source, blockPos)) {
                 mutableBoolean.setTrue();
                 if (SharedConstants.DEBUG_FEATURE_COUNT) {
@@ -62,6 +62,45 @@ public record PlacedFeature(Holder<ConfiguredFeature<?, ?>> feature, List<Placem
         return mutableBoolean.isTrue();
     }
 
+    @com.google.common.annotations.VisibleForTesting
+    void papoWalkPositions(PlacementContext context, RandomSource source, BlockPos pos, java.util.function.Consumer<BlockPos> leaf) {
+        PapoPlacementWalk walk = new PapoPlacementWalk(this, context, source, leaf);
+        walk.accept(pos);
+    }
+
+    // One walk object per placement call and zero allocation per emitted position.
+    // forEachPosition emits strictly sequentially, so depth bookkeeping on a single
+    // instance is safe; nested PlacedFeature placements run their own walk.
+    private static final class PapoPlacementWalk implements java.util.function.Consumer<BlockPos> {
+        private final PlacedFeature owner;
+        private final PlacementContext context;
+        private final RandomSource source;
+        private final java.util.function.Consumer<BlockPos> leaf;
+        private int depth;
+
+        PapoPlacementWalk(PlacedFeature owner, PlacementContext context, RandomSource source, java.util.function.Consumer<BlockPos> leaf) {
+            this.owner = owner;
+            this.context = context;
+            this.source = source;
+            this.leaf = leaf;
+        }
+
+        @Override
+        public void accept(BlockPos pos) {
+            if (this.depth == this.owner.placement.size()) {
+                this.leaf.accept(pos);
+            } else {
+                this.depth++;
+                try {
+                    this.owner.placement.get(this.depth - 1).forEachPosition(this.context, this.source, pos, this);
+                } finally {
+                    this.depth--;
+                }
+            }
+        }
+    }
+    // Papo end - batch 176 (R35)
+
     public Stream<ConfiguredFeature<?, ?>> getFeatures() {
