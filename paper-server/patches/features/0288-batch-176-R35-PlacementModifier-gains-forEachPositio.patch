@@ -13,5 +14,19 @@ public abstract class PlacementModifier {
 
     public abstract Stream<BlockPos> getPositions(PlacementContext context, RandomSource random, BlockPos pos);
 
+    // Papo start - batch 176 (R35): allocation-free traversal twin of getPositions.
+    // The only production caller (PlacedFeature.placeWithContext) drives placement
+    // through this method; vanilla modifiers override it with loops emitting the same
+    // positions in the same order while consuming randomness identically (randomness
+    // is always sampled before the first emission, mirroring how the stream forms
+    // build their pipelines eagerly inside getPositions - the driver relies on this
+    // when a multi-emission modifier sits mid-chain). The default keeps subclasses
+    // compiled against the old surface (plugins) working through getPositions.
+    // Implementations must emit strictly sequentially.
+    public void forEachPosition(PlacementContext context, RandomSource random, BlockPos pos, Consumer<BlockPos> emitter) {
+        this.getPositions(context, random, pos).forEach(emitter);
+    }
+    // Papo end - batch 176 (R35)
+
     public abstract PlacementModifierType<?> type();
 }
