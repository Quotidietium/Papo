+++ b/net/minecraft/world/level/levelgen/placement/FixedPlacement.java
@@ -39,6 +39,31 @@ public class FixedPlacement extends PlacementModifier {
         return !flag ? Stream.empty() : this.positions.stream().filter(pos1 -> isSameChunk(sectionPosX, sectionPosZ, pos1));
     }
 
+    // Papo start - batch 176 (R35): two-pass twin - the same-chunk pre-scan first
+    // (no emissions when nothing matches), then emissions in list order
+    @Override
+    public void forEachPosition(PlacementContext context, RandomSource random, BlockPos pos, java.util.function.Consumer<BlockPos> emitter) {
+        int sectionPosX = SectionPos.blockToSectionCoord(pos.getX());
+        int sectionPosZ = SectionPos.blockToSectionCoord(pos.getZ());
+        boolean flag = false;
+        final int positionCount = this.positions.size();
+        for (int i = 0; i < positionCount; i++) {
+            if (isSameChunk(sectionPosX, sectionPosZ, this.positions.get(i))) {
+                flag = true;
+                break;
+            }
+        }
+        if (flag) {
+            for (int i = 0; i < positionCount; i++) {
+                BlockPos blockPos = this.positions.get(i);
+                if (isSameChunk(sectionPosX, sectionPosZ, blockPos)) {
+                    emitter.accept(blockPos);
+                }
+            }
+        }
+    }
+    // Papo end - batch 176 (R35)
+
     private static boolean isSameChunk(int x, int z, BlockPos pos) {
         return x == SectionPos.blockToSectionCoord(pos.getX()) && z == SectionPos.blockToSectionCoord(pos.getZ());
     }
