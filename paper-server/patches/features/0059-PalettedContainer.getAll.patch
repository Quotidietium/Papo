getAll 在区块特征生成期对每个 section 调用并分配 IntArraySet。单值调色板
（常见）只会出现索引 0，直接 accept(valueFor(0)) 一次即可，与 recalcBlockCounts
的 paletteSize==1 特例同理。

diff --git a/net/minecraft/world/level/chunk/PalettedContainer.java b/net/minecraft/world/level/chunk/PalettedContainer.java
index 7c8f8772a6fba04dbafdb5dbf8098b6ebce6d6f2..ffa3921dd3c9afbcc550d0435f3296655b307b12 100644
--- a/net/minecraft/world/level/chunk/PalettedContainer.java
+++ b/net/minecraft/world/level/chunk/PalettedContainer.java
@@ -250,6 +250,13 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
     @Override
     public void getAll(Consumer<T> consumer) {
         Palette<T> palette = this.data.palette();
+        // Papo start - fast path for a single-value palette: only index 0 can appear, so skip
+        // the IntArraySet allocation entirely (mirrors the paletteSize==1 case in recalcBlockCounts).
+        if (palette.getSize() == 1) {
+            consumer.accept(palette.valueFor(0));
+            return;
+        }
+        // Papo end
         IntSet set = new IntArraySet();
         this.data.storage.getAll(set::add);
         set.forEach(id -> consumer.accept(palette.valueFor(id)));
