diff --git a/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index 12f8105d6b12c5d63cb6e5e79435c7fd22655475..e64b7598b80065de8f9510cbed91613646860ac4 100644
--- a/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -38,6 +38,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
     public int cooldownTime = -1;
     private long tickedGameTime;
     private Direction facing;
+    private net.minecraft.world.phys.AABB papoSuckAabb; // Papo - cached moved suck AABB (constant per block entity; see getItemsAtAndAbove)
 
     // CraftBukkit start - add fields and methods
     public List<org.bukkit.entity.HumanEntity> transaction = new java.util.ArrayList<>();
@@ -766,7 +767,20 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
     }
 
     public static List<ItemEntity> getItemsAtAndAbove(Level level, Hopper hopper) {
-        AABB aabb = hopper.getSuckAabb().move(hopper.getLevelX() - 0.5, hopper.getLevelY() - 0.5, hopper.getLevelZ() - 0.5);
+        // Papo start - cache the moved suck AABB on block-entity hoppers: getSuckAabb() is the shared
+        // immutable Hopper.SUCK_AABB constant and a block entity's worldPosition is final (vanilla
+        // cannot move block entities; a setBlock recreates the BE with a fresh cache), so the moved
+        // AABB is constant per block entity. AABB itself is immutable and getEntitiesOfClass only
+        // reads it. Minecart hoppers keep the per-call computation (they move).
+        final AABB aabb;
+        if (hopper instanceof HopperBlockEntity hopperBlockEntity) {
+            aabb = hopperBlockEntity.papoSuckAabb != null
+                ? hopperBlockEntity.papoSuckAabb
+                : (hopperBlockEntity.papoSuckAabb = hopper.getSuckAabb().move(hopper.getLevelX() - 0.5, hopper.getLevelY() - 0.5, hopper.getLevelZ() - 0.5));
+        } else {
+            aabb = hopper.getSuckAabb().move(hopper.getLevelX() - 0.5, hopper.getLevelY() - 0.5, hopper.getLevelZ() - 0.5);
+        }
+        // Papo end
         return level.getEntitiesOfClass(ItemEntity.class, aabb, EntitySelector.ENTITY_STILL_ALIVE);
     }
 
