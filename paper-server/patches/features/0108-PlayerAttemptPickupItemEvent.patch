From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 05:58:06 +0800
Subject: [PATCH] PlayerAttemptPickupItemEvent


diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index e82bb8f2d2b0e771dc371fd7e709116e1f5f204f..d327ffc2e4ccf03961be6df3546e3a3491637875 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -407,10 +407,13 @@ public class ItemEntity extends Entity implements TraceableEntity {
             // CraftBukkit start - fire PlayerPickupItemEvent
             int canHold = entity.getInventory().canHold(item);
             int remaining = count - canHold;
-            boolean flyAtPlayer = false; // Paper
+            boolean flyAtPlayer = true; // Papo fix - PlayerAttemptPickupItemEvent/PlayerPickupItemEvent both default flyAtPlayer=true; the zero-listener fast paths below skip the event blocks that set it, so default true here to preserve the pickup fly animation (entity.take). Any listener combination overwrites this before use.
 
             // Paper start - PlayerAttemptPickupItemEvent
-            if (this.pickupDelay <= 0) {
+            // Papo - skip event allocation+fire when no plugin listens (event has no subclasses,
+            // constructor is side-effect free; with zero listeners flyAtPlayer keeps its true default above (matching the event) and the
+            // event can never be cancelled, so skipping the block is identical).
+            if (this.pickupDelay <= 0 && org.bukkit.event.player.PlayerAttemptPickupItemEvent.getHandlerList().getRegisteredListeners().length > 0) {
                 org.bukkit.event.player.PlayerAttemptPickupItemEvent attemptEvent = new org.bukkit.event.player.PlayerAttemptPickupItemEvent((org.bukkit.entity.Player) entity.getBukkitEntity(), (org.bukkit.entity.Item) this.getBukkitEntity(), remaining);
                 this.level().getCraftServer().getPluginManager().callEvent(attemptEvent);
 
