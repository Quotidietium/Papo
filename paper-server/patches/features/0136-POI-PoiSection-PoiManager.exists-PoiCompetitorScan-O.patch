     public boolean exists(BlockPos pos, Predicate<Holder<PoiType>> typePredicate) {
-        return this.getType(pos).filter(typePredicate).isPresent();
+        // Papo - avoid the Optional chain on this per-tick villager path (ValidateNearbyPoi):
+        // getPoiType is non-null by construction (PoiRecord final field), so
+        // ofNullable(record).map(getPoiType).filter(pred).isPresent() == record != null && pred.test(type).
+        PoiRecord poiRecord = this.records.get(SectionPos.sectionRelativePos(pos));
+        return poiRecord != null && typePredicate.test(poiRecord.getPoiType());
+    }
+
+    // Papo - null-returning variant for hot paths (PoiCompetitorScan): same value as getType, no Optional.
+    public @Nullable Holder<PoiType> getTypeOrNull(BlockPos pos) {
+        PoiRecord poiRecord = this.records.get(SectionPos.sectionRelativePos(pos));
+        return poiRecord != null ? poiRecord.getPoiType() : null;
     }
 
     public Optional<Holder<PoiType>> getType(BlockPos pos) {
