diff --git a/net/minecraft/server/level/ChunkHolder.java b/net/minecraft/server/level/ChunkHolder.java
index 22123d8b0fd8741c6df4efaec56f3c694e0529a3..ca0f36cd52b44c52ec216a7b0eadca72252b39d9 100644
--- a/net/minecraft/server/level/ChunkHolder.java
+++ b/net/minecraft/server/level/ChunkHolder.java
@@ -339,7 +339,13 @@ public class ChunkHolder extends GenerationChunkHolder implements ca.spottedleaf
     }
 
     private void broadcast(List<ServerPlayer> players, Packet<?> packet) {
-        players.forEach(player -> player.connection.send(packet));
+        // Papo - indexed loop instead of forEach(lambda): the lambda captures `packet` (one
+        // allocation per broadcast call). `players` is a fresh local ArrayList built by
+        // moonrise$getPlayers for this call chain, so iteration order and fail-fast
+        // semantics are indistinguishable.
+        for (int papoI = 0, papoSize = players.size(); papoI < papoSize; papoI++) {
+            players.get(papoI).connection.send(packet);
+        }
     }
 
     @Override
