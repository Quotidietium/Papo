diff --git a/net/minecraft/network/PapoSharedWireMemo.java b/net/minecraft/network/PapoSharedWireMemo.java
new file mode 100644
index 0000000000000000000000000000000000000000..c54f090366c3bc695d2b6057ecee6a948a8640a9
--- /dev/null
+++ b/net/minecraft/network/PapoSharedWireMemo.java
@@ -0,0 +1,88 @@
+package net.minecraft.network;
+
+import io.netty.util.AttributeKey;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Papo - shared wire-compression memo for multi-viewer packets.
+ *
+ * When the same immutable packet instance is sent to several connections (chunk sends to a group of
+ * players, see {@code ClientboundLevelChunkWithLightPacket.papoCreateCached}), every connection
+ * serialises identical bytes and then DEFLATE-compresses those identical bytes independently -
+ * for a chunk packet that is the dominant per-viewer cost. This memo lets the compression stage
+ * reuse the segment ([data-length varint][compressed payload]) produced by the first connection
+ * that compressed this packet instance.
+ *
+ * Correctness: the segment is self-describing (it carries the uncompressed length itself) and is
+ * produced by the very same deflate call the fallback path performs, so hit and miss paths emit
+ * identical bytes. The compression level is not part of the protocol (any zlib stream decodes
+ * regardless of the level that produced it); the level epoch still invalidates memos across level
+ * re-configurations so served bytes match what this configuration would produce. Racing fills can
+ * interleave stamps from different thresholds, but any resulting segment still frames the same
+ * uncompressed length (same packet content) and decodes to the same payload.
+ *
+ * Visibility: {@link #papoSegment} is volatile and written only after its contents are fully
+ * initialised; the stamp fields are written before the segment, so a reader that observes a
+ * non-null segment with a matching stamp observes a complete snapshot (JMM happens-before via the
+ * volatile segment store). Multiple event-loop threads may encode the same shared packet
+ * concurrently; every access is a read or a single reference store, so no locking is needed.
+ */
+public final class PapoSharedWireMemo {
+    /** Published by PacketEncoder alongside the headroom marker; consumed by CompressionEncoder. */
+    static final AttributeKey<PapoSharedWireMemo> ATTR = AttributeKey.valueOf("papo.sharedWireMemo");
+
+    /**
+     * Bumped by Connection.setupCompression whenever a compressor is created for a level different
+     * from the previous one (setup runs per connection; identical levels must not churn the epoch
+     * or memos would never hit).
+     */
+    private static final AtomicLong PAPO_LEVEL_EPOCH = new AtomicLong();
+    private static final AtomicInteger PAPO_LAST_LEVEL = new AtomicInteger(Integer.MIN_VALUE);
+
+    private volatile int papoThreshold = -1;
+    private volatile long papoLevelEpoch;
+    private volatile byte @Nullable [] papoSegment;
+
+    private PapoSharedWireMemo() {
+    }
+
+    public static PapoSharedWireMemo papoCreate() {
+        return new PapoSharedWireMemo();
+    }
+
+    static void papoStampLevel(int level) {
+        if (PAPO_LAST_LEVEL.getAndSet(level) != level) {
+            PAPO_LEVEL_EPOCH.incrementAndGet();
+        }
+    }
+
+    static long papoLevelEpoch() {
+        return PAPO_LEVEL_EPOCH.get();
+    }
+
+    /** Returns the memo'd segment when it was produced for the given threshold and current level epoch. */
+    public byte @Nullable [] papoSegmentFor(int threshold) {
+        if (this.papoThreshold != threshold || this.papoLevelEpoch != papoLevelEpoch()) {
+            return null;
+        }
+        return this.papoSegment;
+    }
+
+    /** Stores the segment produced for the given threshold; first writer for a stamp wins. */
+    public void papoStore(int threshold, byte[] segment) {
+        long epoch = papoLevelEpoch();
+        if (this.papoSegment == null || this.papoThreshold != threshold || this.papoLevelEpoch != epoch) {
+            this.papoThreshold = threshold;
+            this.papoLevelEpoch = epoch;
+            this.papoSegment = segment; // volatile store publishes the stamp + fully-initialised array
+        }
+    }
+
+    /** Implemented by packet instances that can carry a shared compression memo. */
+    public interface Carrier {
+        @Nullable
+        PapoSharedWireMemo papoWireMemo();
+    }
+}
