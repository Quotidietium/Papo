+    // Papo start - shared chunk packet for multi-viewer sends
+    // papoLightVersion counts light-section change notifications (sectionLightChanged, fed by the
+    // light engine's onLightUpdate which is the same signal vanilla's incremental light broadcast
+    // depends on - both the vanilla LayerLightSectionStorage and moonrise's StarLightEngine route
+    // every changed section through ServerChunkCache.onLightUpdate onto the main thread).
+    //
+    // While (chunk data version, light version) are unchanged and the chunk has no block entities,
+    // the full chunk-with-light packet is a pure function of that state: the SAME packet instance
+    // is returned to every viewer (FeatureHooks.sendChunkRefreshPackets established packet-instance
+    // sharing across players). Block entity presence is pinned by the chunk data version (BE
+    // add/remove bumps it) - empty-at-publish stays empty until invalidation, and BE-free chunks
+    // have no per-viewer content to go stale. Light staleness window: a light write on a scheduler
+    // thread whose notification is still queued means a shared packet can embed slightly older
+    // light than a fresh construction would read; the pending notification marks this holder's
+    // broadcast filters and the incremental ClientboundLightUpdatePacket corrects the new viewer
+    // within the same tick (vanilla's own mechanism), so no persistent desync is possible.
+    //
+    // The shared packet carries a wire-compression memo (see PapoSharedWireMemo): identical
+    // per-viewer bytes need only be DEFLATE-compressed once per packet instance.
+    // All reads/writes happen on the main thread (chunk sends are main-thread driven).
+    private long papoLightVersion;
+    private ClientboundLevelChunkWithLightPacket papoSharedChunkPacket;
+    private long papoSharedChunkPacketDataVersion = Long.MIN_VALUE;
+    private long papoSharedChunkPacketLightVersion = Long.MIN_VALUE;
+
+    void papoBumpLightVersion() {
+        this.papoLightVersion++;
+    }
+
+    public ClientboundLevelChunkWithLightPacket papoGetSharedChunkPacket(LevelChunk chunk, LevelLightEngine lightEngine) {
+        ClientboundLevelChunkWithLightPacket cached = this.papoSharedChunkPacket;
+        long chunkDataVersion = chunk.papoChunkDataVersion();
+        if (cached != null
+            && this.papoSharedChunkPacketDataVersion == chunkDataVersion
+            && this.papoSharedChunkPacketLightVersion == this.papoLightVersion) {
+            return cached;
+        }
+
+        ChunkPos pos = chunk.getPos();
+        net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData data;
+        if (chunk.papoChunkPacketCacheValid()) {
+            data = new net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData(
+                chunk.papoPacketHeightmapsCache(), chunk.papoPacketBufferCache(), chunk);
+        } else {
+            data = new net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData(chunk, null);
+            chunk.papoStoreChunkPacketCache(data.getHeightmaps(), data.papoSerializedBuffer());
+        }
+
+        ClientboundLevelChunkWithLightPacket packet = new ClientboundLevelChunkWithLightPacket(
+            pos.x, pos.z, data,
+            new net.minecraft.network.protocol.game.ClientboundLightUpdatePacketData(pos, lightEngine, null, null));
+        if (chunk.getBlockEntities().isEmpty()) {
+            packet.papoEnableWireMemo();
+            this.papoSharedChunkPacket = packet;
+            this.papoSharedChunkPacketDataVersion = chunkDataVersion;
+            this.papoSharedChunkPacketLightVersion = this.papoLightVersion;
+        }
+        return packet;
+    }
+    // Papo end - shared chunk packet for multi-viewer sends
