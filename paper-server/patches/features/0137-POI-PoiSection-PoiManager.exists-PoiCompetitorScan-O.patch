diff --git a/net/minecraft/world/entity/ai/behavior/PoiCompetitorScan.java b/net/minecraft/world/entity/ai/behavior/PoiCompetitorScan.java
index 9b595322b21b83d38886d515a3b8dd04cde43cea..8fda82bdc63714e0a31a83dabcec6980424cc94b 100644
--- a/net/minecraft/world/entity/ai/behavior/PoiCompetitorScan.java
+++ b/net/minecraft/world/entity/ai/behavior/PoiCompetitorScan.java
@@ -19,36 +19,37 @@ public class PoiCompetitorScan {
                     instance,
                     (jobSite, nearestLivingEntities) -> (level, villager, gameTime) -> {
                         GlobalPos globalPos = instance.get(jobSite);
-                        level.getPoiManager()
-                            .getType(globalPos.pos())
-                            .ifPresent(
-                                // Paper start - Improve performance of PoiCompetitorScan by unrolling stream
-                                // The previous logic used Stream#reduce to simulate a form of single-iteration bubble sort
-                                // in which the "winning" villager would maintain MemoryModuleType.JOB_SITE while all others
-                                // would lose said memory module type by passing each "current winner" and incoming next
-                                // villager to #selectWinner.
-                                poi -> {
-                                    final List<LivingEntity> livingEntities = instance.get(nearestLivingEntities);
+                        // Papo start - avoid the Optional chain + capturing ifPresent lambda on this
+                        // per-tick villager CORE behavior: getTypeOrNull returns the same Holder or null;
+                        // the body runs iff non-null, exactly like ifPresent.
+                        Holder<PoiType> poi = level.getPoiManager().getTypeOrNull(globalPos.pos());
+                        if (poi != null) {
+                            // Paper start - Improve performance of PoiCompetitorScan by unrolling stream
+                            // The previous logic used Stream#reduce to simulate a form of single-iteration bubble sort
+                            // in which the "winning" villager would maintain MemoryModuleType.JOB_SITE while all others
+                            // would lose said memory module type by passing each "current winner" and incoming next
+                            // villager to #selectWinner.
+                            final List<LivingEntity> livingEntities = instance.get(nearestLivingEntities);
 
-                                    Villager winner = villager;
-                                    for (final LivingEntity other : livingEntities) {
-                                        if (other == villager) {
-                                            continue;
-                                        }
-                                        if (!(other instanceof final net.minecraft.world.entity.npc.villager.Villager otherVillager)) {
-                                            continue;
-                                        }
-                                        if (!other.isAlive()) {
-                                            continue;
-                                        }
-                                        if (!competesForSameJobsite(globalPos, poi, otherVillager)) {
-                                            continue;
-                                        }
-                                        winner = selectWinner(winner, otherVillager);
-                                    }
+                            Villager winner = villager;
+                            for (final LivingEntity other : livingEntities) {
+                                if (other == villager) {
+                                    continue;
                                 }
-                                // Paper end - Improve performance of PoiCompetitorScan by unrolling stream
-                            );
+                                if (!(other instanceof final net.minecraft.world.entity.npc.villager.Villager otherVillager)) {
+                                    continue;
+                                }
+                                if (!other.isAlive()) {
+                                    continue;
+                                }
+                                if (!competesForSameJobsite(globalPos, poi, otherVillager)) {
+                                    continue;
+                                }
+                                winner = selectWinner(winner, otherVillager);
+                            }
+                            // Paper end - Improve performance of PoiCompetitorScan by unrolling stream
+                        }
+                        // Papo end
                         return true;
                     }
                 )
diff --git a/net/minecraft/world/entity/ai/village/poi/PoiManager.java b/net/minecraft/world/entity/ai/village/poi/PoiManager.java
index 95fa0d9487542ba5308c60d29095efa6c90e86d6..e639d239d0d747601022f678af25d8faf2d35aef 100644
--- a/net/minecraft/world/entity/ai/village/poi/PoiManager.java
+++ b/net/minecraft/world/entity/ai/village/poi/PoiManager.java
@@ -335,7 +335,15 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
     }
 
     public boolean exists(BlockPos pos, Predicate<Holder<PoiType>> typePredicate) {
-        return this.getOrLoad(SectionPos.asLong(pos)).map(poiSection -> poiSection.exists(pos, typePredicate)).orElse(false);
+        // Papo - avoid the map Optional on this per-tick villager path (ValidateNearbyPoi)
+        Optional<PoiSection> poiSection = this.getOrLoad(SectionPos.asLong(pos));
+        return poiSection.isPresent() && poiSection.get().exists(pos, typePredicate);
+    }
+
+    // Papo - null-returning variant for hot paths (PoiCompetitorScan): same value as getType, no Optional chain.
+    public @Nullable Holder<PoiType> getTypeOrNull(BlockPos pos) {
+        Optional<PoiSection> poiSection = this.getOrLoad(SectionPos.asLong(pos));
+        return poiSection.isPresent() ? poiSection.get().getTypeOrNull(pos) : null;
     }
 
     public Optional<Holder<PoiType>> getType(BlockPos pos) {
diff --git a/net/minecraft/world/entity/ai/village/poi/PoiSection.java b/net/minecraft/world/entity/ai/village/poi/PoiSection.java
index 49cbdd80057250c37464ca5f5dd39a20dbaa9f2c..aa3a114950f00c8135c93f73ba81fee706cc5c5f 100644
--- a/net/minecraft/world/entity/ai/village/poi/PoiSection.java
+++ b/net/minecraft/world/entity/ai/village/poi/PoiSection.java
@@ -127,7 +127,17 @@ public class PoiSection implements ca.spottedleaf.moonrise.patches.chunk_system.
     }
 
     public boolean exists(BlockPos pos, Predicate<Holder<PoiType>> typePredicate) {
-        return this.getType(pos).filter(typePredicate).isPresent();
+        // Papo - avoid the Optional chain on this per-tick villager path (ValidateNearbyPoi):
+        // getPoiType is non-null by construction (PoiRecord final field), so
+        // ofNullable(record).map(getPoiType).filter(pred).isPresent() == record != null && pred.test(type).
+        PoiRecord poiRecord = this.records.get(SectionPos.sectionRelativePos(pos));
+        return poiRecord != null && typePredicate.test(poiRecord.getPoiType());
+    }
+
+    // Papo - null-returning variant for hot paths (PoiCompetitorScan): same value as getType, no Optional.
+    public @Nullable Holder<PoiType> getTypeOrNull(BlockPos pos) {
+        PoiRecord poiRecord = this.records.get(SectionPos.sectionRelativePos(pos));
+        return poiRecord != null ? poiRecord.getPoiType() : null;
     }
 
     public Optional<Holder<PoiType>> getType(BlockPos pos) {
