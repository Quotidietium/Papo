From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Sat, 1 Aug 2026 05:36:39 +0800
Subject: [PATCH] Papo knockback vec3 inline


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 5891aa42e6f22cb68ae9f145d499928cd767302f..354ffa032c9d40d4c47ab67b7ff7bf69afcb2b0d 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2110,12 +2110,19 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 z = (this.random.nextDouble() - this.random.nextDouble()) * 0.01;
             }
 
-            Vec3 vec3 = new Vec3(x, 0.0, z).normalize().scale(strength);
+            // Papo - skip the three intermediate Vec3 (new/normalize/scale): only the x/z components of the
+            // scaled normal are read below, so compute them inline with the identical FP op chain. The while
+            // loop above guarantees !(x*x + z*z < 1.0E-5F), hence len >= sqrt(1.0E-5F) and normalize's
+            // squareRoot < 1.0E-5F branch can never trigger; normalize's sum x*x + 0.0*0.0 + z*z equals
+            // x*x + z*z exactly (x*x is +0.0 or positive, adding +0.0 is the identity).
+            double papoKbLen = Math.sqrt(x * x + z * z);
+            double papoKbX = x / papoKbLen * strength;
+            double papoKbZ = z / papoKbLen * strength;
             // Paper start - knockback events
             Vec3 finalVelocity = new Vec3(
-                deltaMovement.x / 2.0 - vec3.x,
+                deltaMovement.x / 2.0 - papoKbX,
                 this.onGround() ? Math.min(0.4, deltaMovement.y / 2.0 + strength) : deltaMovement.y,
-                deltaMovement.z / 2.0 - vec3.z
+                deltaMovement.z / 2.0 - papoKbZ
             );
             Vec3 diff = finalVelocity.subtract(deltaMovement);
             io.papermc.paper.event.entity.EntityKnockbackEvent event = CraftEventFactory.callEntityKnockbackEvent((org.bukkit.craftbukkit.entity.CraftLivingEntity) this.getBukkitEntity(), attacker, attacker, eventCause, strength, diff);
