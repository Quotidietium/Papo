@@ -40,7 +40,7 @@ public class ResultSlot extends Slot {
         this.removeCount += amount;
         this.checkTakeAchievements(stack);
         // Paper start - add ItemCraftedEvent
-        if (!stack.isEmpty()) {
+        if (!stack.isEmpty() && io.papermc.paper.event.inventory.ItemCraftedEvent.getHandlerList().getRegisteredListeners().length > 0) { // Papo - zero-listener gate
