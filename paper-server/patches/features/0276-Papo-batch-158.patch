+    // Papo start - batch 158 (R18): frozen-shell canonical sharing. The steady state is
+    // dominated by nibble SHELLS that are born into a chunk's section table and never
+    // written again (batch 157 soak census: 539,188 SWMRNibbleArray instances vs ~30k
+    // materialised byte[2048] payloads) - getFilledEmptyLight fills every section of
+    // every chunk with the identical NULL-state shell, and SaveUtil reloads null-data
+    // sections as NULL/UNINIT shells. Two immutable singletons replace those births.
+    // Every mutating method carries a loud identity canary so a missed copy-on-write
+    // call site fails fast instead of silently corrupting light across every chunk
+    // sharing the shell; the read surface (get*/isDirty/getSaveState/toVanillaNibble/
+    // updateVisible) is value-identical on the shared instances because the frozen
+    // fields are exactly the constructor outputs and never dirty.
+    public static final SWMRNibbleArray PAPO_SHARED_NULL = new SWMRNibbleArray(null, true);
+    public static final SWMRNibbleArray PAPO_SHARED_UNINIT = new SWMRNibbleArray();
+    // PAPO_SHARED_INIT_FULL (full-bright settled sky sections) is declared next to
+    // LONG_VIEW further down: its birth runs the all-full canonicalisation, which needs
+    // the VarHandle - static initialisers run in textual order.
+
+    public final boolean papoIsShared() {
+        return this == PAPO_SHARED_NULL || this == PAPO_SHARED_UNINIT || this == PAPO_SHARED_INIT_FULL;
+    }
+
+    // the private replacement for a frozen shell - a fresh birth with identical semantics
+    public final SWMRNibbleArray papoClonePrivate() {
+        if (this == PAPO_SHARED_NULL) {
+            return new SWMRNibbleArray(null, true);
+        }
+        if (this == PAPO_SHARED_INIT_FULL) {
+            return new SWMRNibbleArray(PAPO_FULL_TEMPLATE, INIT_STATE_INIT);
+        }
+        return new SWMRNibbleArray();
+    }
+
+    // Papo start - batch 158 (R18): settle-swap probe. A published, clean nibble whose
+    // every observable field equals a shared singleton (exact state value included, so
+    // isNull/isUninitialised/isInitialised predicates are preserved bit-for-bit) can be
+    // replaced by that singleton in its holders; the private instance is then garbage.
+    // INIT-uniform-0 and HIDDEN-uniform-{0,15} deliberately have NO singleton: the
+    // former reads isInitialised*() true where UNINIT reads false, the latter converts
+    // to null in vanilla views - engine logic branches on exactly these differences.
+    // Single-writer context only (the light thread's updateVisible epilogues).
+    public SWMRNibbleArray papoFrozenEquivalent() {
+        if (this.papoIsShared()) {
+            return this;
+        }
+        if (this.updatingDirty || this.stateUpdating != this.stateVisible
+                || this.storageUpdating != null || this.storageVisible != null) {
+            return null;
+        }
+        final int state = this.stateUpdating;
+        if (this.updatingUniform == 0 && this.visibleUniform == 0) {
+            if (state == INIT_STATE_NULL) {
+                return PAPO_SHARED_NULL;
+            }
+            if (state == INIT_STATE_UNINIT) {
+                return PAPO_SHARED_UNINIT;
+            }
+            return null;
+        }
+        if (this.updatingUniform == 15 && this.visibleUniform == 15 && state == INIT_STATE_INIT) {
+            return PAPO_SHARED_INIT_FULL;
+        }
+        return null;
+    }
+    // Papo end - batch 158 (R18)
+
+    // save/load birth: null-data sections on disk are exactly NULL/UNINIT (getSaveState
+    // materialises uniform payloads and never writes null-data INIT/HIDDEN), so they map
+    // to the singletons; an all-full payload with state INIT is the round-trip of the
+    // full-bright singleton (save materialises it, the constructor would canonicalise
+    // it back to a private) - map it to the singleton directly; malformed tags keep
+    // today's constructor validation
+    public static SWMRNibbleArray papoFromSave(final byte[] bytes, final int state) {
+        if (bytes == null && state == INIT_STATE_NULL) {
+            return PAPO_SHARED_NULL;
+        }
+        if (bytes == null && state == INIT_STATE_UNINIT) {
+            return PAPO_SHARED_UNINIT;
+        }
+        if (bytes != null && state == INIT_STATE_INIT && isAllFull(bytes)) {
+            return PAPO_SHARED_INIT_FULL;
+        }
+        return new SWMRNibbleArray(bytes, state);
+    }
+
+    private void papoCheckMutable() {
+        if (this.papoIsShared()) {
+            throw new IllegalStateException("Papo: attempt to mutate a shared canonical SWMRNibbleArray - a copy-on-write site was missed (batch 158)");
+        }
+    }
+    // Papo end - batch 158 (R18)
+
