diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 2f147bc9ce780af4dce355081a92059ddf731863..3af86fd0afd9dd115d4a36227bea8c2b118d2e61 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -342,6 +342,14 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     public static final int MAX_MOVEMENTS_HANDELED_PER_TICK = 100;
     private final ArrayDeque<Entity.Movement> movementThisTick = new ArrayDeque<>(100);
     private final List<Entity.Movement> finalMovementsThisTick = new ObjectArrayList<>();
+    // Papo - cached fallback Movement for applyEffectsFromBlocks() + its six component keys (see usage)
+    private Entity.Movement papoFallbackMovement;
+    private double papoFallbackMovementKeyXOld;
+    private double papoFallbackMovementKeyYOld;
+    private double papoFallbackMovementKeyZOld;
+    private double papoFallbackMovementKeyX;
+    private double papoFallbackMovementKeyY;
+    private double papoFallbackMovementKeyZ;
     private final LongSet visitedBlocks = new LongOpenHashSet();
     private final InsideBlockEffectApplier.StepBasedCollector insideEffectCollector = new InsideBlockEffectApplier.StepBasedCollector();
     private CustomData customData = CustomData.EMPTY;
@@ -1313,7 +1321,27 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
         this.finalMovementsThisTick.addAll(this.movementThisTick);
         this.movementThisTick.clear();
         if (this.finalMovementsThisTick.isEmpty()) {
-            this.finalMovementsThisTick.add(new Entity.Movement(this.oldPosition(), this.position()));
+            // Papo - cache the fallback Movement: it is a pure function of (xOld,yOld,zOld,x,y,z) and
+            // is consumed read-only inside the private applyEffectsFromBlocks(List) path (the list is
+            // cleared and rebuilt every tick), so component-keyed reuse is observably identical.
+            // Double.compare keeps -0.0/+0.0 distinct; NaN keys compare equal, which is still safe —
+            // NaN payloads are unobservable through the FP component reads downstream.
+            if (this.papoFallbackMovement == null
+                || Double.compare(this.papoFallbackMovementKeyXOld, this.xOld) != 0
+                || Double.compare(this.papoFallbackMovementKeyYOld, this.yOld) != 0
+                || Double.compare(this.papoFallbackMovementKeyZOld, this.zOld) != 0
+                || Double.compare(this.papoFallbackMovementKeyX, this.position.x) != 0
+                || Double.compare(this.papoFallbackMovementKeyY, this.position.y) != 0
+                || Double.compare(this.papoFallbackMovementKeyZ, this.position.z) != 0) {
+                this.papoFallbackMovement = new Entity.Movement(this.oldPosition(), this.position());
+                this.papoFallbackMovementKeyXOld = this.xOld;
+                this.papoFallbackMovementKeyYOld = this.yOld;
+                this.papoFallbackMovementKeyZOld = this.zOld;
+                this.papoFallbackMovementKeyX = this.position.x;
+                this.papoFallbackMovementKeyY = this.position.y;
+                this.papoFallbackMovementKeyZ = this.position.z;
+            }
+            this.finalMovementsThisTick.add(this.papoFallbackMovement);
         } else if (this.finalMovementsThisTick.getLast().to.distanceToSqr(this.position()) > 9.9999994E-11F) {
             this.finalMovementsThisTick.add(new Entity.Movement(this.finalMovementsThisTick.getLast().to, this.position()));
         }
