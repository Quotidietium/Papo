+    // Papo start - batch 160 (R20): periodic release of NoiseChunk trees retained by chunks
+    // parked below the CARVERS step. Batch 143 already releases at the carvers exit (the last
+    // noiseChunk reader), but the pre-carver status ring - chunks generated to BIOMES/NOISE/
+    // SURFACE and then parked waiting on neighbour dependencies, or parked after cancelled
+    // generation - never passes that hook, so each keeps its whole per-chunk worldgen cache
+    // (~36KB: interpolator slices, mapped density subtree, aquifer) for the holder lifetime.
+    // Measured at 12 bots / vd10 steady state: 318 live NoiseChunk trees / ~11.4MB; the mass
+    // scales with the pre-carver ring perimeter, not the loaded area. The sweep nulls the
+    // field on parked ProtoChunks; behaviour-neutrality (recreation identity, race safety)
+    // is proven in ChunkAccess#papoReleaseParkedNoiseChunk. Cadence 2048 game ticks (~102s):
+    // gen rings settle within seconds of movement, so this bounds residency to one window.
+    // ImposterProtoChunk is excluded: it wraps an already-finished LevelChunk and its own
+    // inherited field is never populated. Main-thread only, like the batch 141 sweep.
+    // -Dpapo.noiseParkSweepTicks=N overrides the cadence for diagnosis (<=0 disables the
+    // sweep, reproducing the pre-160 residency behaviour on the same binary).
+    private static final long PAPO_NOISE_PARK_SWEEP_TICKS = Long.getLong("papo.noiseParkSweepTicks", 2048L);
+    private long papoNextNoiseParkSweepGameTime = Long.MIN_VALUE;
+
+    private void papoReleaseParkedNoiseChunks() {
+        if (PAPO_NOISE_PARK_SWEEP_TICKS <= 0) {
+            return; // sweep disabled (diagnostic leg)
+        }
+        final long now = this.level.getGameTime();
+        if (now < this.papoNextNoiseParkSweepGameTime) {
+            return;
+        }
+        this.papoNextNoiseParkSweepGameTime = now + PAPO_NOISE_PARK_SWEEP_TICKS;
+        for (final ChunkHolder holder : ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.level)
+            .moonrise$getChunkTaskScheduler().chunkHolderManager.getOldChunkHoldersIterable()) {
+            final net.minecraft.world.level.chunk.ChunkAccess chunk = ((ca.spottedleaf.moonrise.patches.chunk_system.level.chunk.ChunkSystemChunkHolder)(Object)holder)
+                .moonrise$getRealChunkHolder().getCurrentChunk();
+            if (chunk instanceof net.minecraft.world.level.chunk.ProtoChunk
+                && !(chunk instanceof net.minecraft.world.level.chunk.ImposterProtoChunk)) {
+                chunk.papoReleaseParkedNoiseChunk();
+            }
+        }
+    }
+    // Papo end - batch 160 (R20)
+
