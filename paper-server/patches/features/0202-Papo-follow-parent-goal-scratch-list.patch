+            List<Animal> entitiesOfClass = this.papoFollowParentScratch;
+            if (entitiesOfClass == null) {
+                entitiesOfClass = this.papoFollowParentScratch = new java.util.ArrayList<>();
+            } else {
+                entitiesOfClass.clear();
+            }
+            this.animal.level().getEntities(
