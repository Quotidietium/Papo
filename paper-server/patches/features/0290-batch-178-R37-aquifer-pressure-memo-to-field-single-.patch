diff --git a/net/minecraft/world/level/levelgen/PapoContextScratch.java b/net/minecraft/world/level/levelgen/PapoContextScratch.java
new file mode 100644
index 0000000000000000000000000000000000000000..06f7c579996328bebe1191193e2cab1d06d2da13
--- /dev/null
+++ b/net/minecraft/world/level/levelgen/PapoContextScratch.java
@@ -0,0 +1,57 @@
+package net.minecraft.world.level.levelgen;
+
+// Papo start - batch 178 (R37): thread-local mutable stand-in for
+// DensityFunction.SinglePointContext.
+//
+// Both construction sites of that record are per-position synchronous calls:
+//  - Climate.Sampler.sample(x, y, z) builds one context per biome sample and
+//    passes it to the six climate density functions' compute(context);
+//  - WorldCarver.getCarveState builds one per carved block and passes it to
+//    aquifer.computeSubstance(context, 0.0) (which forwards it into
+//    barrierNoise.compute(context) inside calculatePressure).
+// Every consumer reads blockX/blockY/blockZ only (coordinate-read-only queries
+// - the same property the block-predicate scratch of batch 177 relies on);
+// no code in the codebase performs instanceof/equals/hashCode on a
+// FunctionContext, and the context never outlives its constructing frame, so a
+// reused mutable holder is unobservable. Reentrancy is impossible: no density
+// function compute calls back into Climate.Sampler.sample or a carver, so at
+// most one live context per thread exists at any time.
+public final class PapoContextScratch {
+    private PapoContextScratch() {}
+
+    private static final ThreadLocal<Holder> HOLDER = ThreadLocal.withInitial(Holder::new);
+
+    static final class Holder implements DensityFunction.FunctionContext {
+        private int x;
+        private int y;
+        private int z;
+
+        void set(int x, int y, int z) {
+            this.x = x;
+            this.y = y;
+            this.z = z;
+        }
+
+        @Override
+        public int blockX() {
+            return this.x;
+        }
+
+        @Override
+        public int blockY() {
+            return this.y;
+        }
+
+        @Override
+        public int blockZ() {
+            return this.z;
+        }
+    }
+
+    public static DensityFunction.FunctionContext singlePoint(int x, int y, int z) {
+        Holder holder = HOLDER.get();
+        holder.set(x, y, z);
+        return holder;
+    }
+}
+// Papo end - batch 178 (R37)
