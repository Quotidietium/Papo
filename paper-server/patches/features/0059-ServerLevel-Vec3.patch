     @Override
     public void globalLevelEvent(int id, BlockPos pos, int data) {
         if (this.getGameRules().get(GameRules.GLOBAL_SOUND_EVENTS)) {
+            // Papo start - hoist the constant center Vec3 out of the per-player loop
+            final Vec3 vec3 = Vec3.atCenterOf(pos);
             this.server.getPlayerList().getPlayers().forEach(player -> {
                 Vec3 vec31;
                 if (player.level() == this) {
-                    Vec3 vec3 = Vec3.atCenterOf(pos);
                     if (player.distanceToSqr(vec3) < Mth.square(32)) {
                         vec31 = vec3;
                     } else {
@@ -2131,7 +2132,9 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
             return false;
         } else {
             BlockPos blockPos = player.blockPosition();
-            if (blockPos.closerToCenterThan(new Vec3(x, y, z), overrideLimiter ? 512.0 : 32.0)) {
