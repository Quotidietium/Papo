+            AABB aabb = papoPickRadius == 0.0F ? entity1.getBoundingBox() : entity1.getBoundingBox().inflate(papoPickRadius);
             Optional<Vec3> optional = aabb.clip(startVec, endVec);
             if (aabb.contains(startVec)) {
