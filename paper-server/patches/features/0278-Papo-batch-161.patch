             LOGGER.error("Chunk at {} contains duplicated block entities", chunk.getPos());
         }
 
@@ -581,7 +581,7 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
         // CraftBukkit start
         BlockEntity blockEntity = this.level.capturedTileEntities.get(pos);
         if (blockEntity == null) {
-            blockEntity = this.blockEntities.get(pos);
+            blockEntity = this.papoBlockEntitiesView().get(pos); // Papo - batch 161 (R20): null == empty
         }
         // CraftBukkit end
         if (blockEntity == null) {
@@ -602,7 +602,9 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
                 }
             }
         } else if (blockEntity.isRemoved()) {
-            this.blockEntities.remove(pos);
+            if (this.blockEntities != null) { // Papo - batch 161 (R20): null == empty
+                this.blockEntities.remove(pos);
+            }
             return null;
         }
 
@@ -662,7 +664,7 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
 
             blockEntity.setLevel(this.level);
             blockEntity.clearRemoved();
-            BlockEntity blockEntity1 = this.blockEntities.put(blockPos.immutable(), blockEntity);
+            BlockEntity blockEntity1 = this.papoBlockEntitiesWritable().put(blockPos.immutable(), blockEntity); // Papo - batch 161 (R20): lazy alloc
             if (blockEntity1 != null && blockEntity1 != blockEntity) {
                 blockEntity1.setRemoved();
             }
@@ -700,7 +702,7 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
     public void removeBlockEntity(BlockPos pos) {
         this.papoBumpChunkDataVersion(); // Papo - serialized chunk payload changed (block entity set; over-bump is safe)
         if (this.isInLevel()) {
-            BlockEntity blockEntity = this.blockEntities.remove(pos);
+            BlockEntity blockEntity = this.blockEntities == null ? null : this.blockEntities.remove(pos); // Papo - batch 161 (R20): null == empty
             // CraftBukkit start - SPIGOT-5561: Also remove from pending map
             if (!this.pendingBlockEntities.isEmpty()) {
                 this.pendingBlockEntities.remove(pos);
@@ -876,7 +878,7 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
     }
 
     public Map<BlockPos, BlockEntity> getBlockEntities() {
-        return this.blockEntities;
+        return this.papoBlockEntitiesView(); // Papo - batch 161 (R20): audited read-only callers; empty view when unallocated
     }
 
     public void postProcessGeneration(ServerLevel level) {
@@ -993,14 +995,16 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
     }
 
     public void clearAllBlockEntities() {
-        this.blockEntities.values().forEach(BlockEntity::setRemoved);
-        this.blockEntities.clear();
+        this.papoBlockEntitiesView().values().forEach(BlockEntity::setRemoved); // Papo - batch 161 (R20): null == empty
+        if (this.blockEntities != null) {
+            this.blockEntities.clear();
+        }
         this.tickersInLevel.values().forEach(ticker -> ticker.rebind(NULL_TICKER));
         this.tickersInLevel.clear();
     }
 
     public void registerAllBlockEntitiesAfterLevelLoad() {
-        this.blockEntities.values().forEach(blockEntity -> {
+        this.papoBlockEntitiesView().values().forEach(blockEntity -> { // Papo - batch 161 (R20): null == empty
             if (this.level instanceof ServerLevel serverLevel) {
                 this.addGameEventListener(blockEntity, serverLevel);
             }
