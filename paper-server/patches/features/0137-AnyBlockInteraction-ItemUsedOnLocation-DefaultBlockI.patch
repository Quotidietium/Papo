         return AnyBlockInteractionTrigger.TriggerInstance.CODEC;
     }
 
+    // Papo - public gate so call sites can skip the eager ItemStack.copy that only serves the TOOL parameter
+    public boolean papoHasListeners(ServerPlayer player) {
+        return this.hasListeners(player);
+    }
+
     public void trigger(ServerPlayer player, BlockPos pos, ItemStack stack) {
-        ServerLevel serverLevel = player.level();
-        BlockState blockState = serverLevel.getBlockState(pos);
+        if (!this.hasListeners(player)) return; // Papo - skip eager LootParams/LootContext build when nobody listens (0086 pattern)
+        ServerLevel serverLevel = player.level();        BlockState blockState = serverLevel.getBlockState(pos);
         LootParams lootParams = new LootParams.Builder(serverLevel)
             .withParameter(LootContextParams.ORIGIN, pos.getCenter())
             .withParameter(LootContextParams.THIS_ENTITY, player)
