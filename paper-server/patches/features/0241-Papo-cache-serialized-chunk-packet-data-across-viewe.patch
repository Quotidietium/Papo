+    // Papo start - multi-viewer chunk packet data cache (see ClientboundLevelChunkWithLightPacket.papoCreateCached)
+    // papoChunkDataVersion is bumped on every mutation that changes the serialized chunk packet
+    // payload: block states + heightmaps (setBlockState), the block entity set (setBlockEntity /
+    // removeBlockEntity) and biomes (setBiome). While the version is unchanged the serialized
+    // heightmaps/buffer are shared across viewers; block entity tags and light data are rebuilt
+    // fresh per packet (their content changes do not bump any chunk-level signal). Cache reads and
+    // writes only happen on the main thread (chunk sends are main-thread); the AtomicLong covers
+    // worldgen-thread setBlockState calls on an imposter-wrapped chunk before it becomes full.
+    private final java.util.concurrent.atomic.AtomicLong papoChunkDataVersion = new java.util.concurrent.atomic.AtomicLong();
+    private long papoChunkPacketCacheVersion = Long.MIN_VALUE;
+    private Map<Heightmap.Types, long[]> papoPacketHeightmapsCache;
+    private byte[] papoPacketBufferCache;
+
+    public void papoBumpChunkDataVersion() {
+        this.papoChunkDataVersion.getAndIncrement();
+    }
+
+    public boolean papoChunkPacketCacheValid() {
+        return this.papoPacketBufferCache != null && this.papoChunkPacketCacheVersion == this.papoChunkDataVersion.get();
+    }
+
+    public void papoStoreChunkPacketCache(Map<Heightmap.Types, long[]> heightmaps, byte[] buffer) {
+        this.papoPacketHeightmapsCache = heightmaps;
+        this.papoPacketBufferCache = buffer;
+        this.papoChunkPacketCacheVersion = this.papoChunkDataVersion.get();
+    }
+
+    public Map<Heightmap.Types, long[]> papoPacketHeightmapsCache() {
+        return this.papoPacketHeightmapsCache;
+    }
+
+    public byte[] papoPacketBufferCache() {
+        return this.papoPacketBufferCache;
+    }
+    // Papo end - multi-viewer chunk packet data cache
+
     @Override
     public final boolean moonrise$isPostProcessingDone() {
         return this.postProcessingDone;
