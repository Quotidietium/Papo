+    }
+
+    // Papo start - multi-viewer chunk packet data cache
+    // Reuses a previously serialized heightmaps/buffer pair (owned by LevelChunk's cache, only
+    // replaced while papoChunkDataVersion is unchanged) while block entity data is rebuilt fresh:
+    // block entity *content* changes do not bump any chunk-level mutation signal, so their
+    // getUpdateTag() values must be read at construction time like vanilla does.
+    ClientboundLevelChunkPacketData(Map<Heightmap.Types, long[]> heightmaps, byte[] buffer, LevelChunk levelChunk) {
+        this.heightmaps = heightmaps;
+        this.buffer = buffer;
+        this.blockEntitiesData = papoBuildBlockEntityData(levelChunk, this.extraPackets);
+    }
+
+    byte[] papoSerializedBuffer() {
+        return this.buffer;
+    }
+
