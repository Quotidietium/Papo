+    // Papo start - multi-viewer chunk packet data cache
+    // Only used when chunkPacketBlockController.shouldModify(...) == false: there the vanilla
+    // constructor passes chunkPacketInfo == null, and modifyBlocks(packet, null) is exactly a
+    // setReady(true) for both controller implementations (checked ChunkPacketBlockController and
+    // ChunkPacketBlockControllerAntiXray), which this constructor replicates directly.
+    private ClientboundLevelChunkWithLightPacket(int x, int z, ClientboundLevelChunkPacketData chunkData, LevelLightEngine lightEngine) {
+        this.x = x;
+        this.z = z;
+        this.chunkData = chunkData;
+        this.lightData = new ClientboundLightUpdatePacketData(new ChunkPos(x, z), lightEngine, null, null);
+        this.ready = true;
+    }
+
+    public static ClientboundLevelChunkWithLightPacket papoCreateCached(LevelChunk chunk, LevelLightEngine lightEngine) {
+        ChunkPos pos = chunk.getPos();
+        if (chunk.papoChunkPacketCacheValid()) {
+            return new ClientboundLevelChunkWithLightPacket(
+                pos.x,
+                pos.z,
+                new ClientboundLevelChunkPacketData(chunk.papoPacketHeightmapsCache(), chunk.papoPacketBufferCache(), chunk),
+                lightEngine
+            );
+        }
+        ClientboundLevelChunkWithLightPacket packet = new ClientboundLevelChunkWithLightPacket(chunk, lightEngine, null, null, false);
+        ClientboundLevelChunkPacketData data = packet.getChunkData();
+        chunk.papoStoreChunkPacketCache(data.getHeightmaps(), data.papoSerializedBuffer());
+        return packet;
+    }
+    // Papo end - multi-viewer chunk packet data cache
+
     private ClientboundLevelChunkWithLightPacket(RegistryFriendlyByteBuf buffer) {
         this.x = buffer.readInt();
         this.z = buffer.readInt();
