diff --git a/net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java b/net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java
index 1215ac44fd30dc872f9d319be34e5e08ba880ea2..d4c6984d33a2c9aebff2b077e6660524b240723a 100644
--- a/net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity.java
@@ -107,6 +107,10 @@ public abstract class AbstractFurnaceBlockEntity extends BaseContainerBlockEntit
     private final RecipeManager.CachedCheck<SingleRecipeInput, ? extends AbstractCookingRecipe> quickCheck;
     public final RecipeType<? extends AbstractCookingRecipe> recipeType; // Paper - cook speed multiplier API
     public double cookSpeedMultiplier = 1.0; // Paper - cook speed multiplier API
+    // Papo start - per-tick SingleRecipeInput cache, keyed by input-slot stack reference (see serverTick)
+    private ItemStack papoLastInputStack = null;
+    private SingleRecipeInput papoCachedInput = null;
+    // Papo end
 
     protected AbstractFurnaceBlockEntity(BlockEntityType<?> type, BlockPos pos, BlockState blockState, RecipeType<? extends AbstractCookingRecipe> recipeType) {
         super(type, pos, blockState);
@@ -191,7 +195,18 @@ public abstract class AbstractFurnaceBlockEntity extends BaseContainerBlockEntit
         boolean flag1 = !itemStack1.isEmpty();
         boolean flag2 = !itemStack.isEmpty();
         if (furnace.isLit() || flag2 && flag1) {
-            SingleRecipeInput singleRecipeInput = new SingleRecipeInput(itemStack1);
+            // Papo start - reuse the SingleRecipeInput while the input slot's stack reference is
+            // unchanged (the common case while smelting): the record only wraps the reference, so
+            // in-place mutations of the stack (shrink etc.) are visible through the cached wrapper
+            // exactly as through a fresh one.
+            SingleRecipeInput singleRecipeInput;
+            if (furnace.papoLastInputStack == itemStack1) {
+                singleRecipeInput = furnace.papoCachedInput;
+            } else {
+                furnace.papoLastInputStack = itemStack1;
+                furnace.papoCachedInput = singleRecipeInput = new SingleRecipeInput(itemStack1);
+            }
+            // Papo end
             RecipeHolder<? extends AbstractCookingRecipe> recipeHolder;
             if (flag1) {
                 recipeHolder = furnace.quickCheck.getRecipeFor(singleRecipeInput, level).orElse(null);
