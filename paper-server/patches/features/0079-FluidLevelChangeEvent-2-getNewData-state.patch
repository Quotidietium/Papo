diff --git a/net/minecraft/world/level/material/FlowingFluid.java b/net/minecraft/world/level/material/FlowingFluid.java
index 2c0526a96a61c27556984dfcbfb38a3a6eec17a4..329757d352f62775e936f3d137fae7b14942c3c6 100644
--- a/net/minecraft/world/level/material/FlowingFluid.java
+++ b/net/minecraft/world/level/material/FlowingFluid.java
@@ -486,22 +486,32 @@ public abstract class FlowingFluid extends Fluid {
                 fluidState = newLiquid;
                 state = Blocks.AIR.defaultBlockState();
                 // CraftBukkit start
-                org.bukkit.event.block.FluidLevelChangeEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callFluidLevelChangeEvent(level, pos, state);
-                if (event.isCancelled()) {
-                    return;
+                // Papo start - skip FluidLevelChangeEvent allocation+fire when no plugin listens.
+                // With zero listeners the event can never be cancelled and getNewData() returns
+                // the passed-in state unchanged, so falling through is identical.
+                if (org.bukkit.event.block.FluidLevelChangeEvent.getHandlerList().getRegisteredListeners().length > 0) {
+                    org.bukkit.event.block.FluidLevelChangeEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callFluidLevelChangeEvent(level, pos, state);
+                    if (event.isCancelled()) {
+                        return;
+                    }
+                    state = ((org.bukkit.craftbukkit.block.data.CraftBlockData) event.getNewData()).getState();
                 }
-                state = ((org.bukkit.craftbukkit.block.data.CraftBlockData) event.getNewData()).getState();
+                // Papo end
                 // CraftBukkit end
                 level.setBlock(pos, state, Block.UPDATE_ALL);
             } else if (newLiquid != fluidState) {
                 fluidState = newLiquid;
                 state = newLiquid.createLegacyBlock();
                 // CraftBukkit start
-                org.bukkit.event.block.FluidLevelChangeEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callFluidLevelChangeEvent(level, pos, state);
-                if (event.isCancelled()) {
-                    return;
+                // Papo start - skip FluidLevelChangeEvent allocation+fire when no plugin listens (same gate as above).
+                if (org.bukkit.event.block.FluidLevelChangeEvent.getHandlerList().getRegisteredListeners().length > 0) {
+                    org.bukkit.event.block.FluidLevelChangeEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callFluidLevelChangeEvent(level, pos, state);
+                    if (event.isCancelled()) {
+                        return;
+                    }
+                    state = ((org.bukkit.craftbukkit.block.data.CraftBlockData) event.getNewData()).getState();
                 }
-                state = ((org.bukkit.craftbukkit.block.data.CraftBlockData) event.getNewData()).getState();
+                // Papo end
                 // CraftBukkit end
                 level.setBlock(pos, state, Block.UPDATE_ALL);
                 level.scheduleTick(pos, newLiquid.getType(), spreadDelay);
