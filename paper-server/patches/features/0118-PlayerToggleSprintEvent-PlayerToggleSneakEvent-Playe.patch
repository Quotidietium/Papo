From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 20:39:32 +0800
Subject: [PATCH] PlayerToggleSprintEvent PlayerToggleSneakEvent Playe


diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 8472523dacb8cc5208109928bf4a15461d13be66..65ca8537d9f7f30bebf8457a69cf37b1315b04b7 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -493,15 +493,22 @@ public class ServerGamePacketListenerImpl
         // Paper start - PlayerToggleSneakEvent
         net.minecraft.world.entity.player.Input lastInput = this.player.getLastClientInput();
         if (lastInput.shift() != packet.input().shift()) {
-            // Has sneak changed
-            org.bukkit.event.player.PlayerToggleSneakEvent event = new org.bukkit.event.player.PlayerToggleSneakEvent(this.getCraftPlayer(), packet.input().shift());
-            this.cserver.getPluginManager().callEvent(event);
+            // Papo start - zero listeners => never cancelled, equivalent to the
+            // !event.isCancelled() && hasClientLoaded() path with isCancelled()==false
+            if (org.bukkit.event.player.PlayerToggleSneakEvent.getHandlerList().getRegisteredListeners().length > 0) {
+                // Has sneak changed
+                org.bukkit.event.player.PlayerToggleSneakEvent event = new org.bukkit.event.player.PlayerToggleSneakEvent(this.getCraftPlayer(), packet.input().shift());
+                this.cserver.getPluginManager().callEvent(event);
 
-            // Technically the player input and the flag is desynced, but this is previous behavior.. so should be fine?
-            if (!event.isCancelled() && this.hasClientLoaded()) {
-                // Only set the shift key status if the shift input has changed and the event has not been cancelled
+                // Technically the player input and the flag is desynced, but this is previous behavior.. so should be fine?
+                if (!event.isCancelled() && this.hasClientLoaded()) {
+                    // Only set the shift key status if the shift input has changed and the event has not been cancelled
+                    this.player.setShiftKeyDown(packet.input().shift());
+                }
+            } else if (this.hasClientLoaded()) {
                 this.player.setShiftKeyDown(packet.input().shift());
             }
+            // Papo end
         }
         // Paper end - PlayerToggleSneakEvent
         this.player.setLastClientInput(packet.input());
@@ -2294,13 +2301,18 @@ public class ServerGamePacketListenerImpl
         if (this.player.isImmobile()) return; // CraftBukkit
         if (packet.getSlot() >= 0 && packet.getSlot() < Inventory.getSelectionSize()) {
             if (packet.getSlot() == this.player.getInventory().getSelectedSlot()) { return; } // Paper - don't fire itemheldevent when there wasn't a slot change
-            PlayerItemHeldEvent event = new PlayerItemHeldEvent(this.getCraftPlayer(), this.player.getInventory().getSelectedSlot(), packet.getSlot());
-            this.cserver.getPluginManager().callEvent(event);
-            if (event.isCancelled()) {
-                this.send(new ClientboundSetHeldSlotPacket(this.player.getInventory().getSelectedSlot()));
-                this.player.resetLastActionTime();
-                return;
+            // Papo start - skip event construction when there are no listeners (zero listeners =>
+            // never cancelled, so control flow always continues to the slot change below)
+            if (PlayerItemHeldEvent.getHandlerList().getRegisteredListeners().length > 0) {
+                PlayerItemHeldEvent event = new PlayerItemHeldEvent(this.getCraftPlayer(), this.player.getInventory().getSelectedSlot(), packet.getSlot());
+                this.cserver.getPluginManager().callEvent(event);
+                if (event.isCancelled()) {
+                    this.send(new ClientboundSetHeldSlotPacket(this.player.getInventory().getSelectedSlot()));
+                    this.player.resetLastActionTime();
+                    return;
+                }
             }
+            // Papo end
             // CraftBukkit end
             if (this.player.getInventory().getSelectedSlot() != packet.getSlot() && this.player.getUsedItemHand() == InteractionHand.MAIN_HAND) {
                 this.player.stopUsingItem();
@@ -2685,11 +2697,15 @@ public class ServerGamePacketListenerImpl
             switch (packet.getAction()) {
                 case START_SPRINTING:
                 case STOP_SPRINTING: {
-                    PlayerToggleSprintEvent event = new PlayerToggleSprintEvent(this.getCraftPlayer(), packet.getAction() == ServerboundPlayerCommandPacket.Action.START_SPRINTING);
-                    this.cserver.getPluginManager().callEvent(event);
+                    // Papo - skip event construction when there are no listeners (zero listeners =>
+                    // never cancelled, so control flow always falls through to break)
+                    if (PlayerToggleSprintEvent.getHandlerList().getRegisteredListeners().length > 0) {
+                        PlayerToggleSprintEvent event = new PlayerToggleSprintEvent(this.getCraftPlayer(), packet.getAction() == ServerboundPlayerCommandPacket.Action.START_SPRINTING);
+                        this.cserver.getPluginManager().callEvent(event);
 
-                    if (event.isCancelled()) {
-                        return;
+                        if (event.isCancelled()) {
+                            return;
+                        }
                     }
                     break;
                 }
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 9ae2621615cf09c74af50b3538f7bf1ea5ed1f17..864aee5718915998990f44b1f618c629d241d315 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -739,7 +739,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
         if (pose == this.getPose()) {
             return;
         }
-        if (!this.generation) {
+        if (!this.generation && org.bukkit.event.entity.EntityPoseChangeEvent.getHandlerList().getRegisteredListeners().length > 0) { // Papo - zero listeners: event is not cancellable, callEvent result is discarded, constructor only stores fields; also avoids the Pose.values() array clone
             this.level.getCraftServer().getPluginManager().callEvent(new org.bukkit.event.entity.EntityPoseChangeEvent(this.getBukkitEntity(), org.bukkit.entity.Pose.values()[pose.ordinal()]));
         }
         // CraftBukkit end
