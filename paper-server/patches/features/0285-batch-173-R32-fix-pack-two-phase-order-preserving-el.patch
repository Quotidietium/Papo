Subject: [PATCH] batch 173 (R32) fix: pack() two-phase order-preserving elide
 - phase 1 papoPopulateAscending walks cells ascending with the legacy RLE
 memo issuing the IDENTICAL idFor call sequence (fixes palette id assignment =
 wire bytes; a naive function-sourced repack would reorder via the packing
 loop's per-long DESCENDING reads and reassign first-seen ids), phase 2 packs
 from the memo closure with all-hit idFor lookups. Census showed the 316-trip
 face is entirely pack() (chunk-save serialization), so the unpack-branch-only
 elide from the first cut would not have touched the measured face.
 reencodeContents stays as package-private test oracle.


diff --git a/net/minecraft/world/level/chunk/PalettedContainer.java b/net/minecraft/world/level/chunk/PalettedContainer.java
index c3bcf32b43f2a71021b58d2e222bca21faa205f6..4b94d450fccfd014e0d46dec2050b57a07ed26f7 100644
--- a/net/minecraft/world/level/chunk/PalettedContainer.java
+++ b/net/minecraft/world/level/chunk/PalettedContainer.java
@@ -453,6 +453,17 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
             Palette<T> palette = this.data.palette;
             HashMapPalette<T> hashMapPalette = new HashMapPalette<>(bitStorage.getBits());
             int entryCount = strategy.entryCount();
+            // Papo start - batch 173 (R32): two-phase elide of the int[entryCount].
+            // reencodeContents' ascending-order idFor calls are what POPULATE the empty
+            // hashMapPalette - the palette id assignment (and with it the wire bytes) is
+            // defined by that visit order - and the packing loop then reads cells per-long
+            // in DESCENDING order, which a naive function-sourced repack would reorder.
+            // Phase 1 walks cells ascending with the same RLE memo as the array version,
+            // issuing the IDENTICAL idFor call sequence (=> identical ids) without
+            // materializing the unpack/mapped arrays; phase 2 packs from a memo closure
+            // whose idFor calls are all palette hits (order-insensitive lookups).
+            papoPopulateAscending(bitStorage, palette, hashMapPalette);
+            // Papo end - batch 173 (R32)
             Configuration configurationForPaletteSize = strategy.getConfigurationForPaletteSize(hashMapPalette.getSize());
             int i = configurationForPaletteSize.bitsInStorage();
             Optional<long[]> optional; // Papo - batch 172 (R31)
@@ -491,6 +502,24 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
         return ints;
     }
 
+    // Papo start - batch 173 (R32): ascending-order palette population with the exact
+    // idFor call sequence of the legacy reencodeContents loop (once per consecutive
+    // run of equal old ids, ascending index order) - this is what fixes the target
+    // palette's id assignment, so it must not change visit order.
+    static <T> void papoPopulateAscending(final BitStorage bitStorage, final Palette<T> oldPalette, final Palette<T> newPalette) {
+        final PaletteResize<T> paletteResize = PaletteResize.noResizeExpected();
+        final int size = bitStorage.getSize();
+        int lastOld = -1;
+        for (int i = 0; i < size; ++i) {
+            final int oldId = bitStorage.get(i);
+            if (oldId != lastOld) {
+                lastOld = oldId;
+                newPalette.idFor(oldPalette.valueFor(oldId), paletteResize);
+            }
+        }
+    }
+    // Papo end - batch 173 (R32)
+
     // Papo start - batch 173 (R32): pack the re-encoded ids straight into the new storage
     // via the function-sourced SimpleBitStorage ctor, eliminating the int[entryCount]
     // intermediate of reencodeContents (kept above as the identity oracle for tests).
