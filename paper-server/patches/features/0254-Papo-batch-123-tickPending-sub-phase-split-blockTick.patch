         if (!this.isDebug() && runsNormally) {
             long l = this.getGameTime();
             profilerFiller.push("blockTicks");
+            final long papoTBlockTicks = System.nanoTime(); // Papo - batch 123 tick profile
             this.blockTicks.tick(l, paperConfig().environment.maxBlockTicks, this::tickBlock); // Paper - configurable max block ticks
+            io.papermc.paper.util.PapoTickProfile.add("level.blockTicks", papoTBlockTicks); // Papo - batch 123
             profilerFiller.popPush("fluidTicks");
+            final long papoTFluidTicks = System.nanoTime(); // Papo - batch 123 tick profile
