             profilerFiller.pop();
         }
 
@@ -811,9 +815,11 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         this.getChunkSource().tick(hasTimeLeft, true);
         io.papermc.paper.util.PapoTickProfile.add("level.chunkSource", papoTChunkSource); // Papo - batch 90
         profilerFiller.popPush("blockEvents");
+        final long papoTBlockEvents = System.nanoTime(); // Papo - batch 123 tick profile
         if (runsNormally) {
             this.runBlockEvents();
         }
+        io.papermc.paper.util.PapoTickProfile.add("level.blockEvents", papoTBlockEvents); // Papo - batch 123
 
         this.handlingTick = false;
         profilerFiller.pop();
