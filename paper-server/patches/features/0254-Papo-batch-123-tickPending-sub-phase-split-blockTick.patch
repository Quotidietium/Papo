+        io.papermc.paper.util.PapoTickProfile.addCount("rs.blockTickRuns", 1); // Papo - batch 123 activity counter (diagnostic-only, papo.tickProfile-gated)
         BlockState blockState = this.getBlockState(pos);
         if (blockState.is(block)) {
             blockState.tick(this, pos, this.random);
