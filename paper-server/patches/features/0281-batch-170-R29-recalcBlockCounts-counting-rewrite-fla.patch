index 93bc56daec4526f373c84763b8c7ccb4a30e800b..3e4cc58c1a6f8a77983f4b8a78a5d6a53fa0d33e 100644
--- a/ca/spottedleaf/moonrise/patches/block_counting/BlockCountingBitStorage.java
+++ b/ca/spottedleaf/moonrise/patches/block_counting/BlockCountingBitStorage.java
@@ -1,5 +1,6 @@
 package ca.spottedleaf.moonrise.patches.block_counting;
 
+import ca.spottedleaf.moonrise.common.list.ShortList;
 import it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap;
 import it.unimi.dsi.fastutil.shorts.ShortArrayList;
 
@@ -7,4 +8,14 @@ public interface BlockCountingBitStorage {
 
     public Int2ObjectOpenHashMap<ShortArrayList> moonrise$countEntries();
 
+    // Papo start - batch 170 (R29): count-only walk plus deferred coordinate collection
+    // for LevelChunkSection.recalcBlockCounts. moonrise$countEntries materializes a
+    // coordinate ShortArrayList per palette id - including the dominant air/stone lists,
+    // whose 64->...->4096 doubling growth chains made that the single largest allocation
+    // site of the disk-load burst (354 of 1,819 JFR trips). The consumer only needs the
+    // per-id counts and, for randomly-ticking ids only, their coordinates.
+    public void moonrise$countByIndex(final int[] counts);
+
+    public void moonrise$collectIndices(final int paletteIdx, final ShortList out);
+    // Papo end - batch 170 (R29)
 }
diff --git a/net/minecraft/util/SimpleBitStorage.java b/net/minecraft/util/SimpleBitStorage.java
index 08af7687cdbf395116c2ae0c40befa518b796846..8f03fed6fa2ddd1e60a9b562245ce64d440551da 100644
--- a/net/minecraft/util/SimpleBitStorage.java
+++ b/net/minecraft/util/SimpleBitStorage.java
@@ -460,6 +460,52 @@ public class SimpleBitStorage implements BitStorage {
     }
     // Paper end - block counting
 
+    // Papo start - batch 170 (R29): count-only variant of the walk above (identical
+    // iteration shape, no per-id coordinate lists) and the matching deferred
+    // coordinate collection for a single palette id. See BlockCountingBitStorage.
+    @Override
+    public final void moonrise$countByIndex(final int[] counts) {
+        final int valuesPerLong = this.valuesPerLong;
+        final int bits = this.bits;
+        final long mask = this.mask;
+        final int size = this.size;
+
+        int index = 0;
+
+        for (long value : this.data) {
+            int li = 0;
+            do {
+                ++counts[(int)(value & mask)];
+                value >>= bits;
+                ++li;
+                ++index;
+            } while (li < valuesPerLong && index < size);
+        }
+    }
+
+    @Override
+    public final void moonrise$collectIndices(final int paletteIdx, final ca.spottedleaf.moonrise.common.list.ShortList out) {
+        final int valuesPerLong = this.valuesPerLong;
+        final int bits = this.bits;
+        final long mask = this.mask;
+        final int size = this.size;
+
+        int index = 0;
+
+        for (long value : this.data) {
+            int li = 0;
+            do {
+                if ((int)(value & mask) == paletteIdx) {
+                    out.add((short)index);
+                }
+                value >>= bits;
+                ++li;
+                ++index;
+            } while (li < valuesPerLong && index < size);
+        }
+    }
+    // Papo end - batch 170 (R29)
+
     public static class InitializationException extends RuntimeException {
         InitializationException(String message) {
             super(message);
diff --git a/net/minecraft/util/ZeroBitStorage.java b/net/minecraft/util/ZeroBitStorage.java
index 9531aff6dd99eec810672c0863aa59e9d4746c68..1f1db26e1ee94726cb38ff51bf822346340dd3b8 100644
--- a/net/minecraft/util/ZeroBitStorage.java
+++ b/net/minecraft/util/ZeroBitStorage.java
@@ -24,6 +24,25 @@ public class ZeroBitStorage implements BitStorage {
         this.size = size;
     }
 
+    // Papo start - batch 170 (R29): every cell of a zero-bit storage reads 0, so the
+    // counting walk is a single add and coordinate collection only matches id 0.
+    // See BlockCountingBitStorage.
+    @Override
+    public final void moonrise$countByIndex(final int[] counts) {
+        counts[0] += this.size;
+    }
+
+    @Override
+    public final void moonrise$collectIndices(final int paletteIdx, final ca.spottedleaf.moonrise.common.list.ShortList out) {
+        if (paletteIdx != 0) {
+            return;
+        }
+        for (int index = 0, size = this.size; index < size; ++index) {
+            out.add((short)index);
+        }
+    }
+    // Papo end - batch 170 (R29)
+
