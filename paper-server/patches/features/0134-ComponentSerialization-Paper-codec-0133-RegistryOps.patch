From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Fri, 31 Jul 2026 23:01:15 +0800
Subject: [PATCH] ComponentSerialization Paper codec 0133 RegistryOps


diff --git a/net/minecraft/network/chat/ComponentSerialization.java b/net/minecraft/network/chat/ComponentSerialization.java
index ad80a3523132351bd63e7a5a096eec22c0923080..5b8667353da07f633e3014d50d423e016403e887 100644
--- a/net/minecraft/network/chat/ComponentSerialization.java
+++ b/net/minecraft/network/chat/ComponentSerialization.java
@@ -46,13 +46,13 @@ public class ComponentSerialization {
             @Override
             public Component decode(RegistryFriendlyByteBuf registryFriendlyByteBuf) {
                 net.minecraft.nbt.Tag tag = this.streamCodec.decode(registryFriendlyByteBuf);
-                RegistryOps<net.minecraft.nbt.Tag> registryOps = registryFriendlyByteBuf.registryAccess().createSerializationContext(net.minecraft.nbt.NbtOps.INSTANCE);
+                RegistryOps<net.minecraft.nbt.Tag> registryOps = ByteBufCodecs.papoNbtSerializationContext(registryFriendlyByteBuf.registryAccess()); // Papo - cached ops (0133 pattern)
                 return CODEC.parse(registryOps, tag).getOrThrow(error -> new io.netty.handler.codec.DecoderException("Failed to decode: " + error + " " + tag));
             }
 
             @Override
             public void encode(RegistryFriendlyByteBuf registryFriendlyByteBuf, Component object) {
-                RegistryOps<net.minecraft.nbt.Tag> registryOps = registryFriendlyByteBuf.registryAccess().createSerializationContext(net.minecraft.nbt.NbtOps.INSTANCE);
+                RegistryOps<net.minecraft.nbt.Tag> registryOps = ByteBufCodecs.papoNbtSerializationContext(registryFriendlyByteBuf.registryAccess()); // Papo - cached ops (0133 pattern)
                 net.minecraft.nbt.Tag tag = (DONT_RENDER_TRANSLATABLES.get() ? CODEC : ComponentSerialization.localizedCodec(registryFriendlyByteBuf.adventure$locale))
                     .encodeStart(registryOps, object).getOrThrow(error -> new io.netty.handler.codec.EncoderException("Failed to encode: " + error + " " + object));
                 this.streamCodec.encode(registryFriendlyByteBuf, tag);
diff --git a/net/minecraft/network/codec/ByteBufCodecs.java b/net/minecraft/network/codec/ByteBufCodecs.java
index def2d4cb6e3059a17ca0d9dd02759c35f0463607..36974e2de77784505f424bdf8470c44dca02dbd1 100644
--- a/net/minecraft/network/codec/ByteBufCodecs.java
+++ b/net/minecraft/network/codec/ByteBufCodecs.java
@@ -429,7 +429,8 @@ public interface ByteBufCodecs {
     // case: the server's frozen composite access). A RegistryOps only captures the access, and its
     // HolderLookupAdapter lookup cache is a ConcurrentHashMap, so sharing one instance across calls
     // and threads is safe and behavior-identical to creating one per call.
-    private static RegistryOps<Tag> papoNbtSerializationContext(RegistryAccess registryAccess) {
+    // public: reused by ComponentSerialization's Paper translation-aware codec (same pattern).
+    static RegistryOps<Tag> papoNbtSerializationContext(RegistryAccess registryAccess) {
         return registryAccess instanceof RegistryAccess.ImmutableRegistryAccess immutable
             ? immutable.papoNbtSerializationContext()
             : registryAccess.createSerializationContext(NbtOps.INSTANCE);
