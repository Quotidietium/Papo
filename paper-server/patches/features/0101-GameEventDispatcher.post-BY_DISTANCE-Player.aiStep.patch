+    // Papo - stateful ListenerVisitor carrying the lazily-allocated BY_DISTANCE queue.
+    private final class PapoPostVisitor implements GameEventListenerRegistry.ListenerVisitor {
+        private final Holder<GameEvent> gameEvent;
+        private final Vec3 pos;
+        private final GameEvent.Context context;
+        List<GameEvent.ListenerInfo> byDistance;
+
+        PapoPostVisitor(Holder<GameEvent> gameEvent, Vec3 pos, GameEvent.Context context) {
+            this.gameEvent = gameEvent;
+            this.pos = pos;
+            this.context = context;
+        }
+
+        @Override
+        public void visit(GameEventListener listener, Vec3 pos1) {
+            if (listener.getDeliveryMode() == GameEventListener.DeliveryMode.BY_DISTANCE) {
+                if (this.byDistance == null) {
+                    this.byDistance = new ArrayList<>();
+                }
+                this.byDistance.add(new GameEvent.ListenerInfo(this.gameEvent, this.pos, this.context, listener, pos1));
+            } else {
+                listener.handleGameEvent(GameEventDispatcher.this.level, this.gameEvent, this.context, this.pos);
+            }
+        }
+    }
+
