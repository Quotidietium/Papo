+++ b/net/minecraft/world/item/PapoLazyItemsList.java
@@ -0,0 +1,87 @@
+package net.minecraft.world.item;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import net.minecraft.core.NonNullList;
+import org.jspecify.annotations.Nullable;
+
+// Papo start - batch 186 (R45): 定尺寸懒物品列表——空容器 BE 的驻留收割。
+// vanilla 每个容器方块实体在字段初始化即物化 Object[slots]（27 槽箱约 296B：
+// 数组 232 + Arrays.asList 视图 24 + NonNullList 壳 40），而空容器是真实服务器
+// 常态（储物空箱、转运空漏斗）。本类以共享 EMPTY 只读视图起步（读恒 EMPTY、
+// size 恒 n、add/remove 恒 UOE——与 vanilla 固定尺寸背板同语义），首次 set 才
+// 物化与 vanilla 逐位同构的 Arrays.asList 背板，clear() 后弃背板回收。
+//
+// 与 NonNullList.withSize(n, ItemStack.EMPTY) 的逐位一致性证明面：
+// - get(i)：未物化=EMPTY（=vanilla 填充值）；物化后与 vanilla 同数组同内容；
+// - set(i, v)：物化后委托，返回旧值逐位一致；
+// - add/add(i,v)/remove(int)：未物化经 nCopies 只读视图抛 UOE，物化后
+//   super 委托的 this.list 仍是 nCopies 视图恒抛 UOE——vanilla 背板为
+//   Arrays.asList 固定尺寸视图，两态都与 vanilla 同样恒抛；
+// - clear()：vanilla（NonNullList.clear，defaultValue!=null）为 set 循环回
+//   EMPTY；本类直接弃背板——后续读回 EMPTY、size 仍 n，可观察状态逐位一致；
+// - equals/hashCode/iterator/forEach/stream/spliterator：AbstractList 经
+//   size()+get()，逐位一致（含与 vanilla 列表的跨实例 equals）；
+// - sort()/replaceAll()：List 默认实现经 toArray+set 循环，set 物化后执行，
+//   结果逐位一致（vanilla 固定尺寸背板同样经 set 循环工作）；
+// - 盘载：ContainerHelper.loadAllItems 只对已存条目 set——空容器盘载后保持
+//   懒态；保存：saveAllItems 只写非空槽，NBT 逐位一致。
+// - 已知物化路径（语义仍一致，仅失去懒性）：ItemContainerContents.copyInto
+//   对全槽 set（组件拷贝路径，稀有）；带内容盘载 set（本就携带内容）。
+public final class PapoLazyItemsList extends NonNullList<ItemStack> {
+    // 共享只读空视图（按尺寸缓存，不可变可安全共享）：未物化态零数组、零视图分配。
+    // 容器 BE 槽数全在 0..31 内（3/4/5/6/9/27），越界尺寸走 nCopies 兜底。
+    @SuppressWarnings("unchecked")
+    private static final List<ItemStack>[] SHARED_EMPTY_VIEWS = makeSharedEmptyViews();
+
+    @SuppressWarnings("unchecked")
+    private static List<ItemStack>[] makeSharedEmptyViews() {
+        final List<ItemStack>[] views = new List[32];
+        for (int i = 0; i < views.length; i++) {
+            views[i] = Collections.nCopies(i, ItemStack.EMPTY);
+        }
+        return views;
+    }
+
+    private final int fixedSize;
+    private @Nullable List<ItemStack> backing; // null = 全空未物化
+
+    private PapoLazyItemsList(final int size) {
+        super(size >= 0 && size < SHARED_EMPTY_VIEWS.length ? SHARED_EMPTY_VIEWS[size] : Collections.nCopies(size, ItemStack.EMPTY), ItemStack.EMPTY);
+        this.fixedSize = size;
+    }
+
+    public static NonNullList<ItemStack> papoOf(final int size) {
+        return new PapoLazyItemsList(size);
+    }
+
+    @Override
+    public ItemStack get(final int index) {
+        final List<ItemStack> b = this.backing;
+        return b != null ? b.get(index) : super.get(index);
+    }
+
+    @Override
+    public ItemStack set(final int index, final ItemStack value) {
+        List<ItemStack> b = this.backing;
+        if (b == null) {
+            final ItemStack[] filled = new ItemStack[this.fixedSize];
+            Arrays.fill(filled, ItemStack.EMPTY);
+            b = Arrays.asList(filled);
+            this.backing = b;
+        }
+        return b.set(index, value);
+    }
+
+    @Override
+    public int size() {
+        return this.fixedSize;
+    }
+
+    @Override
+    public void clear() {
+        this.backing = null;
+    }
+}
+// Papo end - batch 186 (R45)
