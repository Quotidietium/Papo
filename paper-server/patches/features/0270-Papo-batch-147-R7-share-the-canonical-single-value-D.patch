+    // Papo start - batch 147 (R7): canonical shared Data for single-value containers.
+    // The 0.84.0 soak census measured 576k live single-value containers (87% of all chunk
+    // sections are constant - air above terrain, uniform biomes), each paying
+    // Data(32B) + SingleValuePalette(24B) + the shared moonrise$palette/rawPalette
+    // Object[1] (24B) ~= 80B of state that only depends on (strategy, value). All of it
+    // collapses to one instance per (strategy, registry id); the ZeroBitStorage payload is
+    // already shared by size (batch 145).
+    //
+    // Safety contract:
+    //  - the shared value is keyed by its registry id, so the canonical instance IS the
+    //    interned registry instance and `SingleValuePalette.idFor`'s reference comparison
+    //    (value != state) behaves exactly as on a private palette;
+    //  - a published shared Data is never structurally mutated: growth replaces the
+    //    OWNING container's data field with a private Data (onResize -> this.data = data1),
+    //    the only in-place palette writes are the reference-idempotent idFor(same)/rawPalette
+    //    assignments (benign race, same reference either way), and Data.copy()/palette.copy()
+    //    either stay read-only or route through the same container-level swap;
+    //  - the FriendlyByteBuf read() path, the one place that rewrites a palette in place
+    //    (SingleValuePalette.read), is guarded to allocate private data first - the server
+    //    reads chunks through the NBT codec, never this path;
+    //  - the per-strategy cache lives on the Strategy instance itself, so an unloaded
+    //    level's cache is garbage-collected with it, and its size is bounded by the
+    //    strategy's registry size (no user-data-driven growth).
+    private static <T> PalettedContainer.Data<T> papoSharedSingleValueData(final Strategy<T> strategy, final T value) {
+        if (value == null) {
+            return null;
+        }
+        final int id = strategy.globalMap().getId(value);
+        if (id < 0) {
+            return null; // unregistered value: stay per-container
+        }
+        final java.util.concurrent.ConcurrentHashMap<Integer, Object> cache = strategy.papoSharedSingleValues;
+        final Object cached = cache.get(id);
+        if (cached != null) {
+            return (PalettedContainer.Data<T>) cached;
+        }
+        final SingleValuePalette<T> palette = new SingleValuePalette<>(List.of(value));
+        final PalettedContainer.Data<T> built = new PalettedContainer.Data<>(
+            Strategy.ZERO_BITS, ZeroBitStorage.papoShared(strategy.entryCount()), palette);
+        built.moonrise$setPalette(palette.moonrise$getRawPalette(built));
+        built.papoShared = true;
+        palette.papoShared = true;
+        final Object winner = cache.putIfAbsent(id, built);
+        return (PalettedContainer.Data<T>) (winner != null ? winner : built);
+    }
+    // Papo end - batch 147 (R7)
+
