+        if (presetValues == null && palette.getSize() == 1 && storage instanceof ZeroBitStorage) {
+            T papoSingle = null;
+            try {
+                papoSingle = palette.valueFor(0);
+            } catch (final IllegalStateException ignored) {
+                // null-valued palette (empty palette list on corrupt input): vanilla
+                // tolerates it until first read - keep the private data, share nothing
+            }
+            if (papoSingle != null) {
+                final PalettedContainer.Data<T> papoShared = papoSharedSingleValueData(strategy, papoSingle);
+                if (papoShared != null) {
+                    this.data = papoShared;
+                    return;
+                }
+            }
+        }
+        // Papo end - batch 147 (R7)
         this.updateData(this.data); // Paper - optimise palette reads
     }
 
