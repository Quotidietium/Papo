diff --git a/net/minecraft/world/level/levelgen/structure/templatesystem/PapoStructureCache.java b/net/minecraft/world/level/levelgen/structure/templatesystem/PapoStructureCache.java
new file mode 100644
index 0000000000000000000000000000000000000000..9b18169088e8f21e7858f7c58bbe4f0d4ab90aa5
--- /dev/null
+++ b/net/minecraft/world/level/levelgen/structure/templatesystem/PapoStructureCache.java
@@ -0,0 +1,311 @@
+package net.minecraft.world.level.levelgen.structure.templatesystem;
+
+import java.util.AbstractMap;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Function;
+import java.util.function.LongSupplier;
+import net.minecraft.resources.Identifier;
+
+// Papo start - batch 150 (R10): bounded residency for the structure template cache.
+// Vanilla keeps every template ever loaded in an unbounded concurrent map for the
+// lifetime of the server; a post-generation heap shows hundreds of templates
+// (block-info lists + block positions, tens of MB) resident long after the last
+// structure finished generating. This replacement keeps the exact Map contract
+// (the declared field type in StructureTemplateManager stays Map for plugin binary
+// compatibility) but adds:
+//   * idle eviction - entries not read for 120 seconds are dropped and reloaded
+//     from their source on the next access (structure templates are immutable
+//     while placed, so reload-on-miss is behaviour-preserving);
+//   * protection   - every entry that enters the map through put() (vanilla
+//     getOrCreate's create-path for ids no source can load, and every Bukkit
+//     CraftStructureManager register/load-with-register call) is protected from
+//     eviction: those templates may be unsaved programmatic work whose loss
+//     would change observable behaviour. tryLoad-backed entries (the worldgen
+//     hot path) stay evictable because they are always reloadable;
+//   * access stamping on every read path (get, containsKey, computeIfAbsent,
+//     entrySet/values iteration) so plugins polling the raw map keep their
+//     entries hot and Bukkit getStructure/getStructures semantics are unchanged;
+//   * a hard cap on the evictable population for pathological worlds.
+// StructureTemplateManager.papoMaintenanceTick drives papoSweepIfDue from the
+// server tick; TemplateStructurePiece no longer holds template instances (it
+// re-fetches by identifier), so resident structure starts cannot pin templates.
+// Papo end
+public final class PapoStructureCache extends ConcurrentHashMap<Identifier, Optional<StructureTemplate>> {
+    // Papo start - batch 150 (R10): tuning constants - see class comment
+    static final long PAPO_IDLE_TTL_NANOS = TimeUnit.SECONDS.toNanos(120L);
+    static final long PAPO_SWEEP_INTERVAL_NANOS = TimeUnit.SECONDS.toNanos(25L);
+    static final int PAPO_MAX_EVICTABLE = 256;
+    // Papo end
+
+    private final transient ConcurrentHashMap<Identifier, Long> papoLastAccess = new ConcurrentHashMap<>();
+    private final transient Set<Identifier> papoProtected = ConcurrentHashMap.newKeySet();
+    private final transient LongSupplier papoClock;
+    private transient volatile long papoLastSweepNanos;
+
+    public PapoStructureCache() {
+        this(System::nanoTime);
+    }
+
+    public PapoStructureCache(LongSupplier clock) {
+        this.papoClock = clock;
+    }
+
+    // Papo start - batch 150 (R10): stamping + protection plumbing
+    private void papoTouch(Identifier key) {
+        this.papoLastAccess.put(key, this.papoClock.getAsLong());
+    }
+
+    @Override
+    public Optional<StructureTemplate> get(Object key) {
+        Optional<StructureTemplate> value = super.get(key);
+        if (value != null && key instanceof Identifier identifier) {
+            this.papoTouch(identifier);
+        }
+
+        return value;
+    }
+
+    @Override
+    public boolean containsKey(Object key) {
+        boolean present = super.containsKey(key);
+        if (present && key instanceof Identifier identifier) {
+            this.papoTouch(identifier);
+        }
+
+        return present;
+    }
+
+    @Override
+    public Optional<StructureTemplate> computeIfAbsent(Identifier key, Function<? super Identifier, ? extends Optional<StructureTemplate>> mappingFunction) {
+        Optional<StructureTemplate> value = super.computeIfAbsent(key, mappingFunction);
+        this.papoTouch(key);
+        return value;
+    }
+
+    @Override
+    public Optional<StructureTemplate> put(Identifier key, Optional<StructureTemplate> value) {
+        Optional<StructureTemplate> previous = super.put(key, value);
+        this.papoProtected.add(key);
+        this.papoTouch(key);
+        return previous;
+    }
+
+    @Override
+    public Optional<StructureTemplate> putIfAbsent(Identifier key, Optional<StructureTemplate> value) {
+        Optional<StructureTemplate> previous = super.putIfAbsent(key, value);
+        this.papoProtected.add(key);
+        this.papoTouch(key);
+        return previous;
+    }
+
+    @Override
+    public Optional<StructureTemplate> remove(Object key) {
+        Optional<StructureTemplate> previous = super.remove(key);
+        if (previous != null && key instanceof Identifier identifier) {
+            this.papoProtected.remove(identifier);
+            this.papoLastAccess.remove(identifier);
+        }
+
+        return previous;
+    }
+
+    @Override
+    public void clear() {
+        super.clear();
+        this.papoProtected.clear();
+        this.papoLastAccess.clear();
+    }
+    // Papo end
+
+    // Papo start - batch 150 (R10): stamping collection views. keySet() is NOT
+    // overridden (ConcurrentHashMap declares a covariant KeySetView return type,
+    // and no in-repo caller iterates keys without also calling get); entrySet()
+    // and values() are what CraftStructureManager.getStructures() walks, so
+    // iterating them keeps entries hot.
+    @Override
+    public Set<Map.Entry<Identifier, Optional<StructureTemplate>>> entrySet() {
+        return new PapoStampingSet<>(super.entrySet());
+    }
+
+    @Override
+    public Collection<Optional<StructureTemplate>> values() {
+        return new PapoStampingCollection<>(super.values());
+    }
+
+    private final class PapoStampingIterator<T> implements Iterator<T> {
+        private final Iterator<T> papoDelegate;
+
+        PapoStampingIterator(Iterator<T> delegate) {
+            this.papoDelegate = delegate;
+        }
+
+        @Override
+        public boolean hasNext() {
+            return this.papoDelegate.hasNext();
+        }
+
+        @Override
+        public T next() {
+            T next = this.papoDelegate.next();
+            PapoStructureCache.this.papoTouchDelegate(next);
+            return next;
+        }
+    }
+
+    private void papoTouchDelegate(Object element) {
+        if (element instanceof Map.Entry<?, ?> entry && entry.getKey() instanceof Identifier identifier) {
+            this.papoTouch(identifier);
+        }
+    }
+    // Papo end
+
+    // Papo start - batch 150 (R10): sweep. Called from the server main thread via
+    // StructureTemplateManager.papoMaintenanceTick; safe concurrently (all state
+    // is concurrent-map backed and removal is a plain remove - if an entry is
+    // re-inserted between inspection and removal the next access simply reloads).
+    void papoSweepIfDue() {
+        long now = this.papoClock.getAsLong();
+        if (now - this.papoLastSweepNanos < PAPO_SWEEP_INTERVAL_NANOS) {
+            return;
+        }
+
+        this.papoLastSweepNanos = now;
+        this.papoSweep(now);
+    }
+
+    void papoSweep(long now) {
+        List<Identifier> idle = null;
+        int unprotected = 0;
+
+        for (Map.Entry<Identifier, Optional<StructureTemplate>> entry : PapoStructureCache.super.entrySet()) {
+            Identifier key = entry.getKey();
+            if (this.papoProtected.contains(key)) {
+                continue;
+            }
+
+            unprotected++;
+            Long stamp = this.papoLastAccess.get(key);
+            if (stamp == null || now - stamp >= PAPO_IDLE_TTL_NANOS) {
+                if (idle == null) {
+                    idle = new ArrayList<>();
+                }
+
+                idle.add(key);
+            }
+        }
+
+        if (idle != null) {
+            for (Identifier key : idle) {
+                this.remove(key);
+            }
+        }
+
+        int surviving = unprotected - (idle == null ? 0 : idle.size());
+        if (surviving > PAPO_MAX_EVICTABLE) {
+            List<Map.Entry<Identifier, Long>> stamps = new ArrayList<>(surviving);
+
+            for (Map.Entry<Identifier, Optional<StructureTemplate>> entry : PapoStructureCache.super.entrySet()) {
+                if (!this.papoProtected.contains(entry.getKey())) {
+                    stamps.add(new AbstractMap.SimpleImmutableEntry<>(entry.getKey(), this.papoLastAccess.getOrDefault(entry.getKey(), Long.MIN_VALUE)));
+                }
+            }
+
+            stamps.sort(Map.Entry.comparingByValue());
+            int excess = stamps.size() - PAPO_MAX_EVICTABLE;
+
+            for (int i = 0; i < excess; i++) {
+                this.remove(stamps.get(i).getKey());
+            }
+        }
+    }
+    // Papo end
+
+    // Papo start - batch 150 (R10): view wrappers whose iterators stamp visited keys
+    private final class PapoStampingSet<E> extends PapoStampingCollection<E> implements Set<E> {
+        PapoStampingSet(Set<E> delegate) {
+            super(delegate);
+        }
+    }
+
+    private class PapoStampingCollection<E> implements Collection<E> {
+        private final Collection<E> papoDelegate;
+
+        PapoStampingCollection(Collection<E> delegate) {
+            this.papoDelegate = delegate;
+        }
+
+        @Override
+        public int size() {
+            return this.papoDelegate.size();
+        }
+
+        @Override
+        public boolean isEmpty() {
+            return this.papoDelegate.isEmpty();
+        }
+
+        @Override
+        public boolean contains(Object o) {
+            return this.papoDelegate.contains(o);
+        }
+
+        @Override
+        public Iterator<E> iterator() {
+            return new PapoStampingIterator<>(this.papoDelegate.iterator());
+        }
+
+        @Override
+        public Object[] toArray() {
+            return this.papoDelegate.toArray();
+        }
+
+        @Override
+        public <T> T[] toArray(T[] a) {
+            return this.papoDelegate.toArray(a);
+        }
+
+        @Override
+        public boolean add(E e) {
+            return this.papoDelegate.add(e);
+        }
+
+        @Override
+        public boolean remove(Object o) {
+            return this.papoDelegate.remove(o);
+        }
+
+        @Override
+        public boolean containsAll(Collection<?> c) {
+            return this.papoDelegate.containsAll(c);
+        }
+
+        @Override
+        public boolean addAll(Collection<? extends E> c) {
+            return this.papoDelegate.addAll(c);
+        }
+
+        @Override
+        public boolean removeAll(Collection<?> c) {
+            return this.papoDelegate.removeAll(c);
+        }
+
+        @Override
+        public boolean retainAll(Collection<?> c) {
+            return this.papoDelegate.retainAll(c);
+        }
+
+        @Override
+        public void clear() {
+            this.papoDelegate.clear();
+        }
+    }
+    // Papo end
