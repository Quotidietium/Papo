From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zurker <91011862+hershate@users.noreply.github.com>
Date: Thu, 30 Jul 2026 17:28:09 +0800
Subject: [PATCH] Identifier.toString NBT volatile


diff --git a/net/minecraft/resources/Identifier.java b/net/minecraft/resources/Identifier.java
index ae6219185aa00a2753b0986ecf5f8456f4c2515d..b22924fb737aaa1f874e8afc696bfa3689e0a5f0 100644
--- a/net/minecraft/resources/Identifier.java
+++ b/net/minecraft/resources/Identifier.java
@@ -23,6 +23,11 @@ public final class Identifier implements Comparable<Identifier> {
     public static final String PAPER_NAMESPACE = "paper"; // Paper
     private final String namespace;
     private final String path;
+    // Papo start - cache toString(): identifiers are immutable singletons in registries and are
+    // stringified on every packet/NBT write; the concat result never changes for an instance.
+    // volatile + benign race: worst case two threads both compute an equal string.
+    private volatile String papoCachedToString;
+    // Papo end
 
     private Identifier(String namespace, String path) {
         assert isValidNamespace(namespace);
@@ -130,7 +135,14 @@ public final class Identifier implements Comparable<Identifier> {
 
     @Override
     public String toString() {
-        return this.namespace + ":" + this.path;
+        // Papo start - cached concat (see field declaration)
+        String s = this.papoCachedToString;
+        if (s == null) {
+            s = this.namespace + ":" + this.path;
+            this.papoCachedToString = s;
+        }
+        return s;
+        // Papo end
     }
 
     @Override
