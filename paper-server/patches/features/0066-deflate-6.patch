区块保存的 deflate 默认 level 6 是保存管线最大 CPU 项。新增配置
unsupportedSettings.compressionLevel（默认 6，与 vanilla 字节一致），
可设 1(BEST_SPEED) 大幅降低保存 CPU（文件略大）。因 DeflaterOutputStream
不会 end() 外部传入的 Deflater，用自定义子类在 close 时 end() 防 native 泄漏。

diff --git a/net/minecraft/world/level/chunk/storage/RegionFileVersion.java b/net/minecraft/world/level/chunk/storage/RegionFileVersion.java
index e813dedf8d70ae58d595bcd7bc92a1de845fe4a9..686ed2bee2f44fab44e6fa5d02efe562a97b017f 100644
--- a/net/minecraft/world/level/chunk/storage/RegionFileVersion.java
+++ b/net/minecraft/world/level/chunk/storage/RegionFileVersion.java
@@ -36,7 +36,7 @@ public class RegionFileVersion {
             2,
             "deflate",
             inputWrapper -> new FastBufferedInputStream(new InflaterInputStream(inputWrapper)),
-            outputWrapper -> new BufferedOutputStream(new DeflaterOutputStream(outputWrapper))
+            outputWrapper -> new BufferedOutputStream(papoCreateDeflaterOutputStream(outputWrapper))
         )
     );
     public static final RegionFileVersion VERSION_NONE = register(new RegionFileVersion(3, "none", FastBufferedInputStream::new, BufferedOutputStream::new));
@@ -70,6 +70,35 @@ public class RegionFileVersion {
         };
     }
     // Paper end - Configurable region compression format
+    // Papo start - configurable deflate compression level for region files.
+    // DeflaterOutputStream(out, deflater) does NOT end() the provided Deflater on close, so wrap it
+    // in a small subclass that owns and ends the Deflater (avoids leaking native zlib state per save).
+    private static OutputStream papoCreateDeflaterOutputStream(OutputStream out) {
+        int level = io.papermc.paper.configuration.GlobalConfiguration.get().unsupportedSettings.compressionLevel;
+        if (level < 1 || level > 9) {
+            level = 6;
+        }
+        return new PapoDeflaterOutputStream(out, new java.util.zip.Deflater(level));
+    }
+
+    private static final class PapoDeflaterOutputStream extends java.util.zip.DeflaterOutputStream {
+        private final java.util.zip.Deflater ownedDeflater;
+
+        PapoDeflaterOutputStream(OutputStream out, java.util.zip.Deflater deflater) {
+            super(out, deflater);
+            this.ownedDeflater = deflater;
+        }
+
+        @Override
+        public void close() throws IOException {
+            try {
+                super.close();
+            } finally {
+                this.ownedDeflater.end();
+            }
+        }
+    }
+    // Papo end
     private RegionFileVersion(
         int id,
         @Nullable String optionName,
