+package net.minecraft.world.ticks;
+
+// Papo start - batch 123: allocation-free (packedPos, type) dedup set for scheduled ticks
+// Replaces ObjectOpenCustomHashSet<ScheduledTick<?>> (ScheduledTick.UNIQUE_TICK_HASH),
+// which requires a fresh probe ScheduledTick record allocation on every
+// hasScheduledTick/willTickThisTick contains() call. Membership semantics are identical
+// to UNIQUE_TICK_HASH: same position AND identical type reference (its equals() compares
+// type() with ==). Open addressing with linear probing and backward-shift deletion.
+final class PapoPosTypeSet<T> {
+    private long[] keys = new long[16];
+    private Object[] types = new Object[16];
+    private int mask = 15;
+    private int size;
+
+    private static int hash(final long key, final Object type) {
+        int h = (int) (key ^ (key >>> 32));
+        h = h * 31 + System.identityHashCode(type);
+        h ^= h >>> 16;
+        return h;
+    }
+
+    private void resize() {
+        final long[] oldKeys = this.keys;
+        final Object[] oldTypes = this.types;
+        final int newCap = oldKeys.length << 1;
+        this.keys = new long[newCap];
+        this.types = new Object[newCap];
+        this.mask = newCap - 1;
+        this.size = 0;
+        for (int i = 0; i < oldKeys.length; i++) {
+            final Object type = oldTypes[i];
+            if (type != null) {
+                this.addUnchecked(oldKeys[i], type);
+            }
+        }
+    }
+
+    // caller guarantees the pair is absent
+    private void addUnchecked(final long key, final Object type) {
+        int slot = hash(key, type) & this.mask;
+        while (this.types[slot] != null) {
+            slot = (slot + 1) & this.mask;
+        }
+        this.keys[slot] = key;
+        this.types[slot] = type;
+        this.size++;
+    }
+
+    /** @return true if the pair was already present (not added). */
+    public boolean add(final long key, final T type) {
+        int slot = hash(key, type) & this.mask;
+        while (this.types[slot] != null) {
+            if (this.keys[slot] == key && this.types[slot] == type) {
+                return true;
+            }
+            slot = (slot + 1) & this.mask;
+        }
+        if (this.size >= (this.mask + 1) * 3 / 4) {
+            this.resize();
+            this.addUnchecked(key, type);
+            return false;
+        }
+        this.keys[slot] = key;
+        this.types[slot] = type;
+        this.size++;
+        return false;
+    }
+
+    /** @return true if a matching pair was removed. */
+    public boolean remove(final long key, final T type) {
+        int slot = hash(key, type) & this.mask;
+        while (this.types[slot] != null) {
+            if (this.keys[slot] == key && this.types[slot] == type) {
+                // backward-shift deletion keeps probe chains intact: an element at `probe`
+                // may shift into `hole` iff hole lies on its own probe path from home,
+                // i.e. (probe-hole) mod n <= (probe-home) mod n (equality covers the
+                // home==hole case; the at-home element a==0 never moves)
+                int hole = slot;
+                int probe = slot;
+                while (true) {
+                    probe = (probe + 1) & this.mask;
+                    if (this.types[probe] == null) {
+                        break;
+                    }
+                    final int home = hash(this.keys[probe], this.types[probe]) & this.mask;
+                    if (((probe - hole) & this.mask) <= ((probe - home) & this.mask)) {
+                        this.keys[hole] = this.keys[probe];
+                        this.types[hole] = this.types[probe];
+                        hole = probe;
+                    }
+                }
+                this.types[hole] = null;
+                this.size--;
+                return true;
+            }
+            slot = (slot + 1) & this.mask;
+        }
+        return false;
+    }
+
+    public boolean contains(final long key, final T type) {
+        int slot = hash(key, type) & this.mask;
+        while (this.types[slot] != null) {
+            if (this.keys[slot] == key && this.types[slot] == type) {
+                return true;
+            }
+            slot = (slot + 1) & this.mask;
+        }
+        return false;
+    }
+
+    public boolean isEmpty() {
+        return this.size == 0;
+    }
+
+    public void clear() {
+        java.util.Arrays.fill(this.types, null);
+        this.size = 0;
+    }
+}
+// Papo end - batch 123
