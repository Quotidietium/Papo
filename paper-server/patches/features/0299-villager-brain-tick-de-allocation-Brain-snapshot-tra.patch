+        final BehaviorControl<? super E>[] behaviors = new BehaviorControl[count];
+        final Activity[] activities = new Activity[count];
+        int i = 0;
+
+        for (Map<Activity, Set<BehaviorControl<? super E>>> map : this.availableBehaviorsByPriority.values()) {
+            for (Entry<Activity, Set<BehaviorControl<? super E>>> entry : map.entrySet()) {
+                for (BehaviorControl<? super E> behaviorControl : entry.getValue()) {
+                    behaviors[i] = behaviorControl;
+                    activities[i] = entry.getKey();
+                    i++;
