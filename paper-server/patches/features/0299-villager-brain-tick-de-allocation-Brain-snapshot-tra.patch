+        // Papo start - caller-owned BFS workset (R62): every POI query allocated a
+        // fresh LongArrayFIFOQueue + LongOpenHashSet; both are method-local and never
+        // escape (results are collected into the per-query result lists). ThreadLocal
+        // scratch, cleared unconditionally at entry — exception-path leftovers are
+        // wiped by the next call, and clear() keeps capacity (primitive backing, no
+        // reference semantics). Queries are non-reentrant (a BFS never starts another
+        // one), so a single slot per thread suffices. Threads: brain behaviors /
+        // sensors / PortalForcer run on the server thread; PoiManager's own calls run
+        // on their calling thread — every caller gets its own slot.
+        final LongArrayFIFOQueue queue = PoiAccess.PAP0_BFS_QUEUE.get();
+        final LongOpenHashSet seen = PoiAccess.PAP0_BFS_SEEN.get();
+        queue.clear();
+        seen.clear();
+        // Papo end
         seen.add(centerKey);
         queue.enqueue(centerKey);
 
